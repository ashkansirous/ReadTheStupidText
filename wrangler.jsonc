{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "readthestupidtext",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",

  // sirous.uk is already a zone on this account, so Cloudflare creates the DNS
  // record itself. The first replaced the GitHub Pages CNAME; the second is the
  // Dino Reader site (Slice 74), served by the same Worker and chosen by Host.
  // See docs/DEPLOYING.md.
  "routes": [
    { "pattern": "readthestupidtext.sirous.uk", "custom_domain": true },
    { "pattern": "dinoreader.sirous.uk", "custom_domain": true },
    // Slice 467: the Dino site again on the Elinsoft zone (the Sonos integration's host), chosen by Host like the one above.
    { "pattern": "dino.elinsoft.co.uk", "custom_domain": true }
  ],

  // A custom route makes workers_dev default to false; keep the *.workers.dev
  // URL live as the documented fallback and as the pre-cut-over check.
  "workers_dev": true,

  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    // "none" serves /index.html and /privacy.html exactly as GitHub Pages did
    // (the Store listing links the .html URL) instead of redirecting them.
    "html_handling": "none",
    // Unknown paths are a plain 404, not a single-page-app fallback.
    "not_found_handling": "none",
    // "/" and "/privacy" have no file of their own, so the Worker maps them. The
    // two .html paths also go through it so every page gets the security headers.
    "run_worker_first": [
      "/", "/index.html", "/privacy", "/privacy/", "/privacy.html", "/download", "/download/*",
      // Slice 92: the free Dino story store API (worker/stories.ts).
      "/api/stories", "/api/stories/*",
      // Slice 132: Dino Reader's remote config (worker/appconfig.ts).
      "/api/app-config",
      // Slice 458: the stores' server notifications, /api/store/apple and /api/store/google (worker/store-notifications/).
      "/api/store/*",
      // Slice 133: Dino Reader's anonymous usage counts (worker/events.ts).
      "/api/events", "/api/events/beta",
      // Slice 227: crash and error reports from the phone apps (worker/crashes.ts).
      "/api/crash",
      // Slice 283: Dino Reader's anonymous Sonos music service (worker/sonos.ts).
      "/sonos",
      // Slice 436: Sonos players' play reports (worker/sonos-reporting.ts); an exact path, so "/sonos" does not cover it.
      "/sonos/v2.0/timePlayed", "/sonos/v2.0", "/sonos/v2.0/",
      // Slice 467: the same endpoint without the ".0" (the Reporting Endpoint the owner set), and its base for the portal's reachability GET.
      "/sonos/v2/timePlayed", "/sonos/v2", "/sonos/v2/",
      // Slice 282: Dino Reader's anonymous Alexa kid skill (worker/alexa.ts).
      "/alexa",
      // Slice 287: the public Dino usage dashboard page and its data (worker/stats.ts).
      "/stats", "/stats/", "/stats.html", "/api/stats",
      // Slice 355: the public books page (worker/downloads.ts).
      "/books", "/books/", "/books.html",
      // Slice 423: printed-book short links /book/<id> forward to the Dino app page (worker/book-links.ts).
      "/book/*",
      // The Dino Reader site on *.workers.dev, under /dino/ (worker/downloads.ts resolveSite).
      "/dino", "/dino/", "/dino/index.html", "/dino/privacy", "/dino/privacy/", "/dino/privacy.html", "/dino/download", "/dino/download/*",
      "/dino/api/stories", "/dino/api/stories/*",
      "/dino/api/app-config",
      "/dino/api/store/*",
      "/dino/api/events", "/dino/api/events/beta",
      "/dino/api/crash",
      "/dino/sonos",
      "/dino/sonos/v2.0/timePlayed", "/dino/sonos/v2.0", "/dino/sonos/v2.0/",
      "/dino/sonos/v2/timePlayed", "/dino/sonos/v2", "/dino/sonos/v2/",
      "/dino/alexa",
      "/dino/stats", "/dino/stats/", "/dino/stats.html", "/dino/api/stats",
      "/dino/books", "/dino/books/", "/dino/books.html",
      "/dino/book/*"
    ]
  },

  // The downloads bucket: the Dino story store, remote config and usage-count flag
  // (worker/stories.ts, appconfig.ts, events.ts). APKs are not here; they stay on
  // GitHub Releases. The bucket must exist before the deploy that
  // adds this binding: see docs/DEPLOYING.md.
  "r2_buckets": [{ "binding": "DOWNLOADS", "bucket_name": "readthestupidtext-downloads" }],
  // Slice 287: the dashboard's daily rollup table (worker/schema/stats.sql), created 2026-11-08.
  "d1_databases": [{ "binding": "STATS", "database_name": "dino-stats", "database_id": "e7fe3a48-af07-4331-ab1c-15882b802599" }],
  "analytics_engine_datasets": [
    { "binding": "DINO_USAGE", "dataset": "dino_usage" },
    // Slice 251: Dino counts from TestFlight builds, never mixed into dino_usage.
    { "binding": "DINO_USAGE_BETA", "dataset": "dino_usage_beta" },
    { "binding": "RTST_USAGE", "dataset": "rtst_usage" },
    // Slice 227: one point per crash report (worker/crashes.ts); the report itself is kept in R2 under crashes/.
    { "binding": "APP_CRASHES", "dataset": "app_crashes" }
  ],
  // Slice 227: at most 10 crash reports per connection and minute in one location; the connection's IP is only the limiter's key and is never stored.
  // The namespace_id is an integer unique within the account.
  "ratelimits": [
    { "name": "CRASH_LIMITER", "namespace_id": "2270", "simple": { "limit": 10, "period": 60 } },
    // Slice 346: GET /api/stories/windows-ticket, 6 per connection and minute (a Windows app asks once per store read).
    { "name": "TICKET_LIMITER", "namespace_id": "3460", "simple": { "limit": 6, "period": 60 } },
    // Slice 346: paid-book proofs that reach a store (androidpublisher, StoreKit, Microsoft), 30 per connection and minute; a proof seen in the last minutes is answered from memory and does not count.
    { "name": "PAID_LIMITER", "namespace_id": "3461", "simple": { "limit": 30, "period": 60 } }
  ],

  // Slice 282: the Alexa skill id (amzn1.ask.skill...). Empty until the skill exists, and while it is empty
  // every Alexa request is refused with 400 (worker/alexa-verify.ts fails closed). Set it here, in BOTH wrangler configs, by a PR
  // once the skill exists, never in the dashboard: each deploy overwrites a dashboard value with this one.
  // Slice 419: Ninjalog forwarding of the Dino counts (worker/ninjalog.ts). On ("true", owner 2026-11-19); nothing is sent until
  // the NINJALOG_TOKEN Worker secret is set. Both configs must match (check-configs); change it by a PR, never in the dashboard.
  "vars": { "ALEXA_SKILL_ID": "amzn1.ask.skill.32f02175-4e96-4a88-98c1-b858c48c048d", "ANALYTICS_ACCOUNT_ID": "985d711340bd2cf7bf5d71f04a7e84c9", "NINJALOG_ENABLED": "true", "BOOK_LINK_TARGET": "https://dinoreader.sirous.uk/" },

  // Slice 287: the hourly rollup of Analytics Engine into D1 for /stats (worker/stats-rollup.ts). Harmless without the
  // STATS binding: it logs and returns. The STATS binding is above, next to r2_buckets (docs/DEPLOYING.md).
  "triggers": { "crons": ["7 * * * *"] },

  "observability": { "enabled": true }
}
