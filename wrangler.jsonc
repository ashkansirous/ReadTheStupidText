{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "readthestupidtext",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",

  // sirous.uk is already a zone on this account, so Cloudflare creates the DNS
  // record itself. The first replaced the GitHub Pages CNAME; the second is the
  // Dino Reader site (Slice 74), served by the same Worker and chosen by Host.
  // See docs/DEPLOYING.md.
  "routes": [
    { "pattern": "readthestupidtext.sirous.uk", "custom_domain": true },
    { "pattern": "dinoreader.sirous.uk", "custom_domain": true }
  ],

  // A custom route makes workers_dev default to false; keep the *.workers.dev
  // URL live as the documented fallback and as the pre-cut-over check.
  "workers_dev": true,

  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    // "none" serves /index.html and /privacy.html exactly as GitHub Pages did
    // (the Store listing links the .html URL) instead of redirecting them.
    "html_handling": "none",
    // Unknown paths are a plain 404, not a single-page-app fallback.
    "not_found_handling": "none",
    // "/" and "/privacy" have no file of their own, so the Worker maps them. The
    // two .html paths also go through it so every page gets the security headers.
    "run_worker_first": [
      "/", "/index.html", "/privacy", "/privacy/", "/privacy.html", "/download", "/download/*",
      // Slice 92: the free Dino story store API (worker/stories.ts).
      "/api/stories", "/api/stories/*",
      // Slice 132: Dino Reader's remote config (worker/appconfig.ts).
      "/api/app-config",
      // Slice 133: Dino Reader's anonymous usage counts (worker/events.ts).
      "/api/events",
      // Slice 227: crash and error reports from the phone apps (worker/crashes.ts).
      "/api/crash",
      // The Dino Reader site on *.workers.dev, under /dino/ (worker/downloads.ts resolveSite).
      "/dino", "/dino/", "/dino/index.html", "/dino/privacy", "/dino/privacy/", "/dino/privacy.html", "/dino/download", "/dino/download/*",
      "/dino/api/stories", "/dino/api/stories/*",
      "/dino/api/app-config",
      "/dino/api/events",
      "/dino/api/crash"
    ]
  },

  // The downloads bucket: the Dino story store, remote config and usage-count flag
  // (worker/stories.ts, appconfig.ts, events.ts). APKs are not here; they stay on
  // GitHub Releases. The bucket must exist before the deploy that
  // adds this binding: see docs/DEPLOYING.md.
  "r2_buckets": [{ "binding": "DOWNLOADS", "bucket_name": "readthestupidtext-downloads" }],
  "analytics_engine_datasets": [
    { "binding": "DINO_USAGE", "dataset": "dino_usage" },
    { "binding": "RTST_USAGE", "dataset": "rtst_usage" },
    // Slice 227: one point per crash report (worker/crashes.ts); the report itself is kept in R2 under crashes/.
    { "binding": "APP_CRASHES", "dataset": "app_crashes" }
  ],
  // Slice 227: at most 10 crash reports per connection and minute in one location; the connection's IP is only the limiter's key and is never stored.
  // The namespace_id is an integer unique within the account.
  "ratelimits": [
    { "name": "CRASH_LIMITER", "namespace_id": "2270", "simple": { "limit": 10, "period": 60 } }
  ],

  "observability": { "enabled": true }
}
