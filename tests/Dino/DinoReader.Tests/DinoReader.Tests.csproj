    <EmbeddedResource Include="..\..\..\src\Dino\DinoReader.App\Resources\Strings\AppResources.resx" Link="Linked\AppResources.resx" LogicalName="DinoReader.Resources.Strings.AppResources.resources" />
    <!-- The own-books cleanup's decision and failure handling (Slice 278 A3): plain .NET, tested on the real file. -->
