<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <RootNamespace>DinoReader.Tests</RootNamespace>
    <TargetFramework>net11.0</TargetFramework>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <IsPackable>false</IsPackable>
    <!-- Slice 404: the Debug-only full-shelf plan (plain .NET, linked below) is tested on the real file. -->
    <DefineConstants>$(DefineConstants);DINO_TEST_BOOKS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- The app's string holder is plain .NET (no MAUI), so the culture rule is tested on the real file (Slice 159). -->
    <Compile Include="..\..\..\src\Dino\DinoReader.App\Resources\Strings\AppResources.cs" Link="Linked\AppResources.cs" />
    <!-- Slice 399: the Settings "Books and buying" lines, plain .NET, tested on the real file. -->
    <Compile Include="..\..\..\src\Dino\DinoReader.App\Purchases\SettingsBuyingText.cs" Link="Linked\SettingsBuyingText.cs" />
    <Compile Include="..\..\..\src\Dino\DinoReader.App\Testing\FullShelfPlan.cs" Link="Linked\FullShelfPlan.cs" />
