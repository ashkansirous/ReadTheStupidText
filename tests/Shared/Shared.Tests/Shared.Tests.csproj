<Project Sdk="Microsoft.NET.Sdk">

  <!-- Slice 368: the tests of the code both apps ship (Domain, Application, Documents, Infrastructure's engines, Mobile.Shared's pure
       logic). A failure here can hit RTST and Dino Reader; ReadTheStupidText.Tests keeps the tray, control panel and phone-app tests. -->
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <RootNamespace>ReadTheStupidText.Tests</RootNamespace>
    <!-- Matches Infrastructure's TFM so it can be referenced; the tests exercise
         only pure logic and never load the WinRT/native engine. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- SilentLog and TestSettings, also used by the RTST-only tests (one file, linked into both projects). -->
    <Compile Include="..\..\Rtst\ReadTheStupidText.Tests\TestFakes.cs" Link="TestFakes.cs" />
    <Compile Include="..\..\Rtst\ReadTheStupidText.Tests\TranslationFakes.cs" Link="TranslationFakes.cs" />
    <!-- Pure BCL helper from the Android-only Mobile project, compiled in (Slice 53); FallbackPartCTests checks its fallback. -->
    <Compile Include="..\..\..\src\Rtst\ReadTheStupidText.Mobile\UiCulture.cs" Link="Mobile\UiCulture.cs" />
    <!-- Debug-only test-hook command parser (Slice 162); its file is empty outside Debug. -->
    <Compile Include="..\..\..\src\Shared\Sirous.Reading.Mobile.Shared\Testing\TestHookCommand.cs" Link="Mobile\TestHookCommand.cs" />
    <Compile Include="..\..\..\src\Shared\Sirous.Reading.Mobile.Shared\Testing\TestHookLaunchKeys.cs" Link="Mobile\TestHookLaunchKeys.cs" />
    <Compile Include="..\..\..\src\Shared\Sirous.Reading.Mobile.Shared\Images\CropRect.cs" Link="Mobile\CropRect.cs" />
    <Compile Include="..\..\..\src\Shared\Sirous.Reading.Mobile.Shared\VoicePackInstaller.cs" Link="Mobile\VoicePackInstaller.cs" />
    <Compile Include="..\..\..\src\Shared\Sirous.Reading.Mobile.Shared\VoiceCancelHold.cs" Link="Mobile\VoiceCancelHold.cs" />
    <Compile Include="..\..\..\src\Shared\Sirous.Reading.Mobile.Shared\PackDownloadHost.cs" Link="Mobile\PackDownloadHost.cs" />
    <Compile Include="..\..\..\src\Shared\Sirous.Reading.Mobile.Shared\PackKeepAlivePolicy.cs" Link="Mobile\PackKeepAlivePolicy.cs" />
    <Compile Include="..\..\..\src\Shared\Sirous.Reading.Mobile.Shared\StalePartialPolicy.cs" Link="Mobile\StalePartialPolicy.cs" />
    <!-- Slice 243 item 5 / Slice 249: the log-line words and the "Report a problem" code and report, pure and shared by both apps. -->
    <Compile Include="..\..\..\src\Shared\Sirous.Reading.Mobile.Shared\Crashes\TraceLines.cs" Link="Mobile\TraceLines.cs" />
    <Compile Include="..\..\..\src\Shared\Sirous.Reading.Mobile.Shared\Crashes\ReportCode.cs" Link="Mobile\ReportCode.cs" />
    <!-- The launch scan's wanted/undecided pack rule (Slice 208), pulled out of the service so DecideAll is tested (Slice 225). -->
    <Compile Include="..\..\..\src\Shared\Sirous.Reading.Mobile.Shared\StalePartialDecider.cs" Link="Mobile\StalePartialDecider.cs" />
    <!-- The translation download session has no MAUI types (Slice 187). -->
    <Compile Include="..\..\..\src\Shared\Sirous.Reading.Mobile.Shared\Translation\TranslationModelDownloadSession.cs" Link="Mobile\TranslationModelDownloadSession.cs" />
    <Compile Include="..\..\..\src\Shared\Sirous.Reading.Mobile.Shared\Translation\SingleModelCall.cs" Link="Mobile\SingleModelCall.cs" />
    <Compile Include="..\..\..\src\Shared\Sirous.Reading.Mobile.Shared\IPlatformServices.cs" Link="Mobile\IPlatformServices.cs" />
    <Compile Include="..\..\..\src\Shared\Sirous.Reading.Mobile.Shared\IDocumentScanner.cs" Link="Mobile\IDocumentScanner.cs" />
    <Compile Include="..\..\..\src\Shared\Sirous.Reading.Mobile.Shared\DocumentScannerReporting.cs" Link="Mobile\DocumentScannerReporting.cs" />
    <Compile Include="..\..\..\src\Shared\Sirous.Reading.Mobile.Shared\DocumentScannerRegistration.cs" Link="Mobile\DocumentScannerRegistration.cs" />
    <Compile Include="..\..\..\src\Shared\Sirous.Reading.Mobile.Shared\Usage\ConfigFallbackHold.cs" Link="Mobile\ConfigFallbackHold.cs" />
    <Compile Include="..\..\..\src\Shared\Sirous.Reading.Mobile.Shared\DocumentScannerStartFailedException.cs" Link="Mobile\DocumentScannerStartFailedException.cs" />
    <Compile Include="..\..\..\src\Shared\Sirous.Reading.Mobile.Shared\DocumentScannerUnavailableException.cs" Link="Mobile\DocumentScannerUnavailableException.cs" />
    <Compile Include="..\..\..\src\Shared\Sirous.Reading.Mobile.Shared\DocumentScannerPreparingException.cs" Link="Mobile\DocumentScannerPreparingException.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" Version="3.2.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Shared\Sirous.Reading.Domain\Sirous.Reading.Domain.csproj" />
    <ProjectReference Include="..\..\..\src\Shared\Sirous.Reading.Application\Sirous.Reading.Application.csproj" />
    <ProjectReference Include="..\..\..\src\Shared\Sirous.Reading.Infrastructure\Sirous.Reading.Infrastructure.csproj" />
  </ItemGroup>

</Project>
