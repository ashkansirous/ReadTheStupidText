          "h": 0.0233
        }
      ]
    },
    {
      "image": "3.jpg",
      "lines": [
        {
          "text": "Carrot wishes they could see",
          "x": 0.2277,
          "y": 0.8492,
          "w": 0.577,
          "h": 0.03
        },
        {
          "text": "better. Hazelnut suggests",
