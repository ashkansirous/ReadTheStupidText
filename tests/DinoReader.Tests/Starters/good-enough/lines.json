          "w": 0.2746,
          "h": 0.03
        }
      ]
    },
    {
      "image": "4.jpg",
      "lines": [
        {
          "text": "They wiggle through tall legs",
          "x": 0.229,
          "y": 0.85,
          "w": 0.541,
          "h": 0.027
        },
        {
          "text": "and move down a few rows.",
          "x": 0.238,
          "y": 0.882,
          "w": 0.527,
          "h": 0.028
        }
      ]
    },
    {
      "image": "5.jpg",
      "lines": [
        {
          "text": "Now they have a good view, but",
          "x": 0.1953,
          "y": 0.8492,
          "w": 0.6183,
          "h": 0.03
        },
        {
          "text": "Carrot wants to get even closer.",
          "x": 0.1908,
          "y": 0.885,
          "w": 0.6217,
          "h": 0.0308
        }
      ]
    },
    {
      "image": "6.jpg",
      "lines": [
        {
          "text": "Since nobody stops them, they",
          "x": 0.2165,
          "y": 0.8483,
          "w": 0.5748,
          "h": 0.0308
        },
        {
          "text": "keep sneaking closer and closer.",
          "x": 0.202,
          "y": 0.885,
          "w": 0.6027,
          "h": 0.0308
        }
      ]
    },
    {
      "image": "7.jpg",
      "lines": [
        {
          "text": "They reach the very front row with",
          "x": 0.1897,
          "y": 0.8492,
          "w": 0.6239,
          "h": 0.03
        },
        {
          "text": "a great view, but Carrot keeps going.",
          "x": 0.1652,
          "y": 0.885,
          "w": 0.6741,
          "h": 0.0308
        }
      ]
    },
    {
      "image": "8.jpg",
      "lines": [],
      "text": "Zoom, zoom, zoom! Carrot runs right past the front row, all the way onto the grass!"
    },
    {
      "image": "9.jpg",
      "lines": [],
      "text": "Uh-oh! Now they're right in the middle of the field! All the players stop and stare at them."
    },
    {
      "image": "10.jpg",
      "lines": [],
      "text": "The referee walks them back to Row C. Carrot says sorry. \"The best seat,\" says Hazelnut, \"is the one where we're together!\""
