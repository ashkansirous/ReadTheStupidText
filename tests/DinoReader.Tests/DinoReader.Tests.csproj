<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <RootNamespace>DinoReader.Tests</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" Version="3.2.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- The app's string holder is plain .NET (no MAUI), so the culture rule is tested on the real file (Slice 159). -->
    <Compile Include="..\..\src\DinoReader.App\Resources\Strings\AppResources.cs" Link="Linked\AppResources.cs" />
    <Compile Include="..\..\src\DinoReader.App\ShippedTitles.cs" Link="Linked\ShippedTitles.cs" />
    <Compile Include="..\..\src\DinoReader.App\OwnBookTranslation.cs" Link="Linked\OwnBookTranslation.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DinoReader.Core\DinoReader.Core.csproj" />
  </ItemGroup>

</Project>
