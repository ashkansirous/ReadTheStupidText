<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <RootNamespace>DinoReader.Tests</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" Version="3.2.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- The app's string holder is plain .NET (no MAUI), so the culture rule is tested on the real file (Slice 159). -->
    <Compile Include="..\..\src\DinoReader.App\Resources\Strings\AppResources.cs" Link="Linked\AppResources.cs" />
    <!-- The own-books cleanup's decision and failure handling (Slice 278 A3): plain .NET, tested on the real file. -->
    <Compile Include="..\..\src\DinoReader.App\OwnBooksCleanupRun.cs" Link="Linked\OwnBooksCleanupRun.cs" />
    <Compile Include="..\..\src\DinoReader.App\BusyGuard.cs" Link="Linked\BusyGuard.cs" />
    <!-- The pure rules of the Debug-only forced book update (Slice 225 item 16). -->
    <Compile Include="..\..\src\DinoReader.App\ForcedUpdateRules.cs" Link="Linked\ForcedUpdateRules.cs" />
    <!-- The usage session (Slice 250): plain .NET, so its id, sequence and roll are tested on the real file. -->
    <Compile Include="..\..\src\DinoReader.App\UsageSession.cs" Link="Linked\UsageSession.cs" />
    <!-- The audio pack store (Slice 246 C2): plain .NET, so its install states are tested on the real file. -->
    <Compile Include="..\..\src\DinoReader.App\AudioPackStore.cs" Link="Linked\AudioPackStore.cs" />
    <!-- The player hand-off (Slice 270): plain .NET, so the "release after the native call returned" contract is tested on the real file. -->
    <Compile Include="..\..\src\DinoReader.App\PlayerHandOff.cs" Link="Linked\PlayerHandOff.cs" />
    <!-- The recorded-page pause state (Slice 271), split out of ReadingSession so it needs no MAUI main thread. -->
    <Compile Include="..\..\src\DinoReader.App\ReadingPauseState.cs" Link="Linked\ReadingPauseState.cs" />
    <!-- The iOS update button's link and text per install channel (Slice 276). -->
    <Compile Include="..\..\src\DinoReader.App\IosUpdateTarget.cs" Link="Linked\IosUpdateTarget.cs" />
    <!-- The pure font/size fallback behind the iOS text attributes (Slice 244). -->
    <Compile Include="..\..\src\DinoReader.App\Platforms\iOS\AttributeFallback.cs" Link="Linked\AttributeFallback.cs" />
    <!-- The reading page's sound pill: which pill a shelf-run state maps to (Slice 290). -->
    <Compile Include="..\..\src\DinoReader.App\SoundStatusPillState.cs" Link="Linked\SoundStatusPillState.cs" />
    <Compile Include="..\..\src\DinoReader.App\SoundPillText.cs" Link="Linked\SoundPillText.cs" />
    <!-- The listen tally (Slice 288): plain .NET, so the 30 second rule and the played seconds are tested on the real file. -->
    <Compile Include="..\..\src\DinoReader.App\ListenTally.cs" Link="Linked\ListenTally.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DinoReader.Core\DinoReader.Core.csproj" />
    <!-- The book builder (Slice 157) holds the book loader and the starter and store builders the validation tests use; it also compiles ShippedTitles. -->
    <ProjectReference Include="..\..\tools\DinoReader.BookBuilder\DinoReader.BookBuilder.csproj" />
  </ItemGroup>

</Project>
