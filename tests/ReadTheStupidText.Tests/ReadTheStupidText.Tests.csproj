<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <RootNamespace>ReadTheStupidText.Tests</RootNamespace>
    <!-- Matches Infrastructure's TFM so it can be referenced; the tests exercise
         only pure logic and never load the WinRT/native engine. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pure BCL helper from the Android-only Mobile project, compiled in (Slice 53). -->
    <Compile Include="..\..\src\ReadTheStupidText.Mobile\UiCulture.cs" Link="Mobile\UiCulture.cs" />
    <!-- Pure open-order rule for ReaderPage (Slice 304). -->
    <Compile Include="..\..\src\ReadTheStupidText.Mobile\ReaderOpenOrder.cs" Link="Mobile\ReaderOpenOrder.cs" />
    <!-- Pure BCL language-tag helper from the WinUI App project, compiled in (Slice 57). -->
    <Compile Include="..\..\src\ReadTheStupidText.App\UiLanguageTag.cs" Link="App\UiLanguageTag.cs" />
    <!-- Pack status composers and the state enum, to check the localized copy covers every state.
         The neutral (English) resx is embedded so AppResources resolves. -->
    <Compile Include="..\..\src\ReadTheStupidText.Mobile\LocalizedPackStatus.cs" Link="Mobile\LocalizedPackStatus.cs" />
    <Compile Include="..\..\src\ReadTheStupidText.Mobile\Resources\Strings\AppResources.cs" Link="Mobile\AppResources.cs" />
    <Compile Include="..\..\src\ReadTheStupidText.Mobile.Shared\PackStatusText.cs" Link="Mobile\PackStatusText.cs" />
    <!-- Debug-only test-hook command parser (Slice 162); its file is empty outside Debug. -->
    <Compile Include="..\..\src\ReadTheStupidText.Mobile.Shared\Testing\TestHookCommand.cs" Link="Mobile\TestHookCommand.cs" />
    <Compile Include="..\..\src\ReadTheStupidText.Mobile.Shared\Testing\TestHookLaunchKeys.cs" Link="Mobile\TestHookLaunchKeys.cs" />
    <Compile Include="..\..\src\ReadTheStupidText.Mobile.Shared\Images\CropRect.cs" Link="Mobile\CropRect.cs" />
    <Compile Include="..\..\src\ReadTheStupidText.Mobile.Shared\VoicePackInstaller.cs" Link="Mobile\VoicePackInstaller.cs" />
    <Compile Include="..\..\src\ReadTheStupidText.Mobile.Shared\VoiceCancelHold.cs" Link="Mobile\VoiceCancelHold.cs" />
    <Compile Include="..\..\src\ReadTheStupidText.Mobile.Shared\PackDownloadHost.cs" Link="Mobile\PackDownloadHost.cs" />
    <Compile Include="..\..\src\ReadTheStupidText.Mobile.Shared\PackKeepAlivePolicy.cs" Link="Mobile\PackKeepAlivePolicy.cs" />
    <Compile Include="..\..\src\ReadTheStupidText.Mobile.Shared\StalePartialPolicy.cs" Link="Mobile\StalePartialPolicy.cs" />
    <!-- Slice 243 item 5 / Slice 249: the log-line words and the "Report a problem" code and report, pure and shared by both apps. -->
    <Compile Include="..\..\src\ReadTheStupidText.Mobile.Shared\Crashes\TraceLines.cs" Link="Mobile\TraceLines.cs" />
    <Compile Include="..\..\src\ReadTheStupidText.Mobile.Shared\Crashes\ReportCode.cs" Link="Mobile\ReportCode.cs" />
    <!-- The launch scan's wanted/undecided pack rule (Slice 208), pulled out of the service so DecideAll is tested (Slice 225). -->
    <Compile Include="..\..\src\ReadTheStupidText.Mobile.Shared\StalePartialDecider.cs" Link="Mobile\StalePartialDecider.cs" />
    <!-- The translation download session has no MAUI types (Slice 187). -->
    <Compile Include="..\..\src\ReadTheStupidText.Mobile.Shared\Translation\TranslationModelDownloadSession.cs" Link="Mobile\TranslationModelDownloadSession.cs" />
    <Compile Include="..\..\src\ReadTheStupidText.Mobile.Shared\Translation\SingleModelCall.cs" Link="Mobile\SingleModelCall.cs" />
    <EmbeddedResource Include="..\..\src\ReadTheStupidText.Mobile\Resources\Strings\AppResources.resx" Link="Mobile\AppResources.resx" LogicalName="ReadTheStupidText.Mobile.Resources.Strings.AppResources.resources" />
    <Compile Include="..\..\src\ReadTheStupidText.Mobile.Shared\IPlatformServices.cs" Link="Mobile\IPlatformServices.cs" />
    <Compile Include="..\..\src\ReadTheStupidText.Mobile.Shared\IDocumentScanner.cs" Link="Mobile\IDocumentScanner.cs" />
    <Compile Include="..\..\src\ReadTheStupidText.Mobile.Shared\DocumentScannerReporting.cs" Link="Mobile\DocumentScannerReporting.cs" />
    <Compile Include="..\..\src\ReadTheStupidText.Mobile.Shared\DocumentScannerRegistration.cs" Link="Mobile\DocumentScannerRegistration.cs" />
    <Compile Include="..\..\src\ReadTheStupidText.Mobile.Shared\Usage\ConfigFallbackHold.cs" Link="Mobile\ConfigFallbackHold.cs" />
    <Compile Include="..\..\src\ReadTheStupidText.Mobile.Shared\DocumentScannerStartFailedException.cs" Link="Mobile\DocumentScannerStartFailedException.cs" />
    <Compile Include="..\..\src\ReadTheStupidText.Mobile.Shared\DocumentScannerUnavailableException.cs" Link="Mobile\DocumentScannerUnavailableException.cs" />
    <Compile Include="..\..\src\ReadTheStupidText.Mobile.Shared\DocumentScannerPreparingException.cs" Link="Mobile\DocumentScannerPreparingException.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" Version="3.2.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ReadTheStupidText.Domain\ReadTheStupidText.Domain.csproj" />
    <ProjectReference Include="..\..\src\ReadTheStupidText.Application\ReadTheStupidText.Application.csproj" />
    <ProjectReference Include="..\..\src\ReadTheStupidText.Infrastructure\ReadTheStupidText.Infrastructure.csproj" />
  </ItemGroup>

</Project>
