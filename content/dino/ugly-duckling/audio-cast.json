  "lines": [
    {
      "speaker": "Mother Duck",
      "source": "Oh my, what a great big baby!",
      "direction": "surprised and delighted"
    },
    {
      "speaker": "Dilly",
      "source": "Your neck's so long, and your feet are so big!",
      "direction": "giggling, cheeky teasing, never mean"
    },
    {
      "speaker": "Dilly",
      "source": "You don't look like a duck at all!",
      "direction": "giggling, cheeky teasing, never mean"
    },
    {
      "speaker": "Mother Duck",
      "source": "Dilly, that wasn't very kind,",
      "direction": "gently firm, not angry"
    },
    {
      "speaker": "Dilly",
      "source": "Sorry, big brother,",
      "direction": "sorry and a little ashamed, quiet"
    },
    {
      "speaker": "Duckling",
      "source": "But if I don't look like a duck, what kind of bird am I?",
      "direction": "a little sad and wondering"
    },
    {
      "speaker": "Duckling",
      "source": "Am I a swan like you?",
      "occurrence": 1,
      "direction": "calling up to the sky, hopeful"
    },
    {
      "speaker": "Mother Duck",
      "source": "Big or small, I love you all,",
      "occurrence": 3,
      "direction": "whispering softly, sleepy and cosy"
    },
    {
      "speaker": "Duckling",
      "source": "Wow! Is that really me?",
      "direction": "amazed and full of wonder"
    },
    {
      "speaker": "Duckling",
      "source": "Am I a swan like you?",
      "occurrence": 2,
      "direction": "shy and hopeful"
    }
  ],
