  "lines": [
    {
      "speaker": "Hans",
      "source": "We'll sew them in the morning,",
      "direction": "sleepy, with a great big yawn"
    },
    {
      "speaker": "Hans",
      "source": "Greta, come and look!",
      "direction": "excited and amazed, calling upstairs"
    },
    {
      "speaker": "Hans",
      "source": "Who made these?",
      "direction": "amazed and puzzled"
    },
    {
      "speaker": "Greta",
      "source": "Oh, wow! What beautiful shoes!",
      "direction": "delighted and amazed"
    },
    {
      "speaker": "Nib",
      "source": "Tap, tap, tap!",
      "direction": "singing it happily, in rhythm"
    },
    {
      "speaker": "Nob",
      "source": "Stitch, stitch, stitch!",
      "direction": "singing it happily, in rhythm"
    },
    {
      "speaker": "Nib",
      "source": "Look, Nob! Presents!",
      "direction": "excited, gasping with joy"
    },
    {
      "speaker": "Nob",
      "source": "Are they for us?",
      "direction": "hopeful and amazed"
    }
  ],
