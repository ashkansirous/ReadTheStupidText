  "lines": [
    {
      "speaker": "Little Billy",
      "source": "It's only me, Little Billy Goat Gruff,",
      "direction": "in a teeny-tiny voice, a little nervous"
    },
    {
      "speaker": "Little Billy",
      "source": "Oh, please let me cross,",
      "direction": "pleading, small and polite"
    },
    {
      "speaker": "Middle Billy",
      "source": "Oh, please let me cross,",
      "direction": "pleading politely"
    },
    {
      "speaker": "Big Billy",
      "source": "It's me, Big Billy Goat Gruff,",
      "direction": "in a big, deep, calm voice"
    },
    {
      "speaker": "Big Billy",
      "source": "Are you okay?",
      "direction": "concerned and caring"
    },
    {
      "speaker": "Troll",
      "source": "Ho, ho, ho! That tickles!",
      "direction": "giggling, happy and surprised"
    },
    {
      "speaker": "Troll",
      "source": "Nobody ever asks me to come along,",
      "direction": "sad and lonely, quiet"
    },
    {
      "speaker": "Troll",
      "source": "Thank you, Billy Goats,",
      "direction": "happy and grateful"
    },
    {
      "speaker": "Troll",
      "source": "This is the best day ever!",
      "direction": "overjoyed, with a big happy smile"
    },
    {
      "speaker": "Troll",
      "source": "Come back tomorrow!",
      "direction": "happy and friendly, waving goodnight"
    }
  ],
