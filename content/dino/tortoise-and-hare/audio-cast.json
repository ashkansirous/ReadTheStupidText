  "lines": [
    {
      "speaker": "Hare",
      "source": "A race? With me?",
      "direction": "laughing, surprised"
    },
    {
      "speaker": "Owl",
      "source": "Ready... steady... GO!",
      "direction": "slow build-up, then a loud call on the last word"
    },
    {
      "speaker": "Hare",
      "source": "I've got time for a little nap.",
      "direction": "yawning and lazy"
    },
    {
      "speaker": "Tortoise",
      "source": "Wake up, Hare!",
      "direction": "calling out kindly"
    },
    {
      "speaker": "Hare",
      "source": "Uh-oh! The race!",
      "direction": "waking with a jump, panicked"
    },
    {
      "speaker": "Owl",
      "source": "The Tortoise wins!",
      "direction": "announcing proudly"
    },
    {
      "speaker": "Hare",
      "source": "I'm sorry I was such a show-off.",
      "direction": "sorry and a little ashamed"
    },
    {
      "speaker": "Hare",
      "source": "Slow and steady, step by step,",
      "direction": "calm and thoughtful, trying it out"
    }
  ],
