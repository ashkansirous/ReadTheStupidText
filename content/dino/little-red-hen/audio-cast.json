    },
    {
      "speaker": "Dog",
      "source": "You did all the work by yourself,",
      "direction": "sorry and a little ashamed"
    },
    {
      "speaker": "Cat",
      "source": "And we didn't help you at all,",
      "direction": "sorry and a little ashamed"
    },
    {
      "speaker": "Duck",
      "source": "We're sorry, Hen,",
      "direction": "sorry, quiet and sincere"
    },
    {
      "speaker": "Duck",
      "source": "Next time we'll help.",
      "direction": "sincere and hopeful"
    },
    {
      "speaker": "Duck",
      "source": "We promise!",
