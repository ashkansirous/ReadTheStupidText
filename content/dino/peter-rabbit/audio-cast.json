  "lines": [
    {
      "speaker": "Mrs. Rabbit",
      "source": "But stay out of Mr. McGregor's garden!",
      "occurrence": 1,
      "direction": "firm, a gentle warning"
    },
    {
      "speaker": "Peter",
      "source": "Ooh, my tummy,",
      "direction": "groaning, a tummy ache"
    },
    {
      "speaker": "Peter",
      "source": "I ate way too much!",
      "direction": "groaning, a tummy ache"
    },
    {
      "speaker": "Peter",
      "source": "Which way is the gate?",
      "direction": "worried and a little lost"
    },
    {
      "speaker": "Mrs. Rabbit",
      "source": "But stay out of Mr. McGregor's garden!",
      "occurrence": 2,
      "direction": "firm, a gentle warning, remembered"
    },
    {
      "speaker": "Peter",
      "source": "Oh dear,",
      "direction": "worried and a little scared"
    },
    {
      "speaker": "Peter",
      "source": "I should've listened to my mum.",
      "direction": "sad and sorry"
    },
    {
      "speaker": "Mr. McGregor",
      "source": "Grumble, grumble, grumble!",
      "direction": "grumbling under his breath, funny"
    },
    {
      "speaker": "Mr. McGregor",
      "source": "Well, well, well!",
      "direction": "surprised and pleased"
    },
    {
      "speaker": "Peter",
      "source": "Please, can you help me find the gate?",
      "direction": "small and pleading, a little scared"
    },
    {
      "speaker": "Robin",
      "source": "Tweet, tweet, tweet!",
      "direction": "chirpy and sing-song"
    },
    {
      "speaker": "Peter",
      "source": "Bye-bye, jacket! Bye-bye, shoes!",
      "direction": "breathless and hurrying"
    },
    {
      "speaker": "Mrs. Rabbit",
      "source": "Peter! Where are your jacket and shoes?",
      "direction": "surprised and worried"
    },
    {
      "speaker": "Peter",
      "source": "I'm really sorry, Mum.",
      "direction": "sorry and a little ashamed"
    },
    {
      "speaker": "Mrs. Rabbit",
      "source": "Night-night, my little bunnies,",
      "direction": "soft and sleepy, almost a whisper"
    }
  ],
