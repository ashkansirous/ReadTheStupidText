# Slice 265: a normal checkout or clone downloads no Dino audio clips (they are LFS objects, about 510 MB).
# Fetch one book's with: git lfs pull --include "content/dino/<book>/audio/**" --exclude ""
# Slice 350: the print-size pictures are excluded too. Fetch one book's with: git lfs pull --include "content/dino/<book>/high-res/**" --exclude ""
[lfs]
	fetchexclude = content/dino/*/audio/**,content/dino/*/high-res/**
