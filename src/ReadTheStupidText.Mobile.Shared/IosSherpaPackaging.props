<Project>

	<!-- The iOS neural-voice native packaging for an app project (Slice 49, 67): the managed
	     sherpa-onnx binding, the engine's SherpaOnnxC.xcframework (fetched and hash-checked, then
	     linked as a framework) and the full onnxruntime package PaddleOCR needs. Imported by both
	     ReadTheStupidText.Mobile and DinoReader.App. The version comes from ..\SherpaOnnxVersion.props
	     (Slice 245), the same one Android and Windows use, which ReadTheStupidText.Mobile.Shared.csproj
	     imports too; SherpaIosZipSha256 below must change with it. -->
	<Import Project="$(MSBuildThisFileDirectory)..\SherpaOnnxVersion.props" />

	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<SherpaIosPinnedVersion>1.13.8</SherpaIosPinnedVersion>
		<SherpaIosZipSha256>e259a7d3b38ad7dec49bb078252a30bb42ede8355e2bb130cf8c1c78ed131f75</SherpaIosZipSha256>
		<SherpaIosDir>$(MSBuildProjectDirectory)/obj/sherpa-ios/$(SherpaOnnxVersion)</SherpaIosDir>
		<SherpaIosXcframework>$(SherpaIosDir)/SherpaOnnxC.xcframework</SherpaIosXcframework>
	</PropertyGroup>

	<!-- The package's nuspec depends on every runtime.* native package; none carries an iOS
	     asset, so each is asset-excluded to keep a desktop dylib out of the app. -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<PackageReference Include="org.k2fsa.sherpa.onnx" Version="$(SherpaOnnxVersion)" />
		<PackageReference Include="org.k2fsa.sherpa.onnx.runtime.android-arm64" Version="$(SherpaOnnxVersion)" ExcludeAssets="all" />
		<PackageReference Include="org.k2fsa.sherpa.onnx.runtime.android-x64" Version="$(SherpaOnnxVersion)" ExcludeAssets="all" />
		<PackageReference Include="org.k2fsa.sherpa.onnx.runtime.linux-arm64" Version="$(SherpaOnnxVersion)" ExcludeAssets="all" />
		<PackageReference Include="org.k2fsa.sherpa.onnx.runtime.linux-x64" Version="$(SherpaOnnxVersion)" ExcludeAssets="all" />
		<PackageReference Include="org.k2fsa.sherpa.onnx.runtime.osx-arm64" Version="$(SherpaOnnxVersion)" ExcludeAssets="all" />
		<PackageReference Include="org.k2fsa.sherpa.onnx.runtime.osx-x64" Version="$(SherpaOnnxVersion)" ExcludeAssets="all" />
		<PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-arm64" Version="$(SherpaOnnxVersion)" ExcludeAssets="all" />
		<PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-x64" Version="$(SherpaOnnxVersion)" ExcludeAssets="all" />
		<PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-x86" Version="$(SherpaOnnxVersion)" ExcludeAssets="all" />

		<!-- PaddleOCR on iOS: the sherpa framework links onnxruntime in statically without
		     exporting it (no OrtGetApiBase symbol), so OCR brings its own: the full package
		     (managed binding plus the static iOS xcframework, OnnxRuntimeVersion, the version the Android
		     managed binding is pinned to). -->
		<PackageReference Include="Microsoft.ML.OnnxRuntime" Version="$(OnnxRuntimeVersion)" />
		<!-- The managed binding P/Invokes RegisterCustomOps and iOS links every P/Invoke
		     statically, so the symbol must exist. This package ships only a dummy of it.
		     https://github.com/microsoft/onnxruntime/issues/24628 -->
		<PackageReference Include="Microsoft.ML.OnnxRuntime.Extensions.Dummy" Version="0.13.0" />
	</ItemGroup>

	<!-- The shared SherpaOnnxC.framework with onnxruntime linked in (one dynamic framework,
	     about 30 MB), copied into the app's Frameworks folder and located at run time by
	     IosSherpaLibrary. Added as a NativeReference from this target, after the fetch below has
	     put it on disk, so the item never points at a path that does not exist yet. -->
	<!-- SherpaIosPinnedVersion is the release the SHA-256 above was taken from. Checked on every iOS build
	     (not only when the framework is downloaded), so a bumped SherpaOnnxVersion cannot ride on a stale
	     hash and a cached framework. -->
	<Target Name="CheckSherpaIosPin" BeforeTargets="BeforeBuild" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<Error Condition="'$(SherpaIosPinnedVersion)' != '$(SherpaOnnxVersion)'" Text="IosSherpaPackaging.props: SherpaOnnxVersion is $(SherpaOnnxVersion) but SherpaIosPinnedVersion/SherpaIosZipSha256 are for $(SherpaIosPinnedVersion). Update the pinned version and its SHA-256 (from the GitHub release asset digest) together." />
	</Target>

	<Target Name="AddSherpaIosFramework" BeforeTargets="BeforeBuild" DependsOnTargets="CheckSherpaIosPin;FetchSherpaIosFramework" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<Error Condition="!Exists('$(SherpaIosXcframework)/Info.plist')" Text="The sherpa-onnx iOS framework is missing at $(SherpaIosXcframework) after the fetch." />
		<ItemGroup>
			<NativeReference Include="$(SherpaIosXcframework)">
				<Kind>Framework</Kind>
				<SmartLink>False</SmartLink>
			</NativeReference>
		</ItemGroup>
	</Target>

	<!-- Downloads and checks the framework once per checkout (kept under obj/, which is ignored),
	     so the repo carries no 30 MB binary. A wrong hash, a failed download or a partial unzip is
	     a hard error and removes the half-written folder. The iOS SDK defines its own task named
	     Unzip, so MSBuild's is named in full. -->
	<Target Name="FetchSherpaIosFramework" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' And !Exists('$(SherpaIosXcframework)/Info.plist')">
		<PropertyGroup>
			<_SherpaIosZip>$(SherpaIosDir)/sherpa-onnx-ios-framework.zip</_SherpaIosZip>
		</PropertyGroup>
		<RemoveDir Directories="$(SherpaIosDir)" />
		<DownloadFile SourceUrl="https://github.com/k2-fsa/sherpa-onnx/releases/download/xcframework/sherpa-onnx-v$(SherpaOnnxVersion)-ios-shared-onnxruntime-static.xcframework.zip" DestinationFolder="$(SherpaIosDir)" DestinationFileName="sherpa-onnx-ios-framework.zip" Retries="3" />
		<GetFileHash Files="$(_SherpaIosZip)" Algorithm="SHA256">
			<Output TaskParameter="Hash" PropertyName="_SherpaIosZipHash" />
		</GetFileHash>
		<Error Condition="!$([System.String]::Equals('$(_SherpaIosZipHash)', '$(SherpaIosZipSha256)', System.StringComparison.OrdinalIgnoreCase))" Text="The sherpa-onnx iOS framework download has the wrong SHA-256 ($(_SherpaIosZipHash)); expected $(SherpaIosZipSha256)." />
		<Microsoft.Build.Tasks.Unzip SourceFiles="$(_SherpaIosZip)" DestinationFolder="$(SherpaIosDir)" />
		<Delete Files="$(_SherpaIosZip)" />
		<Error Condition="!Exists('$(SherpaIosXcframework)/Info.plist')" Text="The sherpa-onnx iOS framework zip did not contain SherpaOnnxC.xcframework/Info.plist." />
		<OnError ExecuteTargets="CleanSherpaIosFramework" />
	</Target>

	<Target Name="CleanSherpaIosFramework">
		<RemoveDir Directories="$(SherpaIosDir)" />
	</Target>

</Project>
