<Project Sdk="Microsoft.NET.Sdk">

	<Import Project="SherpaIosVersion.props" />

	<!-- The platform code both MAUI apps share (Slice 58, Decision 72): speech readers, OCR,
	     the voice pack/model services, the settings store and the IPlatformServices seam.
	     Read The Stupid Text Mobile and Dino Reader reference it. Pages, shells and the
	     scan flow stay in the apps.
	     The namespace is ReadTheStupidText.Mobile.Shared (Slice 131), distinct from the apps'
	     ReadTheStupidText.Mobile; see CLAUDE.md: a namespace segment named "Android" would shadow
	     the Android.* binding namespace, so Platforms folders keep the plain namespace. -->
	<PropertyGroup>
		<!-- Same Android/iOS selection as ReadTheStupidText.Mobile.csproj (Decision 70, Slice 48):
		     iOS is added only on macOS or with -p:IncludeIos=true, and -p:IncludeAndroid=false
		     drops Android for the macOS iOS job. -->
		<TargetFrameworks Condition="'$(IncludeAndroid)' != 'false'">net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="($([MSBuild]::IsOSPlatform('OSX')) Or '$(IncludeIos)' == 'true') And '$(TargetFrameworks)' == ''">net10.0-ios</TargetFrameworks>
		<TargetFrameworks Condition="($([MSBuild]::IsOSPlatform('OSX')) Or '$(IncludeIos)' == 'true') And '$(TargetFrameworks)' != '' And !$(TargetFrameworks.Contains('net10.0-ios'))">$(TargetFrameworks);net10.0-ios</TargetFrameworks>
		<!-- Slice 67: Dino Reader's Windows head. Added on Windows only; -p:IncludeWindows=false drops it. -->
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Windows')) And '$(IncludeWindows)' != 'false' And '$(TargetFrameworks)' == ''">net10.0-windows10.0.19041.0</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Windows')) And '$(IncludeWindows)' != 'false' And '$(TargetFrameworks)' != '' And !$(TargetFrameworks.Contains('net10.0-windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<!-- The Windows CI packages the app with -p:GenerateAppxPackageOnBuild=true, which flows to every
		     project it builds: this library is never an MSIX, so it keeps its own value (see the
		     TreatAsLocalProperty on <Project>). -->

		<RootNamespace>ReadTheStupidText.Mobile.Shared</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Same floors as the apps (Decision 82 for Android). -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">28.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.5</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ReadTheStupidText.Domain\ReadTheStupidText.Domain.csproj" />
		<ProjectReference Include="..\ReadTheStupidText.Application\ReadTheStupidText.Application.csproj" />
		<ProjectReference Include="..\ReadTheStupidText.Documents\ReadTheStupidText.Documents.csproj" />
	</ItemGroup>

	<!-- Scan and OCR (Slice 63, Decision 78): Dino Reader reads scanned pages too, so the document
	     scanner and the OCR engines live here and flow to both apps. Dino Reader's APK therefore
	     carries ML Kit's Latin recognizer (a few MB of model plus native libraries); the
	     language OCR packs are still downloaded, not bundled. The sherpa-onnx packaging (and why
	     it is imported by the apps too) is in AndroidSherpaPackaging.props. -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<!-- Slice 45: ML Kit Document Scanner, delivered by Google Play services (no native library
		     or model in the APK). -->
		<PackageReference Include="Xamarin.GooglePlayServices.MLKit.DocumentScanner" Version="116.0.0.4" />

		<!-- ML Kit text recognition for MlKitImageTextExtractor (Platforms/Android). -->
		<PackageReference Include="Xamarin.Google.MLKit.TextRecognition" Version="116.0.1.8" />
		<PackageReference Include="Xamarin.GooglePlayServices.Tasks" Version="118.4.1.3" />

		<!-- Slice 54/95: ML Kit Translation for MlKitTranslator (Platforms/Android), registered by both apps: a ~30 MB
		     model per language is downloaded by ML Kit on first use (see PRIVACY.md). -->
		<PackageReference Include="Xamarin.Google.MLKit.Translate" Version="117.0.3.9" />

		<!-- The scanner and the text recognizer both pull Fragment.Ktx 1.8.8.1 while the MAUI graph
		     resolves Fragment 1.9.0 (which already contains the ktx classes): D8 fails with
		     duplicate classes. Pin the matching Ktx build. -->
		<PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.0" />

		<!-- Slice 72: lift MAUI's older transitive AndroidX/Material versions to the latest stable for
		     both Android apps (they reach the apps through this project reference). -->
		<PackageReference Include="Xamarin.AndroidX.AppCompat" Version="1.8.0" />
		<PackageReference Include="Xamarin.AndroidX.Fragment" Version="1.9.0" />
		<PackageReference Include="Xamarin.Google.Android.Material" Version="1.14.0.6" />
	</ItemGroup>

	<!-- Slice 52/55: PaddleOCR on onnxruntime (Ocr/). Only the MANAGED binding here: on Android
	     the native libonnxruntime.so sherpa-onnx stages serves it (the full package's would
	     collide), and the iOS app adds the full package for its static xcframework. The version
	     must equal the bundled native one (sherpa-onnx 1.13.3 ships onnxruntime 1.24.3); bump
	     both together and re-check the unzipped APK (CLAUDE.md native-dependency rule). -->
	<ItemGroup>
		<PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.24.3" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'windows'" />
		<!-- Windows: sherpa-onnx 1.13.3 ships onnxruntime 1.24.4 there; match Infrastructure (Slice 75 bump). -->
		<PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.24.4" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'" />
	</ItemGroup>

	<!-- Slice 67: the iOS engine (Platforms/iOS) compiles here against the managed sherpa-onnx
	     binding, so both apps get one copy. Only the MANAGED package: the native
	     SherpaOnnxC.xcframework and the full Microsoft.ML.OnnxRuntime (static iOS binary) are
	     linked by each app project, which is the one that needs them. The version is SherpaIosVersion
	     (SherpaIosVersion.props), the same one the apps' native framework uses. The
	     package's nuspec depends on every runtime.* native package; none has an iOS asset. -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<PackageReference Include="org.k2fsa.sherpa.onnx" Version="$(SherpaIosVersion)" />
		<PackageReference Include="org.k2fsa.sherpa.onnx.runtime.android-arm64" Version="$(SherpaIosVersion)" ExcludeAssets="all" />
		<PackageReference Include="org.k2fsa.sherpa.onnx.runtime.android-x64" Version="$(SherpaIosVersion)" ExcludeAssets="all" />
		<PackageReference Include="org.k2fsa.sherpa.onnx.runtime.linux-arm64" Version="$(SherpaIosVersion)" ExcludeAssets="all" />
		<PackageReference Include="org.k2fsa.sherpa.onnx.runtime.linux-x64" Version="$(SherpaIosVersion)" ExcludeAssets="all" />
		<PackageReference Include="org.k2fsa.sherpa.onnx.runtime.osx-arm64" Version="$(SherpaIosVersion)" ExcludeAssets="all" />
		<PackageReference Include="org.k2fsa.sherpa.onnx.runtime.osx-x64" Version="$(SherpaIosVersion)" ExcludeAssets="all" />
		<PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-arm64" Version="$(SherpaIosVersion)" ExcludeAssets="all" />
		<PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-x64" Version="$(SherpaIosVersion)" ExcludeAssets="all" />
		<PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-x86" Version="$(SherpaIosVersion)" ExcludeAssets="all" />
	</ItemGroup>

	<!-- Slice 160: ML Kit Translate on iOS (Platforms/iOS/MlKitTranslator.cs), the twin of the Android package above.
	     The binding embeds TranslateMLKit.xcframework (ML Kit's own floor is iOS 15.5); it is built for net9.0-ios18.0.
	     A model per language (~30 MB) is downloaded by ML Kit on first use. -->
	<!-- The xcframework has no simulator slice, so the CI simulator compile check (iossimulator-*) leaves it out; the apps pass IosSimulatorBuild because a global RuntimeIdentifier does not reach this project. -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' And ($(RuntimeIdentifier.StartsWith('iossimulator')) Or '$(IosSimulatorBuild)' == 'true')">
		<DefineConstants>$(DefineConstants);IOS_SIMULATOR_NO_MLKIT</DefineConstants>
		<IosSimulatorNoMlKit>true</IosSimulatorNoMlKit>
	</PropertyGroup>
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' And !$(RuntimeIdentifier.StartsWith('iossimulator')) And '$(IosSimulatorBuild)' != 'true'">
		<PackageReference Include="EngageSolutionsGroup.Apple.MLKitTranslate" Version="8.1.0" />
	</ItemGroup>
	<!-- Removed in a target because the MAUI SDK adds the Platforms/iOS files after this point. -->
	<Target Name="DropMlKitTranslatorOnSimulator" BeforeTargets="CoreCompile;XamarinPreBuild;BeforeCompile" Condition="'$(IosSimulatorNoMlKit)' == 'true'">
		<ItemGroup>
			<Compile Remove="Platforms\iOS\MlKitTranslator.cs" />
		</ItemGroup>
	</Target>

	<!-- Slice 67: on Windows the neural voice and the WinRT fallback voice are Infrastructure's readers
	     (sherpa-onnx through the Windows MediaPlayer), so the Windows head reads exactly as Read The
	     Stupid Text does. Infrastructure brings the sherpa-onnx runtime and its native DLLs. -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<ProjectReference Include="..\ReadTheStupidText.Infrastructure\ReadTheStupidText.Infrastructure.csproj" />
	</ItemGroup>

	<Import Project="..\AndroidSherpaPackaging.props" />

	<!-- Fail early and clearly instead of restoring a project with no target framework. -->
	<Target Name="EnsureATargetFramework" BeforeTargets="_CheckForUnsupportedTargetFramework;Restore;CollectPackageReferences" Condition="'$(TargetFrameworks)' == '' And '$(TargetFramework)' == ''">
		<Error Text="ReadTheStupidText.Mobile.Shared has no target framework: -p:IncludeAndroid=false removed Android and iOS is only added on macOS or with -p:IncludeIos=true. Pass -p:IncludeIos=true, or drop -p:IncludeAndroid=false." />
	</Target>

</Project>
