<Project Sdk="Microsoft.NET.Sdk">

	<!-- The platform code both MAUI apps share (Slice 58, Decision 72): speech readers, OCR,
	     the voice pack/model services, the settings store and the IPlatformServices seam.
	     Read The Stupid Text Mobile and Dino Reader reference it. Pages, shells and the
	     scan flow stay in the apps.
	     The namespace stays ReadTheStupidText.Mobile (see CLAUDE.md: a namespace segment
	     named "Android" would shadow the Android.* binding namespace). -->
	<PropertyGroup>
		<!-- Same Android/iOS selection as ReadTheStupidText.Mobile.csproj (Decision 70, Slice 48):
		     iOS is added only on macOS or with -p:IncludeIos=true, and -p:IncludeAndroid=false
		     drops Android for the macOS iOS job. -->
		<TargetFrameworks Condition="'$(IncludeAndroid)' != 'false'">net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="($([MSBuild]::IsOSPlatform('OSX')) Or '$(IncludeIos)' == 'true') And '$(TargetFrameworks)' == ''">net10.0-ios</TargetFrameworks>
		<TargetFrameworks Condition="($([MSBuild]::IsOSPlatform('OSX')) Or '$(IncludeIos)' == 'true') And '$(TargetFrameworks)' != '' And !$(TargetFrameworks.Contains('net10.0-ios'))">$(TargetFrameworks);net10.0-ios</TargetFrameworks>

		<RootNamespace>ReadTheStupidText.Mobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Same floors as the apps (Decision 82 for Android). -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">28.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ReadTheStupidText.Domain\ReadTheStupidText.Domain.csproj" />
		<ProjectReference Include="..\ReadTheStupidText.Application\ReadTheStupidText.Application.csproj" />
		<ProjectReference Include="..\ReadTheStupidText.Documents\ReadTheStupidText.Documents.csproj" />
	</ItemGroup>

	<!-- Scan and OCR (Slice 63, Decision 78): Dino Reader reads scanned pages too, so the document
	     scanner and the OCR engines live here and flow to both apps. Dino Reader's APK therefore
	     carries ML Kit's Latin recognizer (a few MB of model plus native libraries); the
	     language OCR packs are still downloaded, not bundled. The sherpa-onnx packaging (and why
	     it is imported by the apps too) is in AndroidSherpaPackaging.props. -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<!-- Slice 45: ML Kit Document Scanner, delivered by Google Play services (no native library
		     or model in the APK). -->
		<PackageReference Include="Xamarin.GooglePlayServices.MLKit.DocumentScanner" Version="116.0.0.4" />

		<!-- ML Kit text recognition for MlKitImageTextExtractor (Platforms/Android). -->
		<PackageReference Include="Xamarin.Google.MLKit.TextRecognition" Version="116.0.1.8" />
		<PackageReference Include="Xamarin.GooglePlayServices.Tasks" Version="118.4.1.3" />

		<!-- Slice 52: PaddleOCR on onnxruntime. Only the MANAGED binding, never
		     Microsoft.ML.OnnxRuntime (its native libonnxruntime.so would collide with the one
		     sherpa-onnx stages at lib/arm64-v8a/). The version must equal the bundled native one:
		     sherpa-onnx 1.13.3 ships onnxruntime 1.24.3. Bump both together and re-check the
		     unzipped APK (CLAUDE.md native-dependency rule). -->
		<PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.24.3" />

		<!-- The scanner and the text recognizer both pull Fragment.Ktx 1.8.8.1 while the MAUI graph
		     resolves Fragment 1.9.0 (which already contains the ktx classes): D8 fails with
		     duplicate classes. Pin the matching Ktx build. -->
		<PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.0" />
	</ItemGroup>

	<Import Project="..\AndroidSherpaPackaging.props" />

	<!-- Fail early and clearly instead of restoring a project with no target framework. -->
	<Target Name="EnsureATargetFramework" BeforeTargets="_CheckForUnsupportedTargetFramework;Restore;CollectPackageReferences" Condition="'$(TargetFrameworks)' == '' And '$(TargetFramework)' == ''">
		<Error Text="ReadTheStupidText.Mobile.Shared has no target framework: -p:IncludeAndroid=false removed Android and iOS is only added on macOS or with -p:IncludeIos=true. Pass -p:IncludeIos=true, or drop -p:IncludeAndroid=false." />
	</Target>

</Project>
