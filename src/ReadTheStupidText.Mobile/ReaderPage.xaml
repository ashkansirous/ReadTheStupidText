<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ReadTheStupidText.Mobile.ReaderPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ReadTheStupidText.Mobile"
    xmlns:res="clr-namespace:ReadTheStupidText.Mobile.Resources.Strings"
    Title="{x:Static res:AppResources.Shell_ReaderTitle}"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="None">

    <ContentPage.Resources>
        <!-- Outline icons: the paths of RTST Phone Batch 19 (24x24 grid, Play on 16x16), drawn unscaled and sized with Scale. -->
        <x:String x:Key="IconGear">M 9 12 A 3 3 0 1 0 15 12 A 3 3 0 1 0 9 12 M 19.4 15 a 1.7 1.7 0 0 0 .3 1.8 l .1 .1 a 2 2 0 1 1 -2.8 2.8 l -.1 -.1 a 1.7 1.7 0 0 0 -1.8 -.3 a 1.7 1.7 0 0 0 -1 1.5 V 21 a 2 2 0 1 1 -4 0 v -.1 a 1.7 1.7 0 0 0 -1.1 -1.5 a 1.7 1.7 0 0 0 -1.8 .3 l -.1 .1 a 2 2 0 1 1 -2.8 -2.8 l .1 -.1 a 1.7 1.7 0 0 0 .3 -1.8 a 1.7 1.7 0 0 0 -1.5 -1 H 3 a 2 2 0 1 1 0 -4 h .1 a 1.7 1.7 0 0 0 1.5 -1.1 a 1.7 1.7 0 0 0 -.3 -1.8 l -.1 -.1 a 2 2 0 1 1 2.8 -2.8 l .1 .1 a 1.7 1.7 0 0 0 1.8 .3 H 9 a 1.7 1.7 0 0 0 1 -1.5 V 3 a 2 2 0 1 1 4 0 v .1 a 1.7 1.7 0 0 0 1 1.5 a 1.7 1.7 0 0 0 1.8 -.3 l .1 -.1 a 2 2 0 1 1 2.8 2.8 l -.1 .1 a 1.7 1.7 0 0 0 -.3 1.8 V 9 a 1.7 1.7 0 0 0 1.5 1 H 21 a 2 2 0 1 1 0 4 h -.1 a 1.7 1.7 0 0 0 -1.5 1 Z</x:String>
        <x:String x:Key="IconCamera">M 4 8 a 2 2 0 0 1 2 -2 h 1.5 l 1.2 -2 h 6.6 l 1.2 2 H 20 a 2 2 0 0 1 2 2 v 9 a 2 2 0 0 1 -2 2 H 6 a 2 2 0 0 1 -2 -2 V 8 Z M 9.6 12.5 A 3.4 3.4 0 1 0 16.4 12.5 A 3.4 3.4 0 1 0 9.6 12.5</x:String>
        <x:String x:Key="IconFile">M 14 3 H 7 a 2 2 0 0 0 -2 2 v 14 a 2 2 0 0 0 2 2 h 10 a 2 2 0 0 0 2 -2 V 8 l -5 -5 Z M 14 3 v 5 h 5</x:String>
        <x:String x:Key="IconEdit">M 4 20 h 4 L 19 9 l -4 -4 L 4 16 v 4 Z</x:String>
        <x:String x:Key="IconChevronsLeft">M 11 5 L 4 12 l 7 7 M 19 5 l -7 7 l 7 7</x:String>
        <x:String x:Key="IconChevronsRight">M 13 5 l 7 7 l -7 7 M 5 5 l 7 7 l -7 7</x:String>
        <x:String x:Key="IconDownArrow">M 12 5 v 14 M 6 13 l 6 6 l 6 -6</x:String>
        <x:String x:Key="IconPlay">M 5 3.4 c 0 -.6 .7 -1 1.2 -.6 l 5.4 4.1 c .4 .3 .4 1 0 1.3 l -5.4 4.1 c -.5 .4 -1.2 0 -1.2 -.6 Z</x:String>
        <SolidColorBrush x:Key="IconBrushLight" Color="#4A46D6" />
        <SolidColorBrush x:Key="IconBrushDark" Color="{StaticResource PrimaryDark}" />
        <Style x:Key="IconPath" TargetType="Path">
            <Setter Property="Aspect" Value="None" />
            <Setter Property="WidthRequest" Value="24" />
            <Setter Property="HeightRequest" Value="24" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource IconBrushLight}, Dark={StaticResource IconBrushDark}}" />
            <Setter Property="StrokeThickness" Value="1.9" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 16" />
            <Setter Property="Stroke" Value="#1C000000" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark={StaticResource OffBlack}}" />
        </Style>
        <Style x:Key="BigButtonBorderStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="HeightRequest" Value="92" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style x:Key="BigButtonLabelStyle" TargetType="Label">
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <Setter Property="FontSize" Value="15.5" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="LineHeight" Value="1.2" />
        </Style>
        <Style x:Key="PlayerTimeStyle" TargetType="Label">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FlowDirection" Value="LeftToRight" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*" SafeAreaEdges="None" BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

        <!-- Brand app bar (Slice 99): the title and the Settings gear. -->
        <Grid x:Name="HeaderGrid" Grid.Row="0" Padding="18,8,8,8" SafeAreaEdges="Container" ColumnDefinitions="*,48" IsClippedToBounds="True">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource BrandStart}" Offset="0.0" />
                    <GradientStop Color="{StaticResource BrandEnd}" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>
            <Image Grid.ColumnSpan="2" Source="header_glyph.png" WidthRequest="100" HeightRequest="100" Aspect="AspectFit"
                   Opacity="0.12" Rotation="-8" HorizontalOptions="End" VerticalOptions="Start" Margin="0,-18,40,0" InputTransparent="True" />
            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                <Label Text="{x:Static res:AppResources.App_Name}" TextColor="White" FontSize="17" FontAttributes="Bold" />
                <!-- Voice pack status (Slice 50): shown only while a pack downloads or needs a retry. -->
                <Label x:Name="PackStatusLabel" TextColor="#C8FFFFFF" FontSize="11.5" IsVisible="False">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPackStatusTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>
            <Grid x:Name="SettingsButton" AutomationId="SettingsButton" Grid.Column="1" WidthRequest="48" HeightRequest="48">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSettingsTapped" />
                </Grid.GestureRecognizers>
                <Path Data="{StaticResource IconGear}" Style="{StaticResource IconPath}" Stroke="White" StrokeThickness="2" />
            </Grid>
        </Grid>

        <Grid Grid.Row="1" Padding="14,14,14,12" SafeAreaEdges="Container" RowDefinitions="*,Auto,Auto" RowSpacing="12">

            <!-- The text being read: read-only, with the spoken sentence highlighted. Edit swaps in the editor. -->
            <Grid Grid.Row="0" RowDefinitions="*,Auto">
                <Border x:Name="TextCard" Grid.Row="0" Style="{StaticResource CardStyle}" Padding="16">
                    <Grid x:Name="TextCardContent">
                        <ScrollView x:Name="ReadingScroll">
                            <ScrollView.Behaviors>
                                <local:LongPressBehavior LongPressed="OnTextLongPressed" />
                            </ScrollView.Behaviors>
                            <Label x:Name="ReadingLabel" AutomationId="ReadingText" FontSize="19" LineHeight="1.6"
                                   TextColor="{AppThemeBinding Light=#1f2027, Dark=#E6E6EA}" />
                        </ScrollView>
                        <Editor x:Name="TextEditor" IsVisible="False" TextChanged="OnEditorTextChanged" FontSize="19"
                                Placeholder="{x:Static res:AppResources.Reader_EditorHint}" />
                        <VerticalStackLayout x:Name="EmptyHint" AutomationId="EmptyHint" IsVisible="False" Spacing="10" MaximumWidthRequest="240"
                                             HorizontalOptions="Center" VerticalOptions="Center">
                            <Path Data="{StaticResource IconDownArrow}" Style="{StaticResource IconPath}" Stroke="#59000000" StrokeThickness="1.6" Scale="1.6667" Margin="8" />
                            <Label x:Name="EmptyHintLabel" FontSize="19" LineHeight="1.45" HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light=#99000000, Dark=#A3FFFFFF}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>
                <Grid x:Name="EditLink" AutomationId="EditLink" Grid.Row="1" HeightRequest="40" HorizontalOptions="End" ColumnDefinitions="Auto,Auto" ColumnSpacing="6">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnEditTapped" />
                    </Grid.GestureRecognizers>
                    <Path x:Name="EditGlyph" Grid.Column="0" Data="{StaticResource IconEdit}" Style="{StaticResource IconPath}"
                          Scale="0.6667" StrokeThickness="2" Margin="-4" />
                    <Label x:Name="EditLabel" Grid.Column="1" FontSize="15" FontAttributes="Bold" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light=#4A46D6, Dark={StaticResource PrimaryDark}}" />
                </Grid>
            </Grid>

            <!-- The two ways to add text. -->
            <Grid x:Name="ActionRow" Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="10">
                <Border x:Name="ScanButton" AutomationId="ScanButton" Grid.Column="0" Style="{StaticResource BigButtonBorderStyle}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnScanTapped" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="8" VerticalOptions="Center">
                        <Path Data="{StaticResource IconCamera}" Style="{StaticResource IconPath}" Scale="1.1667" />
                        <Label x:Name="ScanLabel" Style="{StaticResource BigButtonLabelStyle}" />
                    </VerticalStackLayout>
                </Border>
                <Border x:Name="FileButton" AutomationId="FileButton" Grid.Column="1" Style="{StaticResource BigButtonBorderStyle}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFileTapped" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="8" VerticalOptions="Center">
                        <Path Data="{StaticResource IconFile}" Style="{StaticResource IconPath}" Scale="1.1667" />
                        <Label x:Name="FileLabel" Style="{StaticResource BigButtonLabelStyle}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Player: progress, back, one big Play/Pause, forward. -->
            <Border x:Name="PlayerCard" Grid.Row="2" Style="{StaticResource CardStyle}" Padding="16,14">
                <VerticalStackLayout Spacing="12">

                    <VerticalStackLayout Spacing="6">
                        <ProgressBar x:Name="ReadProgressBar" Progress="0" HeightRequest="6"
                                     ProgressColor="{StaticResource Primary}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Label x:Name="ElapsedLabel" Grid.Column="0" Text="0:00" Style="{StaticResource PlayerTimeStyle}" />
                            <Label x:Name="TotalLabel" Grid.Column="1" Text="--:--" Style="{StaticResource PlayerTimeStyle}" />
                        </Grid>
                    </VerticalStackLayout>

                    <HorizontalStackLayout Spacing="28" HorizontalOptions="Center">
                        <Border x:Name="SkipBackButton" AutomationId="SkipBackButton" WidthRequest="52" HeightRequest="52" Padding="0" VerticalOptions="Center"
                                StrokeShape="RoundRectangle 26" Stroke="Transparent" BackgroundColor="#1A5B57E8">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSkipBackTapped" />
                            </Border.GestureRecognizers>
                            <Path x:Name="SkipBackIcon" Data="{StaticResource IconChevronsLeft}" Style="{StaticResource IconPath}" Scale="0.9167" StrokeThickness="2.2" />
                        </Border>

                        <Border x:Name="PlayButton" AutomationId="PlayButton" WidthRequest="72" HeightRequest="72" Padding="0"
                                StrokeShape="RoundRectangle 36" Stroke="Transparent">
                            <Border.Shadow>
                                <Shadow Brush="#5B57E8" Opacity="0.38" Radius="14" Offset="0,4" />
                            </Border.Shadow>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{StaticResource BrandStart}" Offset="0.0" />
                                    <GradientStop Color="{StaticResource BrandEnd}" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPlayPauseTapped" />
                            </Border.GestureRecognizers>
                            <Grid>
                                <Grid x:Name="PlayPauseIcon" WidthRequest="30" HeightRequest="30" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Path x:Name="PlayShape" Data="{StaticResource IconPlay}" Aspect="None" Fill="White" Stroke="Transparent"
                                          WidthRequest="16" HeightRequest="16" Scale="1.875" HorizontalOptions="Center" VerticalOptions="Center" />
                                    <HorizontalStackLayout x:Name="PauseShape" Spacing="5" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="False">
                                        <Border WidthRequest="6.4" HeightRequest="20.6" StrokeShape="RoundRectangle 2.6" Stroke="Transparent" BackgroundColor="White" />
                                        <Border WidthRequest="6.4" HeightRequest="20.6" StrokeShape="RoundRectangle 2.6" Stroke="Transparent" BackgroundColor="White" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border x:Name="SkipForwardButton" AutomationId="SkipForwardButton" WidthRequest="52" HeightRequest="52" Padding="0" VerticalOptions="Center"
                                StrokeShape="RoundRectangle 26" Stroke="Transparent" BackgroundColor="#1A5B57E8">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSkipForwardTapped" />
                            </Border.GestureRecognizers>
                            <Path x:Name="SkipForwardIcon" Data="{StaticResource IconChevronsRight}" Style="{StaticResource IconPath}" Scale="0.9167" StrokeThickness="2.2" />
                        </Border>
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Border>

        </Grid>
    </Grid>
</ContentPage>
