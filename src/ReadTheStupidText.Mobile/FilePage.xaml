<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ReadTheStupidText.Mobile.FilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="File"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <Grid>

        <!-- Idle: explain the flow and offer the picker. -->
        <VerticalStackLayout x:Name="IdleState" VerticalOptions="Center" HorizontalOptions="Center" Spacing="18" Padding="24">
            <Label Text="&#128196;" FontSize="40" HorizontalTextAlignment="Center" />
            <Label Text="Read a file" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center" />
            <Label Text="Pick a .txt, .pdf or .docx file and it reads the extracted text aloud through the same pipeline as typed text."
                   TextColor="{StaticResource TextSecondaryLight}" FontSize="13" HorizontalTextAlignment="Center" />
            <Button Text="Choose file" Clicked="OnChooseFileClicked"
                    BackgroundColor="#5B57E8" TextColor="White" CornerRadius="19" HeightRequest="42" WidthRequest="160" />
        </VerticalStackLayout>

        <!-- Processing: file picked, extracting text. -->
        <VerticalStackLayout x:Name="ProcessingState" IsVisible="False" VerticalOptions="Center" HorizontalOptions="Center" Spacing="14">
            <ActivityIndicator IsRunning="True" Color="{StaticResource Primary}" />
            <Label Text="Reading the file…" FontSize="14" />
        </VerticalStackLayout>

        <!-- Result: extracted text preview + Read / choose another. -->
        <Grid x:Name="ResultState" IsVisible="False" RowDefinitions="Auto,*,Auto" Padding="18">
            <Label x:Name="FileNameLabel" Grid.Row="0" FontSize="12" FontAttributes="Bold"
                   TextColor="{StaticResource TextSecondaryLight}" Margin="0,0,0,8" />
            <Border Grid.Row="1" Padding="14" StrokeShape="RoundRectangle 14" Stroke="{StaticResource CardBorder}"
                    BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource OffBlack}}">
                <ScrollView>
                    <Label x:Name="ExtractedTextLabel" FontSize="13.5" LineHeight="1.4" />
                </ScrollView>
            </Border>
            <Grid Grid.Row="2" Margin="0,14,0,0" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Button Grid.Column="0" Text="Choose another" Clicked="OnChooseFileClicked"
                        BackgroundColor="#0D000000" TextColor="{StaticResource TextSecondaryLight}" CornerRadius="19" HeightRequest="38" />
                <Button Grid.Column="1" x:Name="ReadButton" Text="Read" Clicked="OnReadClicked"
                        BackgroundColor="#5B57E8" TextColor="White" CornerRadius="19" HeightRequest="38" />
            </Grid>
        </Grid>

    </Grid>
</ContentPage>
