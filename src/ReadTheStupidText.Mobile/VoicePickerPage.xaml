<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ReadTheStupidText.Mobile.VoicePickerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:res="clr-namespace:ReadTheStupidText.Mobile.Resources.Strings"
    Title="{x:Static res:AppResources.Common_Voice}"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*" BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

        <Grid x:Name="HeaderGrid" Grid.Row="0" Padding="14,14,18,16" ColumnDefinitions="Auto,*">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource BrandStart}" Offset="0.0" />
                    <GradientStop Color="{StaticResource BrandEnd}" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>

            <Border Grid.Column="0" WidthRequest="30" HeightRequest="30" Padding="0"
                    StrokeShape="RoundRectangle 15" Stroke="Transparent" BackgroundColor="#29FFFFFF">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Border.GestureRecognizers>
                <Label x:Name="BackGlyph" FontSize="16" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <VerticalStackLayout x:Name="TitleStack" Grid.Column="1" Spacing="2" Margin="10,0,0,0" VerticalOptions="Center">
                <Label Text="{x:Static res:AppResources.VoicePicker_Heading}" TextColor="White" FontSize="16" FontAttributes="Bold" />
                <Label Text="{x:Static res:AppResources.VoicePicker_Subtitle}" TextColor="#C8FFFFFF" FontSize="11.5" />
            </VerticalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="14" Spacing="14">

                <Label Text="{x:Static res:AppResources.VoicePicker_SectionPhone}" FontSize="10.5" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                <Border Padding="0" StrokeShape="RoundRectangle 14" Stroke="{StaticResource CardBorder}"
                        BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource OffBlack}}">
                    <VerticalStackLayout x:Name="PhoneVoiceList" />
                </Border>

                <VerticalStackLayout x:Name="NeuralVoiceSections" Spacing="14">
                <Label Text="{x:Static res:AppResources.VoicePicker_SectionMale}" FontSize="10.5" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                <Border Padding="0" StrokeShape="RoundRectangle 14" Stroke="{StaticResource CardBorder}"
                        BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource OffBlack}}">
                    <VerticalStackLayout x:Name="MaleVoiceList" />
                </Border>

                <Label Text="{x:Static res:AppResources.VoicePicker_SectionFemale}" FontSize="10.5" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                <Border Padding="0" StrokeShape="RoundRectangle 14" Stroke="{StaticResource CardBorder}"
                        BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource OffBlack}}">
                    <VerticalStackLayout x:Name="FemaleVoiceList" />
                </Border>
                </VerticalStackLayout>

                <Label Text="{x:Static res:AppResources.VoicePicker_Hint}"
                       FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" Margin="4,4,4,0" />
            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
