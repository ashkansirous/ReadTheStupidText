<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ReadTheStupidText.Mobile.VoicePickerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:res="clr-namespace:ReadTheStupidText.Mobile.Resources.Strings"
    Title="{x:Static res:AppResources.Common_Voice}"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="None">

    <ContentPage.Resources>
        <Style x:Key="VoiceSectionHeading" TargetType="Label">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
        </Style>
        <Style x:Key="VoiceCard" TargetType="Border">
            <Setter Property="Padding" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 14" />
            <Setter Property="Stroke" Value="{StaticResource CardBorder}" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark={StaticResource OffBlack}}" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*" SafeAreaEdges="None" BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

        <Grid x:Name="HeaderGrid" Grid.Row="0" Padding="14,14,18,16" SafeAreaEdges="Container" ColumnDefinitions="Auto,*">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource BrandStart}" Offset="0.0" />
                    <GradientStop Color="{StaticResource BrandEnd}" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>

            <Border Grid.Column="0" WidthRequest="30" HeightRequest="30" Padding="0"
                    StrokeShape="RoundRectangle 15" Stroke="Transparent" BackgroundColor="#29FFFFFF">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Border.GestureRecognizers>
                <Label x:Name="BackGlyph" FontSize="16" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <VerticalStackLayout x:Name="TitleStack" Grid.Column="1" Spacing="2" Margin="10,0,0,0" VerticalOptions="Center">
                <Label Text="{x:Static res:AppResources.VoicePicker_Heading}" TextColor="White" FontSize="16" FontAttributes="Bold" />
                <Label Text="{x:Static res:AppResources.VoicePicker_Subtitle}" TextColor="#C8FFFFFF" FontSize="11.5" />
            </VerticalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1" SafeAreaEdges="Container">
            <VerticalStackLayout Padding="14" Spacing="14">

                <Label Text="{x:Static res:AppResources.VoicePicker_SectionPhone}" Style="{StaticResource VoiceSectionHeading}" />
                <Border Style="{StaticResource VoiceCard}">
                    <VerticalStackLayout x:Name="PhoneVoiceList" />
                </Border>

                <VerticalStackLayout x:Name="NeuralVoiceSections" Spacing="14">
                    <VerticalStackLayout x:Name="SupertonicSections" Spacing="14">
                        <Label Text="{x:Static res:AppResources.VoicePicker_SectionMale}" Style="{StaticResource VoiceSectionHeading}" />
                        <Border Style="{StaticResource VoiceCard}">
                            <VerticalStackLayout x:Name="MaleVoiceList" />
                        </Border>

                        <Label Text="{x:Static res:AppResources.VoicePicker_SectionFemale}" Style="{StaticResource VoiceSectionHeading}" />
                        <Border Style="{StaticResource VoiceCard}">
                            <VerticalStackLayout x:Name="FemaleVoiceList" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="EngineSection" Spacing="14" IsVisible="False">
                        <Label x:Name="EngineHeading" Style="{StaticResource VoiceSectionHeading}" />
                        <Border Style="{StaticResource VoiceCard}">
                            <VerticalStackLayout x:Name="EngineVoiceList" />
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <Label Text="{x:Static res:AppResources.VoicePicker_Hint}"
                       FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" Margin="4,4,4,0" />
            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
