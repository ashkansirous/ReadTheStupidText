<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ReadTheStupidText.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ReadTheStupidText.Mobile"
    xmlns:res="clr-namespace:ReadTheStupidText.Mobile.Resources.Strings"
    Title="{x:Static res:AppResources.App_Name}"
    FlyoutBehavior="Disabled">

    <!-- Single home screen: the reading page (Slice 99, Decision 103) holds only the text, the two
         "add text" buttons and the player. Settings and the voice picker are pushed routes,
         registered in the code-behind. Scan opens the system document scanner, not a page. -->
    <ShellContent Title="{x:Static res:AppResources.Shell_ReaderTitle}" ContentTemplate="{DataTemplate local:ReaderPage}" Route="Reader" />

</Shell>
