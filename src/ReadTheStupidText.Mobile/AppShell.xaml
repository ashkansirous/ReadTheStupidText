<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ReadTheStupidText.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ReadTheStupidText.Mobile"
    Title="Read The Stupid Text"
    FlyoutBehavior="Disabled">

    <!-- The bottom nav is the app's only navigation (Decision 43): Type, Camera,
         File are the three Android input paths (Decision 38). -->
    <TabBar>
        <ShellContent Title="Type" ContentTemplate="{DataTemplate local:TypePage}" Route="Type" />
        <ShellContent Title="Camera" ContentTemplate="{DataTemplate local:CameraPage}" Route="Camera" />
        <ShellContent Title="File" ContentTemplate="{DataTemplate local:FilePage}" Route="File" />
    </TabBar>

</Shell>
