<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ReadTheStupidText.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ReadTheStupidText.Mobile"
    Title="Read The Stupid Text"
    FlyoutBehavior="Disabled">

    <!-- Single home screen (design refresh, post-Slice 34): Paste/Scan/File are
         input actions on ReaderPage itself, not tabs (Decision 38's three
         Android input paths still apply — they just no longer need separate
         navigation destinations). Scan and the voice picker are pushed routes,
         registered in the code-behind. -->
    <ShellContent Title="Reader" ContentTemplate="{DataTemplate local:ReaderPage}" Route="Reader" />

</Shell>
