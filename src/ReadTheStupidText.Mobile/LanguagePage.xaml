<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ReadTheStupidText.Mobile.LanguagePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Language">

    <Grid RowDefinitions="Auto,*,Auto" BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

        <Grid Grid.Row="0" Padding="18,22,16,18">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource BrandStart}" Offset="0.0" />
                    <GradientStop Color="{StaticResource BrandEnd}" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>
            <VerticalStackLayout Spacing="3">
                <Label Text="Read The Stupid Text" TextColor="White" FontSize="16" FontAttributes="Bold" />
                <Label Text="Choose your language. We'll download a natural voice for it; until it arrives, your phone's own voice reads." TextColor="#C8FFFFFF" FontSize="12" />
            </VerticalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="14" Spacing="14">
                <Border Padding="0" StrokeShape="RoundRectangle 14" Stroke="{StaticResource CardBorder}"
                        BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource OffBlack}}">
                    <VerticalStackLayout x:Name="LanguageList" />
                </Border>

                <VerticalStackLayout x:Name="ProgressSection" Spacing="8" IsVisible="False">
                    <ProgressBar x:Name="DownloadProgressBar" Progress="0" ProgressColor="{StaticResource Primary}" />
                    <Label x:Name="StatusLabel" FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    <Button x:Name="RetryButton" Text="Retry download" IsVisible="False" Clicked="OnRetryClicked" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Button Grid.Row="2" x:Name="ContinueButton" Margin="14" Text="Continue" IsEnabled="False" Clicked="OnContinueClicked" />
    </Grid>
</ContentPage>
