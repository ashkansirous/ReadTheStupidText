<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ReadTheStupidText.Mobile.LanguagePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    SafeAreaEdges="None">
    <!-- Texts are set in code (ApplyTexts) so the page re-localizes the moment a language row is picked. -->

    <Grid RowDefinitions="Auto,*,Auto" SafeAreaEdges="None" BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

        <Grid x:Name="HeaderGrid" Grid.Row="0" Padding="18,22,16,18" SafeAreaEdges="Container">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource BrandStart}" Offset="0.0" />
                    <GradientStop Color="{StaticResource BrandEnd}" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>
            <VerticalStackLayout Spacing="3">
                <Label x:Name="AppNameLabel" TextColor="White" FontSize="16" FontAttributes="Bold" />
                <Label x:Name="IntroLabel" TextColor="#C8FFFFFF" FontSize="12" />
            </VerticalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1" SafeAreaEdges="Container">
            <VerticalStackLayout Padding="14" Spacing="14">
                <Border Padding="0" StrokeShape="RoundRectangle 14" Stroke="{StaticResource CardBorder}"
                        BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource OffBlack}}">
                    <VerticalStackLayout x:Name="LanguageList" />
                </Border>

                <VerticalStackLayout x:Name="ProgressSection" Spacing="8" IsVisible="False">
                    <ProgressBar x:Name="DownloadProgressBar" Progress="0" ProgressColor="{StaticResource Primary}" />
                    <Label x:Name="StatusLabel" FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    <Button x:Name="RetryButton" IsVisible="False" Clicked="OnRetryClicked" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="2" Spacing="0" SafeAreaEdges="Container">
            <!-- Batch 29 R11 (Slice 137): one line about the anonymous counts; nothing to tap, no consent prompt (Decision 143). -->
            <Label x:Name="CountsNoteLabel" Margin="22,0,22,0" FontSize="13.5" LineHeight="1.45" HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light=#99000000, Dark={StaticResource TextSecondaryDark}}" />
            <Button x:Name="ContinueButton" Margin="14,12,14,14" IsEnabled="False" Clicked="OnContinueClicked" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
