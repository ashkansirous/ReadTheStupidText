<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<application android:allowBackup="true" android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon_round" android:supportsRtl="true"></application>
	<!-- Network is used only to download language voice packs (Slice 50, Decision
	     60); text, images and scans never leave the device. ACCESS_NETWORK_STATE
	     lets the app tell "offline" from a failed download. -->
	<uses-permission android:name="android.permission.INTERNET" />
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

	<!-- Camera capture → OCR (Slice 32, Decision 40). MediaPicker requests this
	     permission itself at runtime; it still needs declaring here. -->
	<uses-permission android:name="android.permission.CAMERA" />
	<uses-feature android:name="android.hardware.camera" android:required="false" />

	<!-- Android 11+ package-visibility: MediaPicker's capture Intent needs the
	     system camera app declared reachable, or CapturePhotoAsync throws
	     FeatureNotSupportedException even when a camera exists. -->
	<queries>
		<intent>
			<action android:name="android.media.action.IMAGE_CAPTURE" />
		</intent>
	</queries>
</manifest>