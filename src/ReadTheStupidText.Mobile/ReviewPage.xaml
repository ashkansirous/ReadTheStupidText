<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ReadTheStupidText.Mobile.ReviewPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:res="clr-namespace:ReadTheStupidText.Mobile.Resources.Strings"
    Title="{x:Static res:AppResources.Review_Title}"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="None">

    <ContentPage.Resources>
        <!-- Outline icons: the paths of RTST Phone Batch 19 R6 and R7 (24x24 grid, Play on 16x16), drawn unscaled and sized with Scale. -->
        <x:String x:Key="IconBack">M 15 5 l -7 7 l 7 7</x:String>
        <x:String x:Key="IconClipboard">M 10 3 H 19 a 2 2 0 0 1 2 2 V 16 a 2 2 0 0 1 -2 2 H 10 a 2 2 0 0 1 -2 -2 V 5 a 2 2 0 0 1 2 -2 Z M 5 7 v 12 a 2 2 0 0 0 2 2 h 9</x:String>
        <x:String x:Key="IconWarning">M 12 3 l 9.5 17 h -19 Z M 12 10 v 4.5 M 11.4 17.5 A 0.6 0.6 0 1 0 12.6 17.5 A 0.6 0.6 0 1 0 11.4 17.5</x:String>
        <x:String x:Key="IconCheck">M 4 12.5 l 5 5 L 20 6.5</x:String>
        <x:String x:Key="IconPlay">M 5 3.4 c 0 -.6 .7 -1 1.2 -.6 l 5.4 4.1 c .4 .3 .4 1 0 1.3 l -5.4 4.1 c -.5 .4 -1.2 0 -1.2 -.6 Z</x:String>
        <Style x:Key="IconPath" TargetType="Path">
            <Setter Property="Aspect" Value="None" />
            <Setter Property="WidthRequest" Value="24" />
            <Setter Property="HeightRequest" Value="24" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="StrokeThickness" Value="1.9" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 14" />
            <Setter Property="Stroke" Value="#1C000000" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark={StaticResource OffBlack}}" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*" SafeAreaEdges="None" BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

        <!-- Header (R6): back arrow, "Check the text", and a Paste pill that replaces the text with the clipboard. -->
        <Grid Grid.Row="0" Padding="4,8,8,8" ColumnSpacing="2" SafeAreaEdges="Container" ColumnDefinitions="48,*,Auto">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource BrandStart}" Offset="0.0" />
                    <GradientStop Color="{StaticResource BrandEnd}" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>
            <Grid x:Name="BackButton" Grid.Column="0" WidthRequest="48" HeightRequest="48">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Grid.GestureRecognizers>
                <Path Data="{StaticResource IconBack}" Style="{StaticResource IconPath}" Stroke="White" StrokeThickness="2.4" Scale="0.9167" />
            </Grid>
            <Label x:Name="TitleLabel" Grid.Column="1" TextColor="White" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
            <Border x:Name="PasteButton" Grid.Column="2" HeightRequest="40" Padding="14,0" StrokeShape="RoundRectangle 20"
                    Stroke="Transparent" BackgroundColor="#2EFFFFFF" VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPasteTapped" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <Path Data="{StaticResource IconClipboard}" Style="{StaticResource IconPath}" Stroke="White" Scale="0.6667" Margin="-4" />
                    <Label x:Name="PasteLabel" TextColor="White" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <!-- Body: the text box takes all the room; the controls stack under it and move above the keyboard. -->
        <Grid Grid.Row="1" Padding="14" RowSpacing="10" RowDefinitions="*,Auto" SafeAreaEdges="Container,SoftInput">

            <Border x:Name="TextBox" Grid.Row="0" StrokeShape="RoundRectangle 16" Stroke="{StaticResource Primary}" StrokeThickness="2"
                    Padding="16,14" BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource OffBlack}}">
                <Editor x:Name="TextEditor" FontSize="18" BackgroundColor="Transparent" TextChanged="OnEditorTextChanged"
                        TextColor="{AppThemeBinding Light=#1f2027, Dark=#E6E6EA}" Placeholder="{x:Static res:AppResources.Reader_EditorHint}" />
            </Border>

            <VerticalStackLayout Grid.Row="1" Spacing="10">

                <Label x:Name="ShowOriginalLink" IsVisible="False" FontSize="15" FontAttributes="Bold" HorizontalOptions="End"
                       TextColor="{AppThemeBinding Light=#4A46D6, Dark={StaticResource PrimaryDark}}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnShowOriginalTapped" />
                    </Label.GestureRecognizers>
                </Label>

                <!-- A capture page that could not be read is named here. -->
                <Border x:Name="FailedBanner" IsVisible="False" StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="#FFF6E0" Padding="12,10">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Path Data="{StaticResource IconWarning}" Style="{StaticResource IconPath}" Stroke="#B07A00" StrokeThickness="2.2" Scale="0.75" Margin="-3" VerticalOptions="Start" />
                        <Label x:Name="FailedLabel" Grid.Column="1" FontSize="14" LineHeight="1.4" TextColor="#6b4e00" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Shown only when the text is in another language and this phone can translate it. -->
                <Border x:Name="TranslateRow" IsVisible="False" Style="{StaticResource CardStyle}" MinimumHeightRequest="56" Padding="14,0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTranslateRowTapped" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="Center">
                        <Border x:Name="TickBox" Grid.Column="0" WidthRequest="28" HeightRequest="28" Padding="0" StrokeShape="RoundRectangle 8"
                                StrokeThickness="2" VerticalOptions="Center">
                            <Path x:Name="TickMark" Data="{StaticResource IconCheck}" Style="{StaticResource IconPath}" Stroke="White" StrokeThickness="3.2" Scale="0.6667" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Padding="0,8">
                            <Label x:Name="TranslateTitle" FontSize="16.5" FontAttributes="Bold" />
                            <Label x:Name="TranslateCaption" FontSize="13"
                                   TextColor="{AppThemeBinding Light=#94000000, Dark={StaticResource TextSecondaryDark}}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- The one big button: "Translate and read", or "Read" when unticked or nothing to translate. -->
                <Border x:Name="ReadButton" HeightRequest="62" StrokeShape="RoundRectangle 16" Stroke="Transparent">
                    <Border.Shadow>
                        <Shadow Brush="#5B57E8" Opacity="0.32" Radius="14" Offset="0,4" />
                    </Border.Shadow>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{StaticResource BrandStart}" Offset="0.0" />
                            <GradientStop Color="{StaticResource BrandEnd}" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnReadTapped" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                        <Path Data="{StaticResource IconPlay}" Aspect="None" Fill="White" Stroke="Transparent" WidthRequest="16" HeightRequest="16"
                              Scale="1.375" HorizontalOptions="Center" VerticalOptions="Center" />
                        <Label x:Name="ReadLabel" TextColor="White" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <!-- R7: while a missing translation model downloads. -->
                <Border x:Name="ProgressCard" IsVisible="False" Style="{StaticResource CardStyle}" StrokeShape="RoundRectangle 16" Padding="16,14">
                    <VerticalStackLayout Spacing="10">
                        <Label x:Name="ProgressTitle" FontSize="15" FontAttributes="Bold" />
                        <ProgressBar x:Name="ProgressBar" Progress="0" HeightRequest="8" ProgressColor="{StaticResource Primary}" />
                        <Label x:Name="ProgressNote" FontSize="13"
                               TextColor="{AppThemeBinding Light=#94000000, Dark={StaticResource TextSecondaryDark}}" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
