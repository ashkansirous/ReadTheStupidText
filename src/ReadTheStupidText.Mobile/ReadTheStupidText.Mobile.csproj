<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Android always; iOS only where it can be built (Decision 70, Slice 48). The iOS
		     target needs a Mac (CI: macos-26), so it is added on macOS, or anywhere with
		     -p:IncludeIos=true. Windows and Linux builds of this project (the Android CI
		     job, a Windows developer's `dotnet build -f net10.0-android`) therefore never
		     restore or evaluate the iOS target. The iOS CI job passes -p:IncludeAndroid=false so
		     a macOS restore does not need the Android workload (a plain -p:TargetFrameworks=...
		     would also flow into the referenced class libraries). -->
		<TargetFrameworks Condition="'$(IncludeAndroid)' != 'false'">net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="($([MSBuild]::IsOSPlatform('OSX')) Or '$(IncludeIos)' == 'true') And '$(TargetFrameworks)' == ''">net10.0-ios</TargetFrameworks>
		<TargetFrameworks Condition="($([MSBuild]::IsOSPlatform('OSX')) Or '$(IncludeIos)' == 'true') And '$(TargetFrameworks)' != '' And !$(TargetFrameworks.Contains('net10.0-ios'))">$(TargetFrameworks);net10.0-ios</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>ReadTheStupidText.Mobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name (user-facing; see CLAUDE.md naming convention) -->
		<ApplicationTitle>Read The Stupid Text</ApplicationTitle>

		<!-- App Identifier (Google Play package name — fixed once published) -->
		<ApplicationId>uk.sirous.readthestupidtext</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- 28 (Android 9, 2018) is the product floor for every Android app in
		     this repo (Decision 82). Google Play's automatic protection rejects
		     bundles below 24, and 28 still reaches about 95% of active Play
		     devices. Do not lower it. -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">28.0</SupportedOSPlatformVersion>

		<!-- iOS 15 is the MAUI 10 minimum for iOS; it covers every iPhone back to the 6s. -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon: brand gradient (linear-gradient(135deg, #5B57E8, #3B82F6), matching the
		     Windows tile assets in ReadTheStupidText.App/Assets) with the white glasses glyph
		     as the adaptive-icon foreground. -->
		<MauiIcon Include="Resources\AppIcon\appicon.png" ForegroundFile="Resources\AppIcon\appiconfg.png" Color="#4B63EE" />

		<!-- Splash Screen: same white glasses glyph over the brand gradient midpoint. -->
		<MauiSplashScreen Include="Resources\Splash\splash.png" Color="#4B63EE" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />


		<!-- No bundled voice model (Slice 50, Decision 61): the Supertonic-3 voice is a
		     downloaded pack (see docs/voice-packs.md), so the APK/AAB carries no
		     assets/VoiceModel/. -->
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

	<!-- The engine, the scanner and ML Kit text recognition live in ReadTheStupidText.Mobile.Shared (Slice 58, 63).
	     The sherpa-onnx native packaging is imported here too, because ExcludeAssets does not
	     flow through a project reference (see AndroidSherpaPackaging.props). Android-only: the
	     packages referenced below are the translation ones (this app's translation flow). -->
	<Import Project="..\AndroidSherpaPackaging.props" />
	<Import Project="..\AndroidRelease.props" />

	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<!-- The document scanner, ML Kit text recognition and the onnxruntime binding moved to
		     Mobile.Shared (Slice 63), so Dino Reader can scan too; they reach this app through the
		     project reference. -->

		<!-- Slice 54: ML Kit Language Identification (bundled model, so detection works with no
		     Play services) and Translation (a ~30 MB model per language downloaded by ML Kit on
		     first use; see PRIVACY.md). Android-only: Dino Reader has no translation. -->
		<PackageReference Include="Xamarin.Google.MLKit.Language.Id" Version="117.0.6.9" />
		<PackageReference Include="Xamarin.Google.MLKit.Translate" Version="117.0.3.9" />

		<!-- The scanner and the text recognizer both pull Fragment.Ktx 1.8.8.1 while the MAUI
		     graph resolves Fragment 1.9.0 (which already contains the ktx classes): D8 fails
		     with duplicate classes. Pin the matching Ktx build. -->
		<PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.0" />
	</ItemGroup>

	<!-- iOS neural voice (Slice 49): the managed sherpa-onnx binding plus the engine's native
	     framework. The managed package version must match the framework release (the C structs
	     the binding marshals are versioned with it), so both say 1.13.8 and are bumped together.
	     This is deliberately separate from the Android 1.13.3 pin in AndroidSherpaPackaging.props.
	     The package's nuspec depends on every runtime.* native package; none carries an iOS
	     asset, so each is asset-excluded to keep a desktop dylib out of the app. -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<SherpaIosVersion>1.13.8</SherpaIosVersion>
		<SherpaIosZipSha256>e259a7d3b38ad7dec49bb078252a30bb42ede8355e2bb130cf8c1c78ed131f75</SherpaIosZipSha256>
		<SherpaIosDir>$(MSBuildProjectDirectory)/obj/sherpa-ios/$(SherpaIosVersion)</SherpaIosDir>
		<SherpaIosXcframework>$(SherpaIosDir)/SherpaOnnxC.xcframework</SherpaIosXcframework>
	</PropertyGroup>

	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<PackageReference Include="org.k2fsa.sherpa.onnx" Version="$(SherpaIosVersion)" />
		<PackageReference Include="org.k2fsa.sherpa.onnx.runtime.android-arm64" Version="$(SherpaIosVersion)" ExcludeAssets="all" />
		<PackageReference Include="org.k2fsa.sherpa.onnx.runtime.android-x64" Version="$(SherpaIosVersion)" ExcludeAssets="all" />
		<PackageReference Include="org.k2fsa.sherpa.onnx.runtime.linux-arm64" Version="$(SherpaIosVersion)" ExcludeAssets="all" />
		<PackageReference Include="org.k2fsa.sherpa.onnx.runtime.linux-x64" Version="$(SherpaIosVersion)" ExcludeAssets="all" />
		<PackageReference Include="org.k2fsa.sherpa.onnx.runtime.osx-arm64" Version="$(SherpaIosVersion)" ExcludeAssets="all" />
		<PackageReference Include="org.k2fsa.sherpa.onnx.runtime.osx-x64" Version="$(SherpaIosVersion)" ExcludeAssets="all" />
		<PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-arm64" Version="$(SherpaIosVersion)" ExcludeAssets="all" />
		<PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-x64" Version="$(SherpaIosVersion)" ExcludeAssets="all" />
		<PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-x86" Version="$(SherpaIosVersion)" ExcludeAssets="all" />
	</ItemGroup>

	<!-- Slice 55: PaddleOCR on iOS. Unlike Android, where the one onnxruntime that sherpa-onnx
	     already stages serves both engines, the iOS sherpa framework links onnxruntime in
	     statically without exporting it (no OrtGetApiBase symbol), so OCR brings its own: the full
	     Microsoft.ML.OnnxRuntime package (managed binding plus the static iOS xcframework, 1.24.3,
	     the version the Android managed binding is pinned to). Two copies of onnxruntime therefore
	     live in the app, one inside SherpaOnnxC.framework and one in the executable; they do not
	     share symbols. Bump this together with the Android pin. -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.24.3" />
		<!-- The managed binding P/Invokes RegisterCustomOps, and iOS links every P/Invoke statically,
		     so the symbol must exist or the link fails ("Undefined symbols: _RegisterCustomOps").
		     This Microsoft package is the documented stand-in: it ships only a dummy of that symbol,
		     no custom ops (MIT, onnxruntime-extensions).
		     https://github.com/microsoft/onnxruntime/issues/24628 -->
		<PackageReference Include="Microsoft.ML.OnnxRuntime.Extensions.Dummy" Version="0.13.0" />
	</ItemGroup>

	<!-- The shared SherpaOnnxC.framework with onnxruntime linked in (one dynamic framework,
	     about 30 MB), copied into the app's Frameworks folder and located at run time by
	     IosSherpaLibrary. It is added as a NativeReference from this target, after the fetch
	     below has put it on disk, so the item never points at a path that does not exist yet. -->
	<Target Name="AddSherpaIosFramework" BeforeTargets="BeforeBuild" DependsOnTargets="FetchSherpaIosFramework" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<Error Condition="!Exists('$(SherpaIosXcframework)/Info.plist')" Text="The sherpa-onnx iOS framework is missing at $(SherpaIosXcframework) after the fetch." />
		<ItemGroup>
			<NativeReference Include="$(SherpaIosXcframework)">
				<Kind>Framework</Kind>
				<SmartLink>False</SmartLink>
			</NativeReference>
		</ItemGroup>
	</Target>

	<!-- The iOS SDK defines its own task named Unzip, so MSBuild's is named in full. -->
	<!-- Downloads and checks the framework once per checkout (kept under obj/, which is
	     ignored), so the repo carries no 30 MB binary. A wrong hash, a failed download or a
	     partial unzip is a hard error and removes the half-written folder, so the next build
	     starts clean instead of trusting it. -->
	<Target Name="FetchSherpaIosFramework" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' And !Exists('$(SherpaIosXcframework)/Info.plist')">
		<PropertyGroup>
			<_SherpaIosZip>$(SherpaIosDir)/sherpa-onnx-ios-framework.zip</_SherpaIosZip>
		</PropertyGroup>
		<RemoveDir Directories="$(SherpaIosDir)" />
		<DownloadFile SourceUrl="https://github.com/k2-fsa/sherpa-onnx/releases/download/xcframework/sherpa-onnx-v$(SherpaIosVersion)-ios-shared-onnxruntime-static.xcframework.zip" DestinationFolder="$(SherpaIosDir)" DestinationFileName="sherpa-onnx-ios-framework.zip" Retries="3" />
		<GetFileHash Files="$(_SherpaIosZip)" Algorithm="SHA256">
			<Output TaskParameter="Hash" PropertyName="_SherpaIosZipHash" />
		</GetFileHash>
		<Error Condition="!$([System.String]::Equals('$(_SherpaIosZipHash)', '$(SherpaIosZipSha256)', System.StringComparison.OrdinalIgnoreCase))" Text="The sherpa-onnx iOS framework download has the wrong SHA-256 ($(_SherpaIosZipHash)); expected $(SherpaIosZipSha256)." />
		<Microsoft.Build.Tasks.Unzip SourceFiles="$(_SherpaIosZip)" DestinationFolder="$(SherpaIosDir)" />
		<Delete Files="$(_SherpaIosZip)" />
		<Error Condition="!Exists('$(SherpaIosXcframework)/Info.plist')" Text="The sherpa-onnx iOS framework zip did not contain SherpaOnnxC.xcframework/Info.plist." />
		<OnError ExecuteTargets="CleanSherpaIosFramework" />
	</Target>

	<Target Name="CleanSherpaIosFramework">
		<RemoveDir Directories="$(SherpaIosDir)" />
	</Target>

	<!-- The privacy manifest App Store Connect requires; the iOS counterpart of the Android
	     manifest. -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<BundleResource Include="Platforms\iOS\Resources\PrivacyInfo.xcprivacy" LogicalName="PrivacyInfo.xcprivacy" />

		<!-- Slice 55: the permission prompts (camera, photo library) in the nine app languages.
		     Each language has a folder named like ar.lproj, as iOS expects; Info.plist stays the
		     English fallback. -->
		<BundleResource Include="Platforms\iOS\Resources\ar.lproj\InfoPlist.strings" LogicalName="ar.lproj/InfoPlist.strings" />
		<BundleResource Include="Platforms\iOS\Resources\en.lproj\InfoPlist.strings" LogicalName="en.lproj/InfoPlist.strings" />
		<BundleResource Include="Platforms\iOS\Resources\es.lproj\InfoPlist.strings" LogicalName="es.lproj/InfoPlist.strings" />
		<BundleResource Include="Platforms\iOS\Resources\fa.lproj\InfoPlist.strings" LogicalName="fa.lproj/InfoPlist.strings" />
		<BundleResource Include="Platforms\iOS\Resources\fr.lproj\InfoPlist.strings" LogicalName="fr.lproj/InfoPlist.strings" />
		<BundleResource Include="Platforms\iOS\Resources\ja.lproj\InfoPlist.strings" LogicalName="ja.lproj/InfoPlist.strings" />
		<BundleResource Include="Platforms\iOS\Resources\pt.lproj\InfoPlist.strings" LogicalName="pt.lproj/InfoPlist.strings" />
		<BundleResource Include="Platforms\iOS\Resources\ru.lproj\InfoPlist.strings" LogicalName="ru.lproj/InfoPlist.strings" />
		<BundleResource Include="Platforms\iOS\Resources\zh-Hans.lproj\InfoPlist.strings" LogicalName="zh-Hans.lproj/InfoPlist.strings" />
	</ItemGroup>

	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<CodesignEntitlements>Platforms\iOS\Entitlements.plist</CodesignEntitlements>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\ReadTheStupidText.Domain\ReadTheStupidText.Domain.csproj" />
		<ProjectReference Include="..\ReadTheStupidText.Application\ReadTheStupidText.Application.csproj" />
		<ProjectReference Include="..\ReadTheStupidText.Documents\ReadTheStupidText.Documents.csproj" />
		<ProjectReference Include="..\ReadTheStupidText.Mobile.Shared\ReadTheStupidText.Mobile.Shared.csproj" />
	</ItemGroup>

	<!-- Fail early and clearly instead of restoring a project with no target framework. -->
	<Target Name="EnsureATargetFramework" BeforeTargets="_CheckForUnsupportedTargetFramework;Restore;CollectPackageReferences" Condition="'$(TargetFrameworks)' == '' And '$(TargetFramework)' == ''">
		<Error Text="ReadTheStupidText.Mobile has no target framework: -p:IncludeAndroid=false removed Android and iOS is only added on macOS or with -p:IncludeIos=true. Pass -p:IncludeIos=true, or drop -p:IncludeAndroid=false." />
	</Target>

</Project>
