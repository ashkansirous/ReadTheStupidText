<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Android always; iOS only where it can be built (Decision 70, Slice 48). The iOS
		     target needs a Mac (CI: macos-26), so it is added on macOS, or anywhere with
		     -p:IncludeIos=true. Windows and Linux builds of this project (the Android CI
		     job, a Windows developer's `dotnet build -f net10.0-android`) therefore never
		     restore or evaluate the iOS target. The iOS CI job passes -p:IncludeAndroid=false so
		     a macOS restore does not need the Android workload (a plain -p:TargetFrameworks=...
		     would also flow into the referenced class libraries). -->
		<TargetFrameworks Condition="'$(IncludeAndroid)' != 'false'">net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="($([MSBuild]::IsOSPlatform('OSX')) Or '$(IncludeIos)' == 'true') And '$(TargetFrameworks)' == ''">net10.0-ios</TargetFrameworks>
		<TargetFrameworks Condition="($([MSBuild]::IsOSPlatform('OSX')) Or '$(IncludeIos)' == 'true') And '$(TargetFrameworks)' != '' And !$(TargetFrameworks.Contains('net10.0-ios'))">$(TargetFrameworks);net10.0-ios</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>ReadTheStupidText.Mobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name (user-facing; see CLAUDE.md naming convention) -->
		<ApplicationTitle>Read The Stupid Text</ApplicationTitle>

		<!-- App Identifier (Google Play package name — fixed once published) -->
		<ApplicationId>uk.sirous.readthestupidtext</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- 28 (Android 9, 2018) is the product floor for every Android app in
		     this repo (Decision 82). Google Play's automatic protection rejects
		     bundles below 24, and 28 still reaches about 95% of active Play
		     devices. Do not lower it. -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">28.0</SupportedOSPlatformVersion>

		<!-- iOS 15 is the MAUI 10 minimum for iOS; it covers every iPhone back to the 6s. -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon: brand gradient (linear-gradient(135deg, #5B57E8, #3B82F6), matching the
		     Windows tile assets in ReadTheStupidText.App/Assets) with the white glasses glyph
		     as the adaptive-icon foreground. -->
		<MauiIcon Include="Resources\AppIcon\appicon.png" ForegroundFile="Resources\AppIcon\appiconfg.png" Color="#4B63EE" />

		<!-- Splash Screen: same white glasses glyph over the brand gradient midpoint. -->
		<MauiSplashScreen Include="Resources\Splash\splash.png" Color="#4B63EE" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />


		<!-- No bundled voice model (Slice 50, Decision 61): the Supertonic-3 voice is a
		     downloaded pack (see docs/voice-packs.md), so the APK/AAB carries no
		     assets/VoiceModel/. -->
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

	<!-- Everything below is Android-only: the sherpa-onnx neural engine and ML Kit OCR.
	     iOS has neither yet (AVSpeech reads; the OCR is a stub), so no iOS build restores
	     the sherpa runtime.* packages. Slice 49 adds the iOS native engine and Vision OCR
	     (Decision 70: verify by unzipping the built .ipa). -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<!-- org.k2fsa.sherpa.onnx's nuspec unconditionally depends on ALL 8
		     runtime.* native packages (win/linux/osx/android) regardless of
		     TFM/RID. On an Android build every one of those .so files lands as
		     a candidate for the same lib/arm64-v8a/libsherpa-onnx-c-api.so APK
		     path, and MSBuild silently keeps whichever was processed last —
		     not necessarily the real Android one (same root cause as
		     https://github.com/microsoft/onnxruntime/issues/29270, wrong-OS
		     .so bundled into an Android APK). Neutralizing the seven
		     non-Android runtime packages below (asset-excluded, so they still
		     satisfy the version constraint but contribute no files) removes
		     every conflicting candidate, leaving only the real android-arm64
		     native library. -->
		<PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.3" />

		<!-- Excluded from every implicit NuGet asset flow (see the comment
		     above) — its .so files are staged explicitly below via
		     AndroidNativeLibrary, the documented mechanism for a raw native
		     library .NET-for-Android's own asset harvesting doesn't discover
		     on its own (confirmed empirically: with this package as a plain
		     PackageReference, arm64-v8a's libsherpa-onnx-c-api.so/
		     libonnxruntime.so never appear anywhere in the build output).
		     GeneratePathProperty exposes $(Pkgorg_k2fsa_sherpa_onnx_runtime_android-arm64)
		     pointing at the extracted package content, used below. -->
		<PackageReference Include="org.k2fsa.sherpa.onnx.runtime.android-arm64" Version="1.13.3" ExcludeAssets="all" GeneratePathProperty="true" />
		<PackageReference Include="org.k2fsa.sherpa.onnx.runtime.linux-arm64" Version="1.13.3" ExcludeAssets="all" />
		<PackageReference Include="org.k2fsa.sherpa.onnx.runtime.linux-x64" Version="1.13.3" ExcludeAssets="all" />
		<PackageReference Include="org.k2fsa.sherpa.onnx.runtime.osx-arm64" Version="1.13.3" ExcludeAssets="all" />
		<PackageReference Include="org.k2fsa.sherpa.onnx.runtime.osx-x64" Version="1.13.3" ExcludeAssets="all" />
		<PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-arm64" Version="1.13.3" ExcludeAssets="all" />
		<PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-x64" Version="1.13.3" ExcludeAssets="all" />
		<PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-x86" Version="1.13.3" ExcludeAssets="all" />
		<PackageReference Include="Xamarin.Google.MLKit.TextRecognition" Version="116.0.1.8" />
		<PackageReference Include="Xamarin.GooglePlayServices.Tasks" Version="118.4.1.3" />

		<!-- Slice 45: ML Kit Document Scanner (play-services-mlkit-document-scanner 16.0.0).
		     Delivered by Google Play services, so it adds no native library or model to
		     the APK; on a device without Play services the app falls back to one photo. -->
		<PackageReference Include="Xamarin.GooglePlayServices.MLKit.DocumentScanner" Version="116.0.0.4" />

		<!-- The scanner pulls Fragment.Ktx 1.8.8.1 while the MAUI graph resolves Fragment 1.9.0
		     (which already contains the ktx classes): D8 fails with duplicate classes. Pin the
		     matching Ktx build. -->
		<PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.0" />
	</ItemGroup>

	<!-- Only an arm64-v8a native build exists for this package (no android-x64),
	     so the neural engine is unavailable on an x86_64 emulator — by design,
	     CompositeSpeechReader-style routing falls back to Android TextToSpeech
	     (Slice 30) when the neural engine fails to load, matching how the
	     Windows fallback behaves for a missing/broken model (Decision 14). -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And '$(Pkgorg_k2fsa_sherpa_onnx_runtime_android-arm64)' != ''">
		<AndroidNativeLibrary Include="$(Pkgorg_k2fsa_sherpa_onnx_runtime_android-arm64)\runtimes\android-arm64\native\libsherpa-onnx-c-api.so" Abi="arm64-v8a" />
		<AndroidNativeLibrary Include="$(Pkgorg_k2fsa_sherpa_onnx_runtime_android-arm64)\runtimes\android-arm64\native\libonnxruntime.so" Abi="arm64-v8a" />
	</ItemGroup>

	<!-- The privacy manifest App Store Connect requires; the iOS counterpart of the Android
	     manifest. -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<BundleResource Include="Platforms\iOS\Resources\PrivacyInfo.xcprivacy" LogicalName="PrivacyInfo.xcprivacy" />
	</ItemGroup>

	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<CodesignEntitlements>Platforms\iOS\Entitlements.plist</CodesignEntitlements>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\ReadTheStupidText.Domain\ReadTheStupidText.Domain.csproj" />
		<ProjectReference Include="..\ReadTheStupidText.Application\ReadTheStupidText.Application.csproj" />
		<ProjectReference Include="..\ReadTheStupidText.Documents\ReadTheStupidText.Documents.csproj" />
	</ItemGroup>

	<!-- Fail early and clearly instead of restoring a project with no target framework. -->
	<Target Name="EnsureATargetFramework" BeforeTargets="_CheckForUnsupportedTargetFramework;Restore;CollectPackageReferences" Condition="'$(TargetFrameworks)' == '' And '$(TargetFramework)' == ''">
		<Error Text="ReadTheStupidText.Mobile has no target framework: -p:IncludeAndroid=false removed Android and iOS is only added on macOS or with -p:IncludeIos=true. Pass -p:IncludeIos=true, or drop -p:IncludeAndroid=false." />
	</Target>

</Project>
