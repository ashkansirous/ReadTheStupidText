<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ReadTheStupidText.Mobile.TypePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Type"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <Style x:Key="SpeedPresetStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#0D000000" />
            <Setter Property="TextColor" Value="{StaticResource TextSecondaryLight}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HeightRequest" Value="28" />
            <Setter Property="BorderWidth" Value="0" />
        </Style>
        <Style x:Key="TransportGlyphStyle" TargetType="Label">
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextColor" Value="{StaticResource TextSecondaryLight}" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto" BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

        <!-- Brand app bar -->
        <Grid Grid.Row="0" Padding="18,14,16,16" ColumnDefinitions="*,Auto">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource BrandStart}" Offset="0.0" />
                    <GradientStop Color="{StaticResource BrandEnd}" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>

            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                <Label Text="Read The Stupid Text" TextColor="White" FontSize="16" FontAttributes="Bold" />
                <Label x:Name="SubtitleLabel" Text="1×" TextColor="#C8FFFFFF" FontSize="11.5" />
            </VerticalStackLayout>

            <Border Grid.Column="1" WidthRequest="30" HeightRequest="30" Padding="0"
                    StrokeShape="RoundRectangle 15" Stroke="Transparent" BackgroundColor="#29FFFFFF"
                    VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnVoicePickerTapped" />
                </Border.GestureRecognizers>
                <Label Text="&#127908;" FontSize="14" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
        </Grid>

        <!-- Editor card: the paste/type target -->
        <Border Grid.Row="1" Margin="14,12,14,8" Padding="14"
                StrokeShape="RoundRectangle 14" Stroke="{StaticResource CardBorder}"
                BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource OffBlack}}">
            <Editor x:Name="TextEditor" Placeholder="Paste or type text…" FontSize="13.5" AutoSize="TextChanges" />
        </Border>

        <!-- Transport card: play/pause, skip, progress + timer, speed presets -->
        <Border Grid.Row="2" Margin="14,0,14,10" Padding="14"
                StrokeShape="RoundRectangle 14" Stroke="{StaticResource CardBorder}"
                BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource OffBlack}}">
            <VerticalStackLayout Spacing="12">

                <Grid ColumnDefinitions="34,52,34,*" ColumnSpacing="10" VerticalOptions="Center">
                    <Border Grid.Column="0" WidthRequest="34" HeightRequest="34" Padding="0"
                            StrokeShape="RoundRectangle 17" Stroke="Transparent" BackgroundColor="#0D000000">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSkipBackTapped" />
                        </Border.GestureRecognizers>
                        <Label Text="&#8676;10" Style="{StaticResource TransportGlyphStyle}" FontSize="10" />
                    </Border>

                    <Border Grid.Column="1" WidthRequest="52" HeightRequest="52" Padding="0"
                            StrokeShape="RoundRectangle 26" Stroke="Transparent">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{StaticResource BrandStart}" Offset="0.0" />
                                <GradientStop Color="{StaticResource BrandEnd}" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPlayPauseTapped" />
                        </Border.GestureRecognizers>
                        <Label x:Name="PlayPauseGlyph" Text="&#9654;" TextColor="White" FontSize="20"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>

                    <Border Grid.Column="2" WidthRequest="34" HeightRequest="34" Padding="0"
                            StrokeShape="RoundRectangle 17" Stroke="Transparent" BackgroundColor="#0D000000">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSkipForwardTapped" />
                        </Border.GestureRecognizers>
                        <Label Text="10&#8677;" Style="{StaticResource TransportGlyphStyle}" FontSize="10" />
                    </Border>

                    <VerticalStackLayout Grid.Column="3" Spacing="4" VerticalOptions="Center">
                        <ProgressBar x:Name="ReadProgressBar" Progress="0"
                                     ProgressColor="{StaticResource Primary}" />
                        <Label x:Name="TimerLabel" Text="00:00/--:--" FontSize="10"
                               TextColor="{StaticResource TextSecondaryLight}" />
                    </VerticalStackLayout>
                </Grid>

                <Grid x:Name="SpeedPresetRow" ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="6">
                    <Button Grid.Column="0" Text="0.5×" ClassId="0.5" Clicked="OnSpeedPresetClicked" Style="{StaticResource SpeedPresetStyle}" />
                    <Button Grid.Column="1" Text="1×" ClassId="1.0" Clicked="OnSpeedPresetClicked" Style="{StaticResource SpeedPresetStyle}" />
                    <Button Grid.Column="2" Text="1.25×" ClassId="1.25" Clicked="OnSpeedPresetClicked" Style="{StaticResource SpeedPresetStyle}" />
                    <Button Grid.Column="3" Text="1.5×" ClassId="1.5" Clicked="OnSpeedPresetClicked" Style="{StaticResource SpeedPresetStyle}" />
                    <Button Grid.Column="4" Text="1.75×" ClassId="1.75" Clicked="OnSpeedPresetClicked" Style="{StaticResource SpeedPresetStyle}" />
                    <Button Grid.Column="5" Text="2×" ClassId="2.0" Clicked="OnSpeedPresetClicked" Style="{StaticResource SpeedPresetStyle}" />
                </Grid>

            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>
