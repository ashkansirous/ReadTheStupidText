<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="DinoReader.StoryCover"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:DinoReader"
    x:DataType="local:StoryTile">

    <!-- A story's cover (mock gallery): 3/4, radius 16, flat colour with the title in Andika bold
         white, or the first page picture. The height follows the width in SizeChanged. -->
    <Border x:Name="CoverFrame" BackgroundColor="{Binding CoverColour}" StrokeThickness="0" SizeChanged="OnFrameSizeChanged">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="16" />
        </Border.StrokeShape>
        <Border.Shadow>
            <Shadow Brush="#2b2540" Opacity="0.08" Offset="0,4" Radius="0" />
        </Border.Shadow>
        <Grid>
            <Image Source="{Binding CoverImagePath}" Aspect="AspectFill" IsVisible="{Binding HasImage}" />
            <Label Text="{Binding Title}" IsVisible="{Binding ShowGeneratedCover}" FontFamily="AndikaBold" FontSize="18"
                   TextColor="White" LineHeight="1.2" HorizontalTextAlignment="Center" VerticalOptions="Center" Margin="12" />
        </Grid>
    </Border>
</ContentView>
