<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="DinoReader.StoryCover"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:DinoReader"
    x:DataType="local:StoryTile">

    <!-- A story's cover (mock gallery): 3/4, radius 16, flat colour with the title in Andika bold
         white, or the first page picture. The height follows the width via AspectRatioView. -->
    <local:AspectRatioView>
    <Border BackgroundColor="{Binding CoverFill}" StrokeThickness="0">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="16" />
        </Border.StrokeShape>
        <Border.Shadow>
            <Shadow Brush="#2b2540" Opacity="0.08" Offset="0,4" Radius="0" />
        </Border.Shadow>
        <Grid>
            <Image Source="{Binding CoverImagePath}" Aspect="AspectFill" IsVisible="{Binding HasImage}" />
            <Label Text="{Binding Title}" IsVisible="{Binding ShowRtlCoverTitle}" FontFamily="{Binding RtlCoverFont}" FontSize="18" FontAttributes="Bold"
                   TextColor="#2b2540" LineHeight="1.35" HorizontalTextAlignment="Center" VerticalOptions="Center" Margin="12" FlowDirection="RightToLeft" />
            <Label Text="{Binding Title}" IsVisible="{Binding ShowLatinCoverTitle}" FontFamily="AndikaBold" FontSize="18"
                   TextColor="White" LineHeight="1.2" HorizontalTextAlignment="Center" VerticalOptions="Center" Margin="12" />
        </Grid>
    </Border>
    </local:AspectRatioView>
</ContentView>
