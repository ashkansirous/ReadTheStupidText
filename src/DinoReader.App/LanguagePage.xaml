<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DinoReader.LanguagePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:DinoReader"
    xmlns:res="clr-namespace:DinoReader.Resources.Strings"
    BackgroundColor="{StaticResource Sand}"
    NavigationPage.HasNavigationBar="False"
    SafeAreaEdges="Container">

    <!-- Language (mock screen 26), opened from Settings (Slice 172): only the languages. The fifteen rows are built in code-behind. -->
    <Grid RowDefinitions="Auto,*">
        <local:GrownUpHeader Title="{x:Static res:AppResources.Language_Title}" Subtitle="{x:Static res:AppResources.Language_PageSub}"
                             BackRequested="OnBackTapped" DoneRequested="OnBackTapped" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout x:Name="Cards" Padding="14,0,14,20" Spacing="14">
                <Border BackgroundColor="White" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>
                    <VerticalStackLayout x:Name="Rows" />
                </Border>
                <Label Text="{x:Static res:AppResources.Language_Footer}" FontSize="12.5" LineHeight="1.4" TextColor="{StaticResource Body}" Margin="4,0" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
