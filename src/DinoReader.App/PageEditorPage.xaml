<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DinoReader.PageEditorPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:DinoReader"
    xmlns:res="clr-namespace:DinoReader.Resources.Strings"
    BackgroundColor="{StaticResource Sand}"
    NavigationPage.HasNavigationBar="False"
    SafeAreaEdges="Container">

    <!-- Rotate and crop one page (Slice 78): turn it in quarter turns and drag the corners of the frame to crop. No perspective
         correction (the document scanner already does that for scans). -->
    <Grid RowDefinitions="Auto,*,Auto">
        <local:GrownUpHeader x:Name="Header" Title="{x:Static res:AppResources.Editor_Title}" BackRequested="OnBackTapped" DoneRequested="OnDoneClicked" />

        <Grid x:Name="Stage" Grid.Row="1" Margin="14,0" SizeChanged="OnStageSizeChanged">
            <Image x:Name="Preview" Aspect="AspectFit" />
            <GraphicsView x:Name="CropSurface" BackgroundColor="Transparent"
                          StartInteraction="OnStartInteraction" DragInteraction="OnDragInteraction" EndInteraction="OnEndInteraction" />
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="10" Margin="14,10,14,14">
            <Button Text="↺" FontSize="22" HeightRequest="48" CornerRadius="24" BackgroundColor="{StaticResource BrandTint}" TextColor="{StaticResource Brand}"
                    SemanticProperties.Description="{x:Static res:AppResources.Editor_RotateLeft}" Clicked="OnRotateLeftClicked" />
            <Button Grid.Column="1" Text="{x:Static res:AppResources.Editor_ResetCrop}" FontSize="14" HeightRequest="48" CornerRadius="24"
                    BackgroundColor="{StaticResource BrandTint}" TextColor="{StaticResource Brand}" Clicked="OnResetClicked" />
            <Button Grid.Column="2" Text="↻" FontSize="22" HeightRequest="48" CornerRadius="24" BackgroundColor="{StaticResource BrandTint}" TextColor="{StaticResource Brand}"
                    SemanticProperties.Description="{x:Static res:AppResources.Editor_RotateRight}" Clicked="OnRotateRightClicked" />
        </Grid>
    </Grid>
</ContentPage>
