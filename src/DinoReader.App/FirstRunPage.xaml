<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DinoReader.FirstRunPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{StaticResource Cream}"
    NavigationPage.HasNavigationBar="False"
    SafeAreaEdges="Container">

    <!-- First run (onboarding mock 2026-11-08, Slice 325 part D: frames O1, O5 and their size variants), shown once on a fresh install before the gallery: pick the language, pick the first books,
         then hand over to grown-up mode. Both panels are OnboardingShell views built in code (FirstRunPage.xaml.cs) so one skeleton serves every window size; the ready texts are set after the pick,
         so they speak the language just chosen. -->
    <Grid>
        <Grid x:Name="LanguagePanel" AutomationId="FirstRunLanguage" />
        <Grid x:Name="ReadyPanel" AutomationId="FirstRunReady" IsVisible="False" />
    </Grid>
</ContentPage>
