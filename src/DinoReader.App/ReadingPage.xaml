<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DinoReader.ReadingPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#FFF6E6">

    <!-- Placeholder reading screen until Slice 62: the opened story's text, the narrator picker (Slice 60)
         and Play. Colours are the mock's child tokens (page #FFF6E6, ink #2b2540, play coral #FF7A59). -->
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Padding="16" RowSpacing="12">
        <Label Grid.Row="0" Text="Narrator" FontFamily="Fredoka" FontSize="14" TextColor="#5a5470" />

        <Picker Grid.Row="1" x:Name="NarratorPicker" Title="Narrator voice" FontFamily="Fredoka" FontSize="16"
                TextColor="#2b2540" TitleColor="#5a5470"
                SelectedIndexChanged="OnNarratorChanged" />

        <Border Grid.Row="2" BackgroundColor="White" StrokeThickness="0" Padding="12">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20" />
            </Border.StrokeShape>
            <ScrollView>
                <Label x:Name="StoryLabel" TextColor="#2b2540" FontFamily="Andika" FontSize="20" LineHeight="1.4" />
            </ScrollView>
        </Border>

        <Label Grid.Row="3" x:Name="StatusLabel" FontFamily="Fredoka" FontSize="14" TextColor="#5a5470" IsVisible="False">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnPackStatusTapped" />
            </Label.GestureRecognizers>
        </Label>

        <Button Grid.Row="4" x:Name="PlayButton" Text="Play" FontFamily="Fredoka" FontSize="22"
                BackgroundColor="#FF7A59" TextColor="White" CornerRadius="28" HeightRequest="56"
                Clicked="OnPlayClicked" />
    </Grid>
</ContentPage>
