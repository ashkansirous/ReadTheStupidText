<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DinoReader.AddStoryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:DinoReader"
    xmlns:res="clr-namespace:DinoReader.Resources.Strings"
    BackgroundColor="{StaticResource Sand}"
    NavigationPage.HasNavigationBar="False"
    SafeAreaEdges="Container, SoftInput">

    <!-- Add a story (mock screen 9). Scan pages and Photos need the camera and on-device text
         recognition, which Dino Reader does not carry yet, so those two tiles are shown dimmed. -->
    <Grid RowDefinitions="Auto,*,Auto">
        <Grid x:Name="Header" ColumnDefinitions="Auto,*" Padding="8,10,16,10">
            <Border WidthRequest="44" HeightRequest="44" BackgroundColor="Transparent" StrokeThickness="0"
                    SemanticProperties.Description="{x:Static res:AppResources.Common_Back}">
                <local:IconView Kind="Back" Color="{StaticResource Ink}" Size="22" StrokeWidth="2.6" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Border.GestureRecognizers>
            </Border>
            <Label Grid.Column="1" Text="{x:Static res:AppResources.Story_Add}" FontSize="20" FontAttributes="Bold" VerticalOptions="Center"
                   SemanticProperties.HeadingLevel="Level1" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="14,4,14,14" Spacing="10">
                <Grid x:Name="SourceGrid" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10" />

                <Border x:Name="TextCard" IsVisible="False" BackgroundColor="White" StrokeThickness="0" Padding="14,10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{x:Static res:AppResources.Story_Title}" FontSize="12" TextColor="{StaticResource Muted}" />
                        <Entry x:Name="TitleEntry" FontSize="16" FontAttributes="Bold" />
                        <BoxView HeightRequest="1" Color="{StaticResource Hairline}" />
                        <Editor x:Name="TextEditor" HeightRequest="220" AutoSize="Disabled" FontFamily="Andika" FontSize="18"
                                Placeholder="{x:Static res:AppResources.Add_Placeholder}" PlaceholderColor="{StaticResource Muted}"
                                TextChanged="OnTextChanged" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout x:Name="LanguageHost" />
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="2" x:Name="ResultCard" IsVisible="False" BackgroundColor="{StaticResource Ink}" StrokeThickness="0"
                Margin="14,0,14,14" Padding="14">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="18" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="10">
                <HorizontalStackLayout Spacing="8">
                    <local:IconView Kind="Check" Color="#7BE495" Size="20" StrokeWidth="2.6" />
                    <Label x:Name="SummaryLabel" FontSize="14.5" FontAttributes="Bold" TextColor="White" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <FlexLayout x:Name="NameChips" Wrap="Wrap" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Text="{x:Static res:AppResources.Add_CheckCast}" HeightRequest="44" CornerRadius="22" FontSize="14" BackgroundColor="#24FFFFFF"
                            TextColor="White" Clicked="OnCheckCastClicked" />
                    <Button Grid.Column="1" Text="{x:Static res:AppResources.Add_Save}" HeightRequest="44" CornerRadius="22" FontSize="14"
                            BackgroundColor="{StaticResource Coral}" TextColor="White" Clicked="OnSaveClicked" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
