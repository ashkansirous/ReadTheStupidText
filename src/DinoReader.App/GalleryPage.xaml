<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DinoReader.GalleryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:DinoReader"
    xmlns:res="clr-namespace:DinoReader.Resources.Strings"
    BackgroundColor="{StaticResource Cream}"
    NavigationPage.HasNavigationBar="False"
    SafeAreaEdges="Container">

    <!-- Home screen (mock screen 1): the child's stories. Reading needs no gate; the gear (Slice 172) runs the gate and opens Settings, whose
         Books row opens grown-up mode (Slice 80): this same grid with an edit overlay on each tile and, above it, the Add and Store buttons. -->
    <ContentPage.Resources>
        <!-- Fallback until the probe below has measured two real lines; replaced at runtime (GalleryPage.xaml.cs). -->
        <x:Double x:Key="TileTitleHeight">36</x:Double>
        <!-- Shared by the story and Add templates so their stacks cannot drift apart. -->
        <x:Double x:Key="TileSpacing">7</x:Double>
        <Style x:Key="TileTitleFont" TargetType="Label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="LineHeight" Value="1.25" />
            <Setter Property="MaxLines" Value="2" />
            <Setter Property="LineBreakMode" Value="TailTruncation" />
        </Style>
        <!-- Every tile (and the Add spacer) gets the same two-line title height, scaled with the font, so rows always match. -->
        <Style x:Key="TileTitle" TargetType="Label" BasedOn="{StaticResource TileTitleFont}">
            <Setter Property="HeightRequest" Value="{DynamicResource TileTitleHeight}" />
        </Style>

        <DataTemplate x:Key="StoryTemplate" x:DataType="local:StoryTile">
            <VerticalStackLayout Spacing="{StaticResource TileSpacing}" HorizontalOptions="Fill">
                <Grid>
                    <local:StoryCover AutomationId="StoryTile">
                        <local:StoryCover.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnStoryTapped" />
                        </local:StoryCover.GestureRecognizers>
                    </local:StoryCover>
                    <local:TileOverlay EditRequested="OnEditRequested" CastRequested="OnCastRequested" RecordRequested="OnRecordRequested" DeleteRequested="OnDeleteRequested" ExportRequested="OnExportRequested" />
                </Grid>
                <Label Style="{StaticResource TileTitle}" Text="{Binding Title}" AutomationId="StoryTileTitle">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnStoryTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>
        </DataTemplate>

        <local:GalleryTemplateSelector x:Key="Selector" StoryTemplate="{StaticResource StoryTemplate}" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- Invisible two-line sample in the tile title font: its measured height sizes every tile title. Its lines are
             fixed, so its height depends only on the font (not on the page or tile width) and the update cannot loop. -->
        <Label x:Name="TitleProbe" HorizontalOptions="Start" Style="{StaticResource TileTitleFont}" Text="&#160;&#10;&#160;" Opacity="0" InputTransparent="True"
               VerticalOptions="Start" AutomationProperties.IsInAccessibleTree="False" SizeChanged="OnTitleProbeSizeChanged" />
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Padding="16,10,12,12">
            <Border WidthRequest="40" HeightRequest="40" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="11" />
                </Border.StrokeShape>
                <Image x:Name="AppIcon" Source="dino_icon" Aspect="AspectFill" SemanticProperties.Description="{x:Static res:AppResources.App_Name}" />
            </Border>
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                <Label x:Name="TitleLabel" AutomationId="GalleryTitle" Text="{x:Static res:AppResources.Gallery_Title}" FontSize="22" FontAttributes="Bold" SemanticProperties.HeadingLevel="Level1">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTitleTapped" />
                    </Label.GestureRecognizers>
                </Label>
                <Label x:Name="ModeLabel" Text="{x:Static res:AppResources.Gallery_GrownUpsSub}" FontSize="12" TextColor="{StaticResource Muted}" IsVisible="False" />
            </VerticalStackLayout>
            <!-- Slice 172 (mock 79): the gear is the only grown-up way in. Always visible in kids' mode; it runs the gate, then opens Settings. -->
            <Border Grid.Column="2" x:Name="SettingsButton" AutomationId="GallerySettings" WidthRequest="48" HeightRequest="48" BackgroundColor="{StaticResource ControlFill}"
                    StrokeThickness="0" SemanticProperties.Description="{x:Static res:AppResources.Settings_GearLabel}" ToolTipProperties.Text="{x:Static res:AppResources.Settings_GearLabel}" SemanticProperties.Hint="{x:Static res:AppResources.Gallery_OpensGateHint}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <Path Data="M15 12a3 3 0 1 0-6 0a3 3 0 1 0 6 0 M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"
                      Stroke="{StaticResource Muted}" StrokeThickness="2" StrokeLineCap="Round" StrokeLineJoin="Round" Aspect="Uniform" WidthRequest="24" HeightRequest="24"
                      HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSettingsTapped" />
                </Border.GestureRecognizers>
            </Border>
            <Button Grid.Column="2" x:Name="DoneButton" IsVisible="False" Text="{x:Static res:AppResources.Common_Done}" HeightRequest="44" CornerRadius="22"
                    Padding="18,0" FontSize="14" BackgroundColor="{StaticResource Brand}" TextColor="White" Clicked="OnDoneClicked" />
        </Grid>

        <!-- Grown-up mode (mock 85, Slice 172): only "Add from your own books" and the Store, full width. The store is behind the gate (ready for paid books later). -->
        <VerticalStackLayout Grid.Row="1">
        <VerticalStackLayout x:Name="GrownUpActions" Padding="14,4,14,14" Spacing="8" IsVisible="False">
            <Border x:Name="AddBookButton" AutomationId="GalleryAddBook" HeightRequest="52" BackgroundColor="{StaticResource Coral}" StrokeThickness="0"
                    SemanticProperties.Description="{x:Static res:AppResources.Gallery_AddFromBooks}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>
                <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                    <local:IconView Kind="Plus" Color="White" Size="20" StrokeWidth="2.8" VerticalOptions="Center" />
                    <Label x:Name="AddBookLabel" Text="{x:Static res:AppResources.Gallery_AddFromBooks}" FontSize="15" FontAttributes="Bold" TextColor="White" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAddTapped" />
                </Border.GestureRecognizers>
            </Border>
            <Border x:Name="StoreButton" AutomationId="GalleryStore" HeightRequest="52" BackgroundColor="{StaticResource BrandTint}" StrokeThickness="0"
                    SemanticProperties.Description="{x:Static res:AppResources.Store_Title}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>
                <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                    <local:IconView Kind="Book" Color="{StaticResource Brand}" Size="20" StrokeWidth="2.2" VerticalOptions="Center" />
                    <Label x:Name="StoreLabel" Text="{x:Static res:AppResources.Store_Title}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Brand}" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnStoreTapped" />
                </Border.GestureRecognizers>
            </Border>
        </VerticalStackLayout>
        <!-- Slice 115 (mock frame 50): the storyteller download's status line, grown-up mode only. -->
        <local:StorytellerStatusLine x:Name="StorytellerLine" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="2" x:Name="StoryList" AutomationId="GalleryStories" SelectionMode="None" Margin="14,0" ItemTemplate="{StaticResource Selector}">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="12" VerticalItemSpacing="12" />
            </CollectionView.ItemsLayout>
        </CollectionView>

        <!-- First grown-up view only (mock 19): hands the phone to the child. Later visits use the Done button in the header. -->
        <local:CoralButton Grid.Row="3" x:Name="HandoverButton" Margin="22,8,22,14" Icon="Book" IsVisible="False" Clicked="OnHandoverClicked" />

        <!-- Slice 115 (mock frame 51): the one-time "Storyteller voices are ready" sheet over the whole page. -->
        <local:StorytellerReadySheet Grid.RowSpan="4" x:Name="ReadySheet" />
    </Grid>
</ContentPage>
