<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DinoReader.GalleryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:DinoReader"
    xmlns:res="clr-namespace:DinoReader.Resources.Strings"
    BackgroundColor="{StaticResource Cream}"
    NavigationPage.HasNavigationBar="False"
    SafeAreaEdges="Container">

    <!-- Home screen (mock screen 1): the child's stories. Reading needs no gate; the add-book button opens grown-up
         mode (Slice 80), which is this same grid with an edit overlay on each tile and the Add tile first. -->
    <ContentPage.Resources>
        <!-- Fallback until the probe below has measured two real lines; replaced at runtime (GalleryPage.xaml.cs). -->
        <x:Double x:Key="TileTitleHeight">36</x:Double>
        <!-- Shared by the story and Add templates so their stacks cannot drift apart. -->
        <x:Double x:Key="TileSpacing">7</x:Double>
        <Style x:Key="TileTitleFont" TargetType="Label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="LineHeight" Value="1.25" />
            <Setter Property="MaxLines" Value="2" />
            <Setter Property="LineBreakMode" Value="TailTruncation" />
        </Style>
        <!-- Every tile (and the Add spacer) gets the same two-line title height, scaled with the font, so rows always match. -->
        <Style x:Key="TileTitle" TargetType="Label" BasedOn="{StaticResource TileTitleFont}">
            <Setter Property="HeightRequest" Value="{DynamicResource TileTitleHeight}" />
        </Style>

        <DataTemplate x:Key="StoryTemplate" x:DataType="local:StoryTile">
            <VerticalStackLayout Spacing="{StaticResource TileSpacing}" HorizontalOptions="Fill">
                <Grid>
                    <local:StoryCover>
                        <local:StoryCover.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnStoryTapped" />
                        </local:StoryCover.GestureRecognizers>
                    </local:StoryCover>
                    <local:TileOverlay EditRequested="OnEditRequested" CastRequested="OnCastRequested" DeleteRequested="OnDeleteRequested" ExportRequested="OnExportRequested" />
                </Grid>
                <Label Style="{StaticResource TileTitle}" Text="{Binding Title}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnStoryTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>
        </DataTemplate>

        <DataTemplate x:Key="AddTemplate">
            <!-- Same shape as a story tile (cover-shaped box + one title row) so the first item, which Windows sizes the
                 whole grid from, measures like the rest. -->
            <VerticalStackLayout Spacing="{StaticResource TileSpacing}" HorizontalOptions="Fill">
                <local:AspectRatioView HorizontalOptions="Fill">
                    <Border BackgroundColor="White" Stroke="#c9c0f5" StrokeThickness="3" StrokeDashArray="3,3"
                            SemanticProperties.Description="{x:Static res:AppResources.Story_Add}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="6">
                            <local:IconView Kind="Plus" Color="{StaticResource Brand}" Size="28" StrokeWidth="2.6" />
                            <Label Text="{x:Static res:AppResources.Story_Add}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Brand}" />
                        </VerticalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAddTapped" />
                        </Border.GestureRecognizers>
                    </Border>
                </local:AspectRatioView>
                <!-- Placeholder for the title row: the same text style as a story title, hidden from Narrator. -->
                <Label Style="{StaticResource TileTitle}" Text="&#160;" InputTransparent="True"
                       AutomationProperties.IsInAccessibleTree="False" />
            </VerticalStackLayout>
        </DataTemplate>

        <local:GalleryTemplateSelector x:Key="Selector" AddTemplate="{StaticResource AddTemplate}" StoryTemplate="{StaticResource StoryTemplate}" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- Invisible two-line sample in the tile title font: its measured height sizes every tile title. Its lines are
             fixed, so its height depends only on the font (not on the page or tile width) and the update cannot loop. -->
        <Label x:Name="TitleProbe" HorizontalOptions="Start" Style="{StaticResource TileTitleFont}" Text="&#160;&#10;&#160;" Opacity="0" InputTransparent="True"
               VerticalOptions="Start" AutomationProperties.IsInAccessibleTree="False" SizeChanged="OnTitleProbeSizeChanged" />
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10" Padding="16,10,16,12">
            <Border WidthRequest="40" HeightRequest="40" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="11" />
                </Border.StrokeShape>
                <Image Source="dino_icon" Aspect="AspectFill" SemanticProperties.Description="{x:Static res:AppResources.App_Name}" />
            </Border>
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                <Label Text="{x:Static res:AppResources.Gallery_Title}" FontSize="22" FontAttributes="Bold" SemanticProperties.HeadingLevel="Level1">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTitleTapped" />
                    </Label.GestureRecognizers>
                </Label>
                <Label x:Name="ModeLabel" Text="{x:Static res:AppResources.Gallery_GrownUpMode}" FontSize="12.5" TextColor="{StaticResource Brand}" IsVisible="False" />
            </VerticalStackLayout>
            <!-- Language pill (mock 19): the current language, opens the Language page. Grown-up mode only. -->
            <Border Grid.Column="2" x:Name="LanguagePill" HeightRequest="44" Padding="12,0,14,0" BackgroundColor="White" Stroke="{StaticResource MergeBorder}"
                    StrokeThickness="2" IsVisible="False" VerticalOptions="Center" SemanticProperties.Hint="{x:Static res:AppResources.Language_Title}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <local:IconView Kind="Globe" Color="{StaticResource Brand}" Size="18" StrokeWidth="2.2" VerticalOptions="Center" />
                    <Label x:Name="LanguagePillLabel" FontSize="14.5" FontAttributes="Bold" TextColor="{StaticResource Brand}" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnLanguageTapped" />
                </Border.GestureRecognizers>
            </Border>
            <Border Grid.Column="3" x:Name="AddBookButton" WidthRequest="44" HeightRequest="44" BackgroundColor="{StaticResource ControlFill}"
                    StrokeThickness="0" SemanticProperties.Description="{x:Static res:AppResources.Gallery_AddBook}" ToolTipProperties.Text="{x:Static res:AppResources.Gallery_AddBook}" SemanticProperties.Hint="{x:Static res:AppResources.Gallery_OpensGateHint}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <local:IconView Kind="AddBook" Color="{StaticResource Muted}" Size="24" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAddBookTapped" />
                </Border.GestureRecognizers>
            </Border>
            <Button Grid.Column="3" x:Name="DoneButton" IsVisible="False" Text="{x:Static res:AppResources.Common_Done}" HeightRequest="44" CornerRadius="22"
                    Padding="18,0" FontSize="14" BackgroundColor="{StaticResource Brand}" TextColor="White" Clicked="OnDoneClicked" />
        </Grid>

        <!-- Grown-up shortcuts (mock 38): Free stories (Slice 92), Narrator (Slice 109) and Backup (Slice 93), three equal buttons with the icon above the label. -->
        <Grid Grid.Row="1" x:Name="GrownUpActions" Padding="14,0,14,12" ColumnDefinitions="*,*,*" ColumnSpacing="8" IsVisible="False">
            <Border x:Name="StoreButton" HeightRequest="64" BackgroundColor="White" Stroke="{StaticResource MergeBorder}" StrokeThickness="2"
                    SemanticProperties.Description="{x:Static res:AppResources.Store_Title}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="3" VerticalOptions="Center" HorizontalOptions="Center">
                    <local:IconView Kind="Book" Color="{StaticResource Brand}" Size="20" StrokeWidth="2.2" HorizontalOptions="Center" />
                    <Label Text="{x:Static res:AppResources.Store_Title}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Brand}" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" MaxLines="1" />
                </VerticalStackLayout>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnStoreTapped" />
                </Border.GestureRecognizers>
            </Border>
            <Border Grid.Column="1" x:Name="NarratorButton" HeightRequest="64" BackgroundColor="White" Stroke="{StaticResource MergeBorder}" StrokeThickness="2"
                    SemanticProperties.Description="{x:Static res:AppResources.Narrator_Title}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="3" VerticalOptions="Center" HorizontalOptions="Center">
                    <local:IconView Kind="Narrator" Color="{StaticResource Brand}" Size="20" StrokeWidth="2.2" HorizontalOptions="Center" />
                    <Label Text="{x:Static res:AppResources.Narrator_Title}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Brand}" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" MaxLines="1" />
                </VerticalStackLayout>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnNarratorTapped" />
                </Border.GestureRecognizers>
            </Border>
            <Border Grid.Column="2" x:Name="BackupButton" HeightRequest="64" BackgroundColor="White" Stroke="{StaticResource MergeBorder}" StrokeThickness="2"
                    SemanticProperties.Description="{x:Static res:AppResources.Backup_Title}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="3" VerticalOptions="Center" HorizontalOptions="Center">
                    <local:IconView Kind="File" Color="{StaticResource Brand}" Size="20" StrokeWidth="2.2" HorizontalOptions="Center" />
                    <Label Text="{x:Static res:AppResources.Backup_Title}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Brand}" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" MaxLines="1" />
                </VerticalStackLayout>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackupTapped" />
                </Border.GestureRecognizers>
            </Border>
        </Grid>

        <CollectionView Grid.Row="2" x:Name="StoryList" SelectionMode="None" Margin="14,0" ItemTemplate="{StaticResource Selector}">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="12" VerticalItemSpacing="12" />
            </CollectionView.ItemsLayout>
        </CollectionView>

        <!-- First grown-up view only (mock 19): hands the phone to the child. Later visits use the Done button in the header. -->
        <local:CoralButton Grid.Row="3" x:Name="HandoverButton" Margin="22,8,22,14" Icon="Book" IsVisible="False" Clicked="OnHandoverClicked" />
    </Grid>
</ContentPage>
