<Project Sdk="Microsoft.NET.Sdk">

	<!-- Dino Reader (Batch 10, Slice 58, Decision 72): a kids' book reader, a second MAUI app in
	     this repo. Android always; iOS only where it can be built (Slice 67), with the same
	     IncludeIos/IncludeAndroid logic as ReadTheStupidText.Mobile.csproj: net10.0-ios is added on
	     macOS or with -p:IncludeIos=true, so Windows and Linux builds never need Xcode, and the
	     iOS CI job passes -p:IncludeAndroid=false. net10.0-windows10.0.19041.0 (Slice 67) is added on
	     Windows only (an MSIX; no tray, no hotkey), and -p:IncludeWindows=false drops it. -->
	<PropertyGroup>
		<TargetFrameworks Condition="'$(IncludeAndroid)' != 'false'">net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="($([MSBuild]::IsOSPlatform('OSX')) Or '$(IncludeIos)' == 'true') And '$(TargetFrameworks)' == ''">net10.0-ios</TargetFrameworks>
		<TargetFrameworks Condition="($([MSBuild]::IsOSPlatform('OSX')) Or '$(IncludeIos)' == 'true') And '$(TargetFrameworks)' != '' And !$(TargetFrameworks.Contains('net10.0-ios'))">$(TargetFrameworks);net10.0-ios</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Windows')) And '$(IncludeWindows)' != 'false' And '$(TargetFrameworks)' == ''">net10.0-windows10.0.19041.0</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Windows')) And '$(IncludeWindows)' != 'false' And '$(TargetFrameworks)' != '' And !$(TargetFrameworks.Contains('net10.0-windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>DinoReader</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<ApplicationTitle>Dino Book Reader</ApplicationTitle>

		<!-- Google Play package name — fixed once published. -->
		<ApplicationId>uk.sirous.dinoreader</ApplicationId>

		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- 28 (Android 9, 2018) is the product floor for every Android app in this repo
		     (Decision 82). Do not lower it. -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">28.0</SupportedOSPlatformVersion>

		<!-- iOS 15 is the MAUI 10 minimum for iOS. -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<!-- Windows (Slice 67): a packaged MSIX like Read The Stupid Text's. The Release package is built .NET
	     self-contained so the Store sees no undisclosed .NET dependency (certification 10.2.4.1); the Windows
	     App SDK stays framework-dependent (the Store delivers it). Debug stays framework-dependent. Packaged
	     apps are not trimmed. Package identity and the tile/splash art are in Platforms\Windows\Package.appxmanifest. -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
		<WindowsPackageType>MSIX</WindowsPackageType>
		<ApplicationManifest>Platforms/Windows/app.manifest</ApplicationManifest>
		<SelfContained Condition="'$(Configuration)' != 'Debug'">true</SelfContained>
		<PublishTrimmed>false</PublishTrimmed>
		<!-- Set here, not on the command line: a global RuntimeIdentifier also flows into Mobile.Shared and
		     makes the package payload list its .pdb twice (APPX1101). CI passes only -p:Platform. -->
		<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' And '$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
		<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' And '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
	</PropertyGroup>
	<!-- The ready-made "Book hug" tile, store and splash art, copied from docs/design/dino-reader/icons/windows.
	     Deliberately NO <MauiIcon>: it would generate different art over these. -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<Content Include="Platforms\Windows\Assets\*.png" Link="Assets\%(Filename)%(Extension)" />
	</ItemGroup>

	<!-- iOS app icon (Slice 67): the ready-made "Book hug" asset catalog (iOS 18 light/dark/tinted
	     1024s), copied from docs/design/dino-reader/icons/ios, never regenerated. Deliberately NO
	     <MauiIcon> for the same reason as Android: it would generate a different icon. The legacy
	     sizes are unused because the deployment target uses single-size icons, which actool expands.
	     The catalog is declared explicitly as ImageAsset items linked at Assets.xcassets\ and named by
	     AppIcon: leaning on the SDK's default items shipped it as a raw folder with no Assets.car or
	     CFBundleIconName, and App Store Connect rejected v1.33.0 (90022, 90023, 90713). -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<CodesignEntitlements>Platforms\iOS\Entitlements.plist</CodesignEntitlements>
		<AppIcon>AppIcon</AppIcon>
	</PropertyGroup>
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<!-- The privacy manifest App Store Connect requires. -->
		<BundleResource Include="Platforms\iOS\Resources\PrivacyInfo.xcprivacy" LogicalName="PrivacyInfo.xcprivacy" />
		<!-- Drop the SDK's default items for the catalog (their Link keeps the Platforms\iOS\Resources\
		     prefix, which the old XSAppIconAssets plist key never matched), then add it back linked at Assets.xcassets\. -->
		<BundleResource Remove="Platforms\iOS\Resources\Assets.xcassets\**" />
		<ImageAsset Remove="Platforms\iOS\Resources\Assets.xcassets\**" />
		<ImageAsset Include="Platforms\iOS\Resources\Assets.xcassets\**\*.*" Link="Assets.xcassets\%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<!-- App icon: deliberately NO <MauiIcon>. MauiIcon generates a mipmap/appicon adaptive icon
	     and rewrites the manifest's android:icon, which would overwrite the ready-made "Book hug"
	     set in Platforms/Android/Resources/mipmap-*. Those folders are picked up as Android
	     resources by convention and AndroidManifest.xml points at @mipmap/ic_launcher(_round). -->
	<ItemGroup>
		<!-- Fonts (SIL OFL 1.1, licences in Licenses/ and STORE.md): bundled, never fetched at runtime. -->
		<MauiFont Include="Resources\Fonts\*" />
		<!-- The gallery's top-bar app icon (copied from docs/design/dino-reader/icons/android/play-store-512.png). -->
		<MauiImage Include="Resources\Images\dino_icon.png" BaseSize="40,40" />
		<!-- Slice 143: the app icon at the wait overlay's 84 size (dino_icon is a 40 base and would blur). -->
		<MauiImage Include="Resources\Images\dino_wait.png" BaseSize="84,84" />
		<!-- The bundled starter stories (Slice 91): .dino packages opened with FileSystem.OpenAppPackageFileAsync("<name>.dino"); flat names, because the Windows package drops the folder. -->
		<MauiAsset Include="Resources\Raw\starters\*.dino" LogicalName="%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

	<!-- Slice 132: Play's in-app update (the forced "Please update" page uses its immediate flow). -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<PackageReference Include="Xamarin.Google.Android.Play.App.Update" Version="2.1.0.20" />
	</ItemGroup>

	<!-- ExcludeAssets does not flow through a project reference (see AndroidSherpaPackaging.props). -->
	<Import Project="..\AndroidSherpaPackaging.props" />
	<Import Project="..\AndroidRelease.props" />

	<!-- iOS neural voice and OCR native packaging (Slice 67): the sherpa-onnx framework fetch and
	     onnxruntime, imported like the Android one above. -->
	<Import Project="..\ReadTheStupidText.Mobile.Shared\IosSherpaPackaging.props" />

	<!-- Same fix as the RTST App: the Windows App SDK pulls WinML, whose onnxruntime.dll collides with
	     sherpa-onnx's version-matched one at the package root (APPX1101). We use sherpa's. -->
	<Target Name="RemoveWinMlOnnxRuntimeDuplicate" AfterTargets="GetPackagingOutputs" BeforeTargets="_ComputeAppxPackagePayload" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<ItemGroup>
			<PackagingOutputs Remove="@(PackagingOutputs)" Condition="'%(FileName)%(Extension)' == 'onnxruntime.dll' and $([System.String]::Copy('%(FullPath)').Replace('\','/').ToLowerInvariant().Contains('/microsoft.windows.ai.machinelearning/'))" />
		</ItemGroup>
	</Target>

	<ItemGroup>
		<ProjectReference Include="..\ReadTheStupidText.Domain\ReadTheStupidText.Domain.csproj" />
		<ProjectReference Include="..\ReadTheStupidText.Application\ReadTheStupidText.Application.csproj" />
		<ProjectReference Include="..\ReadTheStupidText.Mobile.Shared\ReadTheStupidText.Mobile.Shared.csproj" />
		<ProjectReference Include="..\ReadTheStupidText.Documents\ReadTheStupidText.Documents.csproj" />
		<ProjectReference Include="..\DinoReader.Core\DinoReader.Core.csproj" />
	</ItemGroup>

	<!-- Windows: MAUI's resizetizer adds the fonts to the MSIX payload and publish\ only. Win2D (WindowsTextMeasurer)
	     loads them from the registered layout (the build output folder), so copy them there too. -->
	<Target Name="DinoFontsToLayout" AfterTargets="_CollectMauiFontItems" Condition="'$(_ResizetizerIsWindowsAppSdk)' == 'True'">
		<ItemGroup>
			<ContentWithTargetPath Update="@(_MauiFontCopied)" CopyToOutputDirectory="PreserveNewest" TargetPath="%(Filename)%(Extension)" DinoFont="true" />
		</ItemGroup>
		<Warning Condition="'@(_MauiFontCopied)' != '' And '@(ContentWithTargetPath->HasMetadata('DinoFont'))' == ''" Text="DinoFontsToLayout matched no font item: the fonts will not be in the Windows layout and text measuring falls back to a default font." />
	</Target>

	<!-- Fail early and clearly instead of restoring a project with no target framework. -->
	<Target Name="EnsureATargetFramework" BeforeTargets="_CheckForUnsupportedTargetFramework;Restore;CollectPackageReferences" Condition="'$(TargetFrameworks)' == '' And '$(TargetFramework)' == ''">
		<Error Text="DinoReader.App has no target framework: -p:IncludeAndroid=false removed Android and iOS is only added on macOS or with -p:IncludeIos=true. Pass -p:IncludeIos=true, or drop -p:IncludeAndroid=false." />
	</Target>

</Project>
