<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="DinoReader.TileOverlay"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:DinoReader"
    x:DataType="local:StoryTile"
    IsVisible="{Binding Mode.IsGrownUp}">

    <!-- Grown-up overlay on a gallery cover (Slice 189, mock Batch 37 frame 85b): one white 36 px dot with a soft shadow and a "⋯" at the top-right corner
         (6 px in), its tap area 48 dp. It opens the book's options sheet; Edit, Cast, Record, Export and Remove live in that sheet. -->
    <Grid>
        <!-- Swallows taps on the bare cover and opens the book's sheet, so they never fall through to the cover's own tap. -->
        <Grid BackgroundColor="Transparent">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnBackdropTapped" />
            </Grid.GestureRecognizers>
        </Grid>
        <Grid HorizontalOptions="End" VerticalOptions="Start" WidthRequest="48" HeightRequest="48" AutomationId="TileMore"
              SemanticProperties.Description="{Binding MoreHint}">
            <Border WidthRequest="36" HeightRequest="36" BackgroundColor="White" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#2b2540" Opacity="0.2" Offset="0,2" Radius="3" />
                </Border.Shadow>
                <local:IconView Kind="MoreDots" Color="{StaticResource Ink}" Size="18" Filled="True" />
            </Border>
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnMoreTapped" />
            </Grid.GestureRecognizers>
        </Grid>
    </Grid>
</ContentView>
