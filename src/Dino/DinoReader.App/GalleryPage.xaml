<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DinoReader.GalleryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:DinoReader"
    xmlns:res="clr-namespace:DinoReader.Resources.Strings"
    BackgroundColor="{StaticResource Cream}"
    NavigationPage.HasNavigationBar="False"
    SafeAreaEdges="None">

    <!-- Home screen: the child's stories. Slice 325 (2026-11-08 grown-up mock): the kids' shelf (ShelfHeader) and the grown-ups' corner (CornerShell, CornerTabs) are two chromes around this one grid.
         Under 600 dp wide the chrome is a header (and, in the corner, a tab bar); from 600 it is a left rail. The chrome views are built in code (GalleryPage.xaml.cs, AddChrome); the page is edge to edge
         (SafeAreaEdges None) so the ink and the cream run under the status bar and the notch, and each piece keeps its own contents clear with its own safe area. -->
    <ContentPage.Resources>
        <!-- Fallback until the probe below has measured two real lines; replaced at runtime (GalleryPage.xaml.cs). -->
        <x:Double x:Key="TileTitleHeight">36</x:Double>
        <!-- Everything below follows the window's size (GalleryPage.xaml.cs, ApplyShape): the cover's radius and shadow, the title size, the gap under the cover and the grown-ups' "⋯" dot. -->
        <x:Double x:Key="TileWidth">-1</x:Double>
        <x:Int32 x:Key="TileTitleLines">2</x:Int32>
        <x:Double x:Key="TileSpacing">7</x:Double>
        <x:Double x:Key="TileTitleSize">14</x:Double>
        <CornerRadius x:Key="TileCoverRadius">16</CornerRadius>
        <x:Double x:Key="TileShadowOpacity">0.08</x:Double>
        <x:Double x:Key="TileShadowOffset">4</x:Double>
        <x:Double x:Key="TileMoreSize">36</x:Double>
        <CornerRadius x:Key="TileMoreRadius">18</CornerRadius>
        <Thickness x:Key="TileMoreInset">0,6,6,0</Thickness>
        <Style x:Key="TileTitleFont" TargetType="Label">
            <Setter Property="FontSize" Value="{DynamicResource TileTitleSize}" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="LineHeight" Value="1.25" />
            <Setter Property="MaxLines" Value="{DynamicResource TileTitleLines}" />
            <Setter Property="LineBreakMode" Value="TailTruncation" />
        </Style>
        <!-- Every tile gets the same two-line title height, scaled with the font, so rows always match. -->
        <Style x:Key="TileTitle" TargetType="Label" BasedOn="{StaticResource TileTitleFont}">
            <Setter Property="HeightRequest" Value="{DynamicResource TileTitleHeight}" />
        </Style>

        <DataTemplate x:Key="StoryTemplate" x:DataType="local:StoryTile">
            <VerticalStackLayout Spacing="{DynamicResource TileSpacing}" HorizontalOptions="Fill" WidthRequest="{DynamicResource TileWidth}">
                <Grid>
                    <local:StoryCover AutomationId="StoryTile" ShadowDepth="{DynamicResource TileShadowOffset}">
                        <local:StoryCover.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnStoryTapped" />
                        </local:StoryCover.GestureRecognizers>
                    </local:StoryCover>
                    <local:TileOverlay OpenRequested="OnOpenRequested" HoldRequested="OnHoldRequested" />
                </Grid>
                <Label Style="{StaticResource TileTitle}" Text="{Binding Title}" FontFamily="{Binding TitleFont}" AutomationId="StoryTileTitle">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnStoryTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>
        </DataTemplate>

        <local:GalleryTemplateSelector x:Key="Selector" StoryTemplate="{StaticResource StoryTemplate}" />
    </ContentPage.Resources>

    <!-- Two columns, the first only the rail (0 wide under a bar). Rows: the bar header, the content, the corner's tab bar. The chrome views are added in code; see AddChrome. -->
    <Grid x:Name="GalleryRoot" RowDefinitions="Auto,*,Auto" ColumnDefinitions="0,*">
        <!-- Invisible two-line sample in the tile title font: its measured height sizes every tile title. Its lines are
             fixed, so its height depends only on the font (not on the page or tile width) and the update cannot loop. -->
        <Label x:Name="TitleProbe" Grid.ColumnSpan="2" HorizontalOptions="Start" Style="{StaticResource TileTitleFont}" Text="&#160;&#10;&#160;" Opacity="0" InputTransparent="True"
               VerticalOptions="Start" AutomationProperties.IsInAccessibleTree="False" SizeChanged="OnTitleProbeSizeChanged" />

        <!-- The content column: in the corner a title row (the tab's name, and under a bar the one-line note) above the grid of books; on the shelf the grid alone. -->
        <Grid x:Name="ContentHost" Grid.Row="1" Grid.ColumnSpan="2" RowDefinitions="Auto,*">
            <Grid x:Name="ContentHeader" IsVisible="False" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="2">
                <!-- no-tap-count: the title's seven taps open the developer switch, not a control -->
                <Label x:Name="ContentTitle" AutomationId="GalleryRailTitle" FontAttributes="Bold" TextColor="{StaticResource Ink}" VerticalOptions="End" LineBreakMode="TailTruncation" MaxLines="1" SemanticProperties.HeadingLevel="Level1">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTitleTapped" />
                    </Label.GestureRecognizers>
                </Label>
                <Label x:Name="ContentNote" AutomationId="GalleryCornerLine" Grid.Column="1" TextColor="{StaticResource Body}" VerticalOptions="End" LineBreakMode="TailTruncation" MaxLines="2" />
                <!-- Slice 325 part B (frame T2): the Store tab's sub-line under its title, "Picked and cast for Dino", 14 / Muted. -->
                <Label x:Name="ContentSub" AutomationId="GalleryStoreSub" Grid.Row="1" Grid.ColumnSpan="2" IsVisible="False" FontSize="14" TextColor="{StaticResource Muted}" LineBreakMode="TailTruncation" MaxLines="2" />
            </Grid>
            <CollectionView Grid.Row="1" x:Name="StoryList" AutomationId="GalleryStories" SelectionMode="None" ItemTemplate="{StaticResource Selector}">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="12" VerticalItemSpacing="12" />
                </CollectionView.ItemsLayout>
            </CollectionView>
            <!-- Slice 325 part B: the Store and Settings tabs (StorePage, SettingsTab) are shown here, in place of the books, inside the corner's chrome. Built in code (GalleryPage.xaml.cs, ApplyTab). -->
            <ContentView x:Name="TabHost" Grid.Row="1" IsVisible="False" />
        </Grid>

        <local:BookSheet Grid.RowSpan="3" Grid.ColumnSpan="2" x:Name="BookInfo" />
    </Grid>
</ContentPage>
