<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- A story keeps reading when the screen locks or the app is backgrounded. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- The app icon is named by <AppIcon> in DinoReader.App.csproj; the SDK refuses XSAppIconAssets here too. -->
	<!-- App Store Connect rejects an iPad-capable app without a launch screen (90475). There is no
	     MauiSplashScreen (it would generate other art), so this plain system launch screen
	     (iOS 14+, the minimum here is 15) stands in for a storyboard. -->
	<key>UILaunchScreen</key>
	<dict/>

	<!-- The only encryption is HTTPS to download the books' pre-made audio and, behind the grown-up gate, the free
	     story list and the stories a grown-up picks (Slice 92), which is exempt; this answers App
	     Store Connect's export-compliance question so TestFlight builds are not held at
	     "Missing Compliance". -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- No camera or photo-library purpose strings (Slice 349 work item 4): Dino Reader scans nothing, and Mobile.Shared's
	     VisionKitDocumentScanner (the only camera/photo API user) is excluded from this iOS build (DropSpeechEngineSources). -->

	<!-- The microphone is asked for only on the Record screen, behind the grown-up gate, when a parent records their own reading of a
	     page (Slice 111). The recording stays on the device (and in a backup the grown-up makes) and is never uploaded. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>A parent can record their own voice reading a page of a story. The recording stays on this device and is never uploaded.</string>
</dict>
</plist>
