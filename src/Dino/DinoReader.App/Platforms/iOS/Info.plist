<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<!-- Slice 401: declared so the App Store can list the app's languages (with the .lproj folders in DinoReader.App.csproj), not the store listing. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>ar</string>
		<string>es</string>
		<string>fa</string>
		<string>fr</string>
		<string>ja</string>
		<string>da</string>
		<string>fi</string>
		<string>sv</string>
		<string>nb</string>
		<string>nl</string>
		<string>de</string>
		<string>pt</string>
		<string>ru</string>
		<string>zh-Hans</string>
	</array>
	<!-- Slice 438: Sonos links a home through the Dino app: the link page (site/dino/sonos-link.html) opens dinoreader://sonos-link?code=... and SonosLinkRouter (MauiProgram, SceneOpenUrl/SceneWillConnect) shows the Link screen. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>uk.sirous.dinoreader.sonoslink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>dinoreader</string>
			</array>
		</dict>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- A story keeps reading when the screen locks or the app is backgrounded. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- Slice 379 part B: apps built with the iOS 27 SDK must use the UIKit scene lifecycle (MT7199). The scene delegate is Platforms/iOS/SceneDelegate.cs;
	     the configuration name and the delegate name are fixed by MAUI. Multiple windows stay off, which keeps the single-window behaviour. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>__MAUI_DEFAULT_SCENE_CONFIGURATION__</string>
					<key>UISceneDelegateClassName</key>
					<string>SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<!-- The app icon is named by <AppIcon> in DinoReader.App.csproj; the SDK refuses XSAppIconAssets here too. -->
	<!-- App Store Connect rejects an iPad-capable app without a launch screen (90475). There is no
	     MauiSplashScreen (it would generate other art), so this plain system launch screen
	     (iOS 14+, the minimum here is 15) stands in for a storyboard. -->
	<key>UILaunchScreen</key>
	<dict/>

	<!-- The only encryption is HTTPS to download the books' pre-made audio and, behind the grown-up gate, the story list, the stories a grown-up picks (Slice 92)
	     and, for a bought book, the App Store's purchase proof in a request header (Slice 346: kept by nobody, no account), which is exempt; this answers App
	     Store Connect's export-compliance question so TestFlight builds are not held at
	     "Missing Compliance". -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- No camera or photo-library purpose strings (Slice 349 work item 4): Dino Reader scans nothing, and Mobile.Shared's
	     VisionKitDocumentScanner (the only camera/photo API user) is excluded from this iOS build (DropSpeechEngineSources). -->

	<!-- The microphone is asked for only on the Record screen, behind the grown-up gate, when a parent records their own reading of a
	     page (Slice 111). The recording stays on the device (and in a backup the grown-up makes) and is never uploaded. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>A parent can record their own voice reading a page of a story. The recording stays on this device and is never uploaded.</string>
</dict>
</plist>
