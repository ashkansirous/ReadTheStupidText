<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="DinoReader.StorePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
    xmlns:local="clr-namespace:DinoReader"
    xmlns:res="clr-namespace:DinoReader.Resources.Strings">

    <!-- The Store tab of the grown-ups' corner (Slice 325 part B, grown-up mock frame T2; was the pushed Free stories page of Slice 92, mock screens 21-23). The corner's own title row above it says
         "Store" and "Picked and cast for Dino"; this view has no header, no back arrow and no Done. One of four states shows at a time: loading, the list, offline (22) or empty (23).
         Cards are frame T2's: a 76 wide 3:4 cover, the title, the credits, the length, and at the end the 44 high Get pill or "On the shelf". -->
    <ContentView.Resources>
        <Color x:Key="StoreGreen">#2E7D32</Color>
        <Color x:Key="CoverPlaceholder">#efe6d2</Color>
        <x:String x:Key="WifiOffGlyph">M2 8.5a15 15 0 0 1 20 0M5 12a10 10 0 0 1 14 0M8.5 15.5a5 5 0 0 1 7 0M3 3l18 18</x:String>
        <x:String x:Key="ServerErrorGlyph">M12 2a10 10 0 1 0 0 20a10 10 0 1 0 0-20M12 7v6M12 16.5v0.5</x:String>
        <!-- Slice 364: the Missing States mock's glyphs on its 24-unit grid (cart, alert circle, retry arrow, cloud), and its strip and tag colours. -->
        <x:String x:Key="CartGlyph">M3.5 4.5h2.2l2.1 10.2h10.1l1.9-7.2H7M8.1 19a1.4 1.4 0 1 0 2.8 0a1.4 1.4 0 1 0-2.8 0M15.6 19a1.4 1.4 0 1 0 2.8 0a1.4 1.4 0 1 0-2.8 0</x:String>
        <x:String x:Key="AlertGlyph">M3 12a9 9 0 1 0 18 0a9 9 0 1 0-18 0M12 7.5v5.5M12 16.5v.01</x:String>
        <x:String x:Key="RetryGlyph">M20 11a8 8 0 1 0-2.3 5.7M20 4.5V11h-6.5</x:String>
        <x:String x:Key="CloudGlyph">M3 3l18 18M8.5 6.3A6 6 0 0 1 17.6 10H18a4 4 0 0 1 2.3 7.3M16.5 19H7a5 5 0 0 1-1.6-9.7</x:String>
        <Color x:Key="FreeTagFill">#DFF5E3</Color>
        <Color x:Key="StripRedFill">#FFF0EA</Color>
        <Color x:Key="StripRedText">#A4462A</Color>
        <Color x:Key="StripSandFill">#F0E8D8</Color>
        <Color x:Key="StripSandText">#4a4460</Color>
        <!-- Slice 396 (Subscription mock RR1-RR4): the Restore link, the dark message and the 402 strip's link. -->
        <Color x:Key="RestoreLink">#4a46d6</Color>
        <Color x:Key="MessageFill">#2b2540</Color>
        <Color x:Key="MessageGreen">#7EE08A</Color>
        <Color x:Key="MessageAmber">#FFC24D</Color>
        <Color x:Key="MessageAction">#C9C3FF</Color>
        <x:String x:Key="RestoreGlyph">M4 12a8 8 0 1 0 2.3-5.7M4 4.5V10h5.5</x:String>
        <x:String x:Key="CheckGlyph">M4 12.5l5 5L20 6.5</x:String>

        <DataTemplate x:Key="StoreRowTemplate" x:DataType="local:StoreRow">
            <!-- Slice 364 (Missing States mock S1-S3): the card is 12 padding, 10 between the row and the message strip under it. -->
            <Border BackgroundColor="White" StrokeThickness="0" Padding="12">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border WidthRequest="60" HeightRequest="80" BackgroundColor="{StaticResource CoverPlaceholder}" StrokeThickness="0" VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Image Source="{Binding Cover}" Aspect="AspectFill" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                        <!-- Slice 260: the tag badges (mock Batch 47 frame 161) sit above the title; the row is hidden for an untagged book. -->
                        <local:StoreTagRow Tags="{Binding Badges}" />
                        <Label Text="{Binding Title}" FontSize="15.5" FontAttributes="Bold" LineHeight="1.25" FontFamily="{Binding TitleFont}" />
                        <Label Text="{Binding Credits}" IsVisible="{Binding HasCredits}" FontSize="12.5" TextColor="{StaticResource Body}" />
                        <!-- Mock S1: the length, and the green Free tag after it. -->
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="{Binding Meta}" IsVisible="{Binding HasMeta}" FontSize="12.5" TextColor="{StaticResource Body}" VerticalOptions="Center" />
                            <Border IsVisible="{Binding IsFree}" HeightRequest="20" Padding="8,0" BackgroundColor="{StaticResource FreeTagFill}" StrokeThickness="0" VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Label Text="{x:Static res:AppResources.Store_Free}" FontSize="11.5" FontAttributes="Bold" TextColor="{StaticResource StoreGreen}" VerticalOptions="Center" />
                            </Border>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <!-- Get: the brand pill, 40 high, words only (mock S1d). -->
                    <Border Grid.Column="2" IsVisible="{Binding IsGet}" HeightRequest="40" Padding="16,0" BackgroundColor="{StaticResource Brand}"
                            StrokeThickness="0" VerticalOptions="Center" SemanticProperties.Description="{Binding GetHint}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <Label Text="{Binding GetLabel}" FontSize="14.5" FontAttributes="Bold" TextColor="White" VerticalOptions="Center" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnGetTapped" />
                        </Border.GestureRecognizers>
                    </Border>

                    <!-- Buy (mock S1b): the store's own price with a small cart glyph; it stays under a 402 strip. -->
                    <Border Grid.Column="2" IsVisible="{Binding IsBuy}" HeightRequest="40" Padding="16,0" BackgroundColor="{StaticResource Brand}"
                            StrokeThickness="0" VerticalOptions="Center" SemanticProperties.Description="{Binding GetHint}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <shapes:Path Data="{StaticResource CartGlyph}" Stroke="White" StrokeThickness="2.2" StrokeLineCap="Round" StrokeLineJoin="Round" Aspect="Uniform"
                                         WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                            <Label Text="{Binding Price}" FontSize="14.5" FontAttributes="Bold" TextColor="White" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnGetTapped" />
                        </Border.GestureRecognizers>
                    </Border>

                    <!-- Try again (mock S2): the tinted button at the end of a failed row; a book the store no longer has gets none. -->
                    <Border Grid.Column="2" IsVisible="{Binding IsTryAgain}" HeightRequest="40" Padding="14,0" BackgroundColor="{StaticResource BrandTint}"
                            StrokeThickness="0" VerticalOptions="Center" SemanticProperties.Description="{Binding GetHint}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <shapes:Path Data="{StaticResource RetryGlyph}" Stroke="{StaticResource BrandEdge}" StrokeThickness="2.4" StrokeLineCap="Round" StrokeLineJoin="Round" Aspect="Uniform"
                                         WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                            <Label Text="{Binding TryAgainLabel}" FontSize="14.5" FontAttributes="Bold" TextColor="{StaticResource BrandEdge}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnGetTapped" />
                        </Border.GestureRecognizers>
                    </Border>

                    <!-- Slice 346: a paid book that cannot be bought right now (no price known, or waiting for approval) shows one calm line instead of a button. -->
                    <Label Grid.Column="2" IsVisible="{Binding HasNote}" Text="{Binding NoteText}" FontSize="12.5" TextColor="{StaticResource Muted}" MaximumWidthRequest="110"
                           HorizontalTextAlignment="End" VerticalOptions="Center" />

                    <!-- Downloading (mock S1c): the 24 px ring and the percent, "40%" 14 / 600 in the brand edge colour. -->
                    <HorizontalStackLayout Grid.Column="2" IsVisible="{Binding IsDownloading}" Spacing="8" HeightRequest="40" VerticalOptions="Center"
                                           SemanticProperties.Description="{Binding ProgressHint}">
                        <local:StoreProgressRing Progress="{Binding Progress}" VerticalOptions="Center" />
                        <Label Text="{Binding ProgressText}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource BrandEdge}" VerticalOptions="Center" />
                        <!-- Slice 346 review #3: the long wait for the store to catch up with a purchase can be stopped. -->
                        <Label AutomationId="StoreRowCancelWait" IsVisible="{Binding IsWaitingForStore}" Text="{x:Static res:AppResources.Common_Cancel}" FontSize="14" TextColor="{StaticResource BrandEdge}"
                               TextDecorations="Underline" VerticalOptions="Center" SemanticProperties.Hint="{x:Static res:AppResources.Common_Cancel}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCancelWaitTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                    <!-- On the shelf: no fill, a green check. -->
                    <HorizontalStackLayout Grid.Column="2" IsVisible="{Binding IsOnShelf}" Spacing="5" HeightRequest="40" VerticalOptions="Center">
                        <local:IconView Kind="Check" Color="{StaticResource StoreGreen}" Size="16" StrokeWidth="3" VerticalOptions="Center" />
                        <Label Text="{x:Static res:AppResources.Store_OnShelf}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource StoreGreen}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Grid>

                <!-- Slice 357 / 364 (mock S2, S3): why the last try failed, inside the card under the row, in the app's language. The red strip is a server answer, the sand one no answer at all; it goes away when the next try starts. -->
                <Border AutomationId="StoreRowErrorRed" IsVisible="{Binding HasRedError}" Padding="12,9" BackgroundColor="{StaticResource StripRedFill}" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <shapes:Path Data="{StaticResource AlertGlyph}" Stroke="{StaticResource StripRedText}" StrokeThickness="2.2" StrokeLineCap="Round" StrokeLineJoin="Round" Aspect="Uniform"
                                     WidthRequest="18" HeightRequest="18" VerticalOptions="Start" />
                        <!-- Slice 396 (mock RR4): a 402 adds "Bought it already? Restore purchases" after the sentence, brand colour, 600, underlined; it runs the same restore as the Store's first line. -->
                        <!-- The tap and the accessibility action sit on the whole label (a span has neither); the handler acts only on a strip that carries the link (a 402). -->
                        <Label Grid.Column="1" FontSize="13.5" LineHeight="1.4" TextColor="{StaticResource StripRedText}" VerticalOptions="Center" MinimumHeightRequest="36"
                               SemanticProperties.Hint="{Binding BoughtItAlreadyText}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding ErrorLead}" />
                                    <Span Text="{Binding BoughtItAlreadyText}" FontAttributes="Bold" TextDecorations="Underline" TextColor="{StaticResource RestoreLink}" />
                                </FormattedString>
                            </Label.FormattedText>
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBoughtItAlreadyTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </Border>
                <Border AutomationId="StoreRowErrorCalm" IsVisible="{Binding HasCalmError}" Padding="12,9" BackgroundColor="{StaticResource StripSandFill}" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <shapes:Path Data="{StaticResource CloudGlyph}" Stroke="{StaticResource StripSandText}" StrokeThickness="2.2" StrokeLineCap="Round" StrokeLineJoin="Round" Aspect="Uniform"
                                     WidthRequest="18" HeightRequest="18" VerticalOptions="Start" />
                        <Label Grid.Column="1" Text="{Binding ErrorText}" FontSize="13.5" LineHeight="1.4" TextColor="{StaticResource StripSandText}" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Slice 358 (mock S2, S3): a sold book with no price and no button. The store answered without a price: the red strip; the store did not answer: the calm sand strip with the cloud glyph. Inline, no tap. -->
                <Border AutomationId="StoreRowNotForSale" IsVisible="{Binding HasRedNote}" Padding="12,9" BackgroundColor="{StaticResource StripRedFill}" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <shapes:Path Data="{StaticResource AlertGlyph}" Stroke="{StaticResource StripRedText}" StrokeThickness="2.2" StrokeLineCap="Round" StrokeLineJoin="Round" Aspect="Uniform"
                                     WidthRequest="18" HeightRequest="18" VerticalOptions="Start" />
                        <Label Grid.Column="1" Text="{x:Static res:AppResources.Store_NotForSaleNow}" FontSize="13.5" LineHeight="1.4" TextColor="{StaticResource StripRedText}" VerticalOptions="Center" />
                    </Grid>
                </Border>
                <Border AutomationId="StoreRowConnectToBuy" IsVisible="{Binding HasSandNote}" Padding="12,9" BackgroundColor="{StaticResource StripSandFill}" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <shapes:Path Data="{StaticResource CloudGlyph}" Stroke="{StaticResource StripSandText}" StrokeThickness="2.2" StrokeLineCap="Round" StrokeLineJoin="Round" Aspect="Uniform"
                                     WidthRequest="18" HeightRequest="18" VerticalOptions="Start" />
                        <Label Grid.Column="1" Text="{x:Static res:AppResources.Store_ConnectToBuy}" FontSize="13.5" LineHeight="1.4" TextColor="{StaticResource StripSandText}" VerticalOptions="Center" />
                    </Grid>
                </Border>
                </VerticalStackLayout>
            </Border>
        </DataTemplate>
    </ContentView.Resources>

    <Grid x:Name="StoreRoot" RowDefinitions="Auto,*">
        <ActivityIndicator x:Name="LoadingView" Grid.Row="1" IsRunning="True" Color="{StaticResource Brand}" HorizontalOptions="Center"
                           VerticalOptions="Center" />

        <!-- Screen 21: the list and the privacy line. -->
        <Grid x:Name="ListPanel" Grid.Row="1" RowDefinitions="Auto,Auto,*,Auto" IsVisible="False">
            <!-- Slice 112 (mock frame 47): age chips (Google Play's bands) and the author picker; filtering is on the phone. -->
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,0,0,10">
                <HorizontalStackLayout x:Name="AgeChips" Spacing="8" />
            </ScrollView>
            <Border Grid.Row="1" x:Name="AuthorRow" HeightRequest="44" Padding="14,0" Margin="0,0,0,10" BackgroundColor="White" StrokeThickness="0"
                    SemanticProperties.Description="{x:Static res:AppResources.Store_Author}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Label Text="{x:Static res:AppResources.Store_Author}" FontSize="14" TextColor="{StaticResource Muted}" VerticalOptions="Center" />
                    <Label Grid.Column="1" x:Name="AuthorValue" FontSize="14" TextColor="{StaticResource Ink}" VerticalOptions="Center" />
                    <local:IconView Grid.Column="2" Kind="ChevronDown" Color="{StaticResource Muted}" Size="16" StrokeWidth="2.2" VerticalOptions="Center" />
                </Grid>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAuthorTapped" />
                </Border.GestureRecognizers>
            </Border>
            <Label Grid.Row="2" x:Name="NoMatchLabel" Text="{x:Static res:AppResources.Store_NoMatch}" FontSize="14" LineHeight="1.5" TextColor="{StaticResource Body}"
                   HorizontalTextAlignment="Center" Margin="30,30" IsVisible="False" />
            <CollectionView Grid.Row="2" x:Name="StoryList" SelectionMode="None" ItemTemplate="{StaticResource StoreRowTemplate}">
                <CollectionView.ItemsLayout>
                    <!-- One column; the page raises the span to 2 from 800 dp of content (SettingsLayout.StoreColumns, decision 4). Frame T2: 14 dp between cards. -->
                    <GridItemsLayout Orientation="Vertical" Span="1" VerticalItemSpacing="14" HorizontalItemSpacing="14" />
                </CollectionView.ItemsLayout>
            </CollectionView>
            <HorizontalStackLayout Grid.Row="3" Spacing="8" Padding="4,10,4,14">
                <local:IconView Kind="Lock" Color="{StaticResource Muted}" Size="16" StrokeWidth="2" VerticalOptions="Start" Margin="0,1,0,0" />
                <Label x:Name="FooterLabel" Text="{x:Static res:AppResources.Store_Footer}" FontSize="12.5" LineHeight="1.4" TextColor="{StaticResource Body}" />
            </HorizontalStackLayout>
        </Grid>

        <!-- Slice 384: the subscription card, the head of the book list (the page moves it into the CollectionView header). Both plans show the store's own recurring price and the trial; the terms (price, length, trial, auto-renewal)
             sit under the buttons with the terms and privacy links Apple and Google require, and Manage opens the store's own subscription page. Shown only while books are sold and the store priced a plan, or the subscription runs. -->
        <Border x:Name="SubscriptionCard" AutomationId="StoreSubscriptionCard" IsVisible="False" BackgroundColor="White" StrokeThickness="0" Padding="16" Margin="0,0,0,14">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="18" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="10">
                <Label x:Name="SubscriptionTitle" Text="{x:Static res:AppResources.Sub_Title}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Ink}" SemanticProperties.HeadingLevel="Level2" />
                <Label x:Name="SubscriptionLine" AutomationId="StoreSubscriptionLine" Text="{x:Static res:AppResources.Sub_Line}" FontSize="13.5" LineHeight="1.45" TextColor="{StaticResource Body}" />
                <VerticalStackLayout x:Name="SubscriptionPlans" Spacing="8">
                    <Button x:Name="SubscribeMonthlyButton" AutomationId="StoreSubscribeMonthly" HeightRequest="48" CornerRadius="24" Padding="14,0" FontSize="15" FontAttributes="Bold"
                            BackgroundColor="{StaticResource Brand}" TextColor="White" Clicked="OnSubscribeMonthlyClicked" />
                    <Button x:Name="SubscribeYearlyButton" AutomationId="StoreSubscribeYearly" HeightRequest="48" CornerRadius="24" Padding="14,0" FontSize="15" FontAttributes="Bold"
                            BackgroundColor="{StaticResource BrandTint}" TextColor="{StaticResource BrandEdge}" Clicked="OnSubscribeYearlyClicked" />
                    <Label x:Name="SubscriptionTerms" AutomationId="StoreSubscriptionTerms" Text="{x:Static res:AppResources.Sub_Terms}" FontSize="12" LineHeight="1.4" TextColor="{StaticResource Muted}" />
                </VerticalStackLayout>
                <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignItems="Center">
                    <Label x:Name="SubscriptionTermsLink" AutomationId="StoreSubscriptionTermsLink" Text="{x:Static res:AppResources.Sub_TermsLink}" FontSize="13" TextColor="{StaticResource Brand}" TextDecorations="Underline" Margin="0,0,16,4">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSubscriptionTermsTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label x:Name="SubscriptionPrivacyLink" AutomationId="StoreSubscriptionPrivacyLink" Text="{x:Static res:AppResources.Sub_PrivacyLink}" FontSize="13" TextColor="{StaticResource Brand}" TextDecorations="Underline" Margin="0,0,16,4">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSubscriptionPrivacyTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label x:Name="SubscriptionManageLink" AutomationId="StoreSubscriptionManage" Text="{x:Static res:AppResources.Sub_Manage}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Brand}" TextDecorations="Underline" Margin="0,0,0,4">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSubscriptionManageTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </FlexLayout>
            </VerticalStackLayout>
        </Border>

        <!-- Slice 396 (Subscription mock RR1, RR2, RR3): the Store's first line is "Restore purchases" at the right (the corner's own title row says "Store" and "Picked and cast for Dino" above it), shown only while books are sold
             (the remote switch). A running restore turns its icon into a spinner and its text into "Restoring…"; nothing blocks (no wait overlay). Redeem a code is not here on purpose: it is in Settings (Slice 399) and in the message
             that says nothing was found. The result is the dark message pinned above the tab bar for 5 seconds (RestoreResultView, the last child of the page). -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="18,4,14,2">
        <Label AutomationId="GalleryStoreSub" Text="{x:Static res:AppResources.Store_Subtitle}" FontSize="13.5" LineHeight="1.4" TextColor="{StaticResource Body}" VerticalOptions="Center" />
        <HorizontalStackLayout x:Name="RestoreLinkRow" Grid.Column="1" IsVisible="False" HorizontalOptions="End" Spacing="6">
            <shapes:Path x:Name="RestoreLineIcon" Data="{StaticResource RestoreGlyph}" Stroke="{StaticResource RestoreLink}" StrokeThickness="2.4" StrokeLineCap="Round" StrokeLineJoin="Round" Aspect="Uniform"
                         WidthRequest="17" HeightRequest="17" VerticalOptions="Center" />
            <ActivityIndicator x:Name="RestoreSpinner" Color="{StaticResource RestoreLink}" IsRunning="False" IsVisible="False" WidthRequest="17" HeightRequest="17" VerticalOptions="Center" />
            <Label x:Name="RestoreLineLabel" AutomationId="StoreRestorePurchases" Text="{x:Static res:AppResources.Store_RestorePurchases}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource RestoreLink}"
                   VerticalOptions="Center" HeightRequest="36" VerticalTextAlignment="Center" />
            <HorizontalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnRestorePurchasesClicked" />
            </HorizontalStackLayout.GestureRecognizers>
        </HorizontalStackLayout>
        </Grid>

        <!-- Screen 22: offline, or the server cannot be reached. -->
        <VerticalStackLayout x:Name="OfflineView" Grid.Row="1" IsVisible="False" Spacing="14" Padding="30,0,30,60" VerticalOptions="Center">
            <Border WidthRequest="96" HeightRequest="96" BackgroundColor="White" StrokeThickness="0" HorizontalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="48" />
                </Border.StrokeShape>
                <shapes:Path x:Name="OfflineIcon" Data="{StaticResource WifiOffGlyph}" Stroke="{StaticResource Muted}" StrokeThickness="2" StrokeLineCap="Round"
                             StrokeLineJoin="Round" Aspect="Uniform" WidthRequest="44" HeightRequest="44" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <Label x:Name="OfflineTitleLabel" AutomationId="StoreOfflineTitle" Text="{x:Static res:AppResources.Store_OfflineTitle}" FontSize="21" FontAttributes="Bold" HorizontalTextAlignment="Center"
                   SemanticProperties.HeadingLevel="Level2" />
            <Label x:Name="OfflineBodyLabel" Text="{x:Static res:AppResources.Store_OfflineBody}" FontSize="14" LineHeight="1.5" TextColor="{StaticResource Body}"
                   HorizontalTextAlignment="Center" />
            <Button Text="{x:Static res:AppResources.Store_TryAgain}" HeightRequest="48" CornerRadius="24" Padding="28,0" FontSize="15" FontAttributes="Bold"
                    BackgroundColor="{StaticResource Brand}" TextColor="White" HorizontalOptions="Center" Margin="0,4,0,0" Clicked="OnTryAgainClicked" />
        </VerticalStackLayout>

        <!-- Screen 23: nothing new (an empty list, or every entry too new for this app). A normal state, not an error. The way back to the shelf is the corner's coral pill, so there is no button here. -->
        <VerticalStackLayout x:Name="EmptyView" Grid.Row="1" IsVisible="False" Spacing="14" Padding="30,0,30,60" VerticalOptions="Center">
            <Border WidthRequest="96" HeightRequest="96" StrokeThickness="0" Opacity="0.9" HorizontalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="26" />
                </Border.StrokeShape>
                <Image Source="dino_icon" Aspect="AspectFill" />
            </Border>
            <Label Text="{x:Static res:AppResources.Store_EmptyTitle}" FontSize="21" FontAttributes="Bold" HorizontalTextAlignment="Center"
                   SemanticProperties.HeadingLevel="Level2" />
            <Label Text="{x:Static res:AppResources.Store_EmptyBody}" FontSize="14" LineHeight="1.5" TextColor="{StaticResource Body}"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <!-- Slice 396 (mock RR2, RR3): the result of a restore, a dark message pinned above the tab bar (14 in from each side, 10 up) for 5 seconds, never at the end of a list. Restored: a green check; nothing found: an amber
             alert and the "Redeem a code" action inside the message. -->
        <Border x:Name="RestoreResultView" Grid.Row="0" Grid.RowSpan="2" IsVisible="False" VerticalOptions="End" Margin="14,0,14,10" MinimumHeightRequest="48" Padding="14,10" StrokeThickness="0"
                BackgroundColor="{StaticResource MessageFill}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#141028" Offset="0,10" Radius="24" Opacity="0.3" />
            </Border.Shadow>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <shapes:Path x:Name="RestoreResultIcon" Stroke="{StaticResource MessageGreen}" StrokeThickness="3" StrokeLineCap="Round" StrokeLineJoin="Round" Aspect="Uniform"
                             WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                <Label x:Name="RestoreResultLabel" AutomationId="StoreRestoreResult" Grid.Column="1" FontSize="14" FontAttributes="Bold" LineHeight="1.35" TextColor="White" VerticalOptions="Center" />
                <Label x:Name="RestoreRedeemAction" AutomationId="StoreRedeemCode" Grid.Column="2" IsVisible="False" Text="{x:Static res:AppResources.Store_RedeemCode}" FontSize="14" FontAttributes="Bold"
                       TextColor="{StaticResource MessageAction}" VerticalOptions="Center" SemanticProperties.Hint="{x:Static res:AppResources.Store_RedeemCode}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRedeemCodeClicked" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>
