<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="ReadTheStupidText_App.ReadingTextBoxWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        A normal, resizable, toggleable window (Slice 37, Decision 45) that shows
        the text of the current read with the currently-playing chunk highlighted
        (Decision 46). Closing it (the system ✕) only hides it — playback keeps
        going, and reopening re-syncs to whatever chunk is current, since this
        window keeps updating from the read events while hidden. Plain scrollable
        text for this first pass; zoom + real fit-to-box pagination land in Slice 38.
    -->
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BrandGradient}">
            <Grid Padding="16,12" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" VerticalAlignment="Center">
                    <Border.Background>
                        <ImageBrush ImageSource="ms-appx:///Assets/Square150x150Logo.scale-200.png" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        Text="READ THE STUPID TEXT"
                        FontSize="10"
                        FontWeight="Bold"
                        CharacterSpacing="180"
                        Foreground="{StaticResource HeaderEyebrow}" />
                    <TextBlock
                        x:Name="StatusText"
                        Text="Nothing reading yet"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Margin="0,2,0,0"
                        Foreground="{StaticResource HeaderText}" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer x:Name="TextScroller" Grid.Row="1" Padding="24,20" VerticalScrollBarVisibility="Auto">
            <TextBlock
                x:Name="ReadingText"
                TextWrapping="Wrap"
                FontSize="16"
                LineHeight="27"
                IsTextSelectionEnabled="True" />
        </ScrollViewer>
    </Grid>
</Window>
