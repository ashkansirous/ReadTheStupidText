<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="ReadTheStupidText_App.LanguageWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        First-run language choice (Slice 56, Decision 68). Picking a language stores it and starts the
        voice pack download; progress shows here while the Windows voice keeps reading, and the window
        closes when the natural voice is ready. A normal window, so it can also be reopened from the tray.
    -->
    <Grid x:Name="RootGrid" Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            x:Uid="LanguageChooseTitle"
            FontSize="20"
            FontWeight="SemiBold" />
        <TextBlock
            x:Name="IntroText"
            Grid.Row="1"
            TextWrapping="Wrap" />

        <ListView
            x:Name="LanguageList"
            Grid.Row="2"
            SelectionMode="Single"
            SelectionChanged="OnLanguageSelectionChanged"
            DisplayMemberPath="NativeName" />

        <StackPanel Grid.Row="3" Spacing="6">
            <ProgressBar x:Name="DownloadBar" Minimum="0" Maximum="1" Visibility="Collapsed" />
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="RetryButton" x:Uid="LanguageRetry" Visibility="Collapsed" Click="OnRetryClick" />
            <Button x:Uid="LanguageClose" Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
