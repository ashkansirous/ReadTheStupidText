{
  // Same Worker as wrangler.jsonc but with NO custom-domain route. Used only for
  // the first deploy of the cut-over (docs/DEPLOYING.md): it puts the Worker live
  // on workers.dev without touching the readthestupidtext.sirous.uk hostname.
  // Keep the name, main, assets and flags identical to wrangler.jsonc.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "readthestupidtext",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": [
      "/", "/index.html", "/privacy", "/privacy/", "/privacy.html", "/download", "/download/*",
      // Slice 92: the free Dino story store API (worker/stories.ts).
      "/api/stories", "/api/stories/*",
      // Slice 132: Dino Reader's remote config (worker/appconfig.ts).
      "/api/app-config",
      // Slice 133: Dino Reader's anonymous usage counts (worker/events.ts).
      "/api/events", "/api/events/beta",
      // Slice 227: crash and error reports from the phone apps (worker/crashes.ts).
      "/api/crash",
      // Slice 283: Dino Reader's anonymous Sonos music service (worker/sonos.ts).
      "/sonos",
      // Slice 282: Dino Reader's anonymous Alexa kid skill (worker/alexa.ts).
      "/alexa",
      // Slice 287: the public Dino usage dashboard page and its data (worker/stats.ts).
      "/stats", "/stats/", "/stats.html", "/api/stats",
      // The Dino Reader site on *.workers.dev, under /dino/ (worker/downloads.ts resolveSite).
      "/dino", "/dino/", "/dino/index.html", "/dino/privacy", "/dino/privacy/", "/dino/privacy.html", "/dino/download", "/dino/download/*",
      "/dino/api/stories", "/dino/api/stories/*",
      "/dino/api/app-config",
      "/dino/api/events", "/dino/api/events/beta",
      "/dino/api/crash",
      "/dino/sonos",
      "/dino/alexa",
      "/dino/stats", "/dino/stats/", "/dino/stats.html", "/dino/api/stats"
    ]
  },
  "r2_buckets": [{ "binding": "DOWNLOADS", "bucket_name": "readthestupidtext-downloads" }],
  "analytics_engine_datasets": [
    { "binding": "DINO_USAGE", "dataset": "dino_usage" },
    // Slice 251: Dino counts from TestFlight builds, never mixed into dino_usage.
    { "binding": "DINO_USAGE_BETA", "dataset": "dino_usage_beta" },
    { "binding": "RTST_USAGE", "dataset": "rtst_usage" },
    // Slice 227: one point per crash report (worker/crashes.ts); the report itself is kept in R2 under crashes/.
    { "binding": "APP_CRASHES", "dataset": "app_crashes" }
  ],
  // Slice 227: at most 10 crash reports per connection and minute in one location; the connection's IP is only the limiter's key and is never stored.
  // The namespace_id is an integer unique within the account.
  "ratelimits": [
    { "name": "CRASH_LIMITER", "namespace_id": "2270", "simple": { "limit": 10, "period": 60 } }
  ],
  // Slice 282: the Alexa skill id (amzn1.ask.skill...). Empty until the skill exists, and while it is empty
  // every Alexa request is refused with 400 (worker/alexa-verify.ts fails closed). Set it here, in BOTH wrangler configs, by a PR
  // once the skill exists, never in the dashboard: each deploy overwrites a dashboard value with this one.
  "vars": { "ALEXA_SKILL_ID": "" },

  // Slice 287: the hourly rollup of Analytics Engine into D1 for /stats (worker/stats-rollup.ts). Harmless without the
  // STATS binding: it logs and returns. The D1 binding itself is added after `wrangler d1 create` (docs/DEPLOYING.md).
  "triggers": { "crons": ["7 * * * *"] },

  "observability": { "enabled": true }
}
