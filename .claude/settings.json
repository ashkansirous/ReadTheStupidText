{
  "enabledPlugins": {
    "cloudflare@cloudflare": true,
    "hyperframes@hyperframes": true
  },
  "extraKnownMarketplaces": {
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    },
    "hyperframes": {
      "source": {
        "source": "github",
        "repo": "heygen-com/hyperframes"
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" != \"true\" ] || [ ! -f /opt/agent-board/scripts/usage-tick.mjs ] || node /opt/agent-board/scripts/usage-tick.mjs",
            "timeout": 5
          }
        ],
        "matcher": "startup|resume"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" != \"true\" ] || [ ! -f /opt/agent-board/scripts/usage-tick.mjs ] || node /opt/agent-board/scripts/usage-tick.mjs --force",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
