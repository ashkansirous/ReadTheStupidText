<Project>

	<!-- One MAUI version for every MAUI project (RTST Mobile, Dino Reader, Mobile.Shared). It was
	     previously undefined, so MAUI came from whatever workload the machine happened to have.
	     Slice 72. Bump here only. -->
	<PropertyGroup>
		<MauiVersion>10.0.130</MauiVersion>
	</PropertyGroup>

	<!-- Warnings that can hide a real bug fail the build in every project (Slice 378): not awaited, platform-version
	     calls, obsoleted-on-a-platform calls, nullability, test calls without the test's cancellation token, bad crefs.
	     Fix the code or add the platform attribute; never suppress. A list, not TreatWarningsAsErrors, so a new SDK's
	     new warning cannot break a release overnight. Slice 379 widens it. -->
	<PropertyGroup>
		<WarningsAsErrors>$(WarningsAsErrors);CS4014;CA1416;CA1422;nullable;xUnit1051;CS1574;CS0419</WarningsAsErrors>
	</PropertyGroup>

</Project>
